<script>
import device from "@system.device";
import app from "@system.app";
import { DEVICE_RESERVED_SPACE } from "./config/deviceConfig";
import * as $storage from "./components/storage";
import * as $api from "./components/api";
import * as $img from "./components/imageUrl";
import * as $json from "./components/jsonUtils";
import * as $route from "./components/routerParams";
import * as $set from "./components/settings";
import * as $cover from "./components/coverLoader";
import * as $bridge from "./components/dataBridge";
import * as $hub from "./components/interconnectHub";
import { checkUpdate } from "./components/updateChecker";
import { createConfirmGuard } from "./components/confirmGuard";

// 官方"减少打包体积#2 全局方法"：共享模块统一挂 global，页面不再 import——
// 无公共 chunk 抽取时这些模块会在每个引用页的 bundle 里各复制一份
// （路由栈越深重复份数越多），global 化后仅 app 包持有一份，跨页共享。
// 顺带修复隐患：interconnectHub 的单例连接/处理器注册表此前随 bundle 复制成
// 多实例，深页用网桥 fetch 会覆盖首页 dataBridge 注册的 onmessage 分发。
global.$storage = $storage;
global.$api = $api;
global.$img = $img;
global.$json = $json;
global.$route = $route;
global.$set = $set;
global.$cover = $cover;
global.$bridge = $bridge;
global.$hub = $hub;
global.checkUpdate = checkUpdate;
global.createConfirmGuard = createConfirmGuard;

const appInfo = app.getInfo();
let deviceInfo = {};
const screenSize = { width: 0, height: 0 };

global.API_SETTING = {
  MangaDex: {
    name: "MangaDex",
    apiUrl: "https://mangadex.yzf.moe",
    detailPath: "/comic/<id>",
    photoPath: "/photo/<id>/ch/<chapter>",
    searchPath: "/search/<text>/<page>",
    type: "mangadex",
  },
  using: "MangaDex",
};

global.buildin = ["MangaDex"];
// 内置源的出厂快照：所有源被删除时用于恢复兜底（见 api.js ensureUsingSourceValid）
global.DEFAULT_API_SETTING = {};
global.buildin.forEach(function (key) {
  global.DEFAULT_API_SETTING[key] = JSON.parse(JSON.stringify(global.API_SETTING[key]));
});
global.display = true;
global.update = true;
global.UPDATE_CHECK_URL = "https://bandcomic.yuzifu.top/update.json";
global.updateChecking = false;
global.updatePageShowing = false;
global.pendingUpdateInfo = null;

global.deviceReservedSpace = DEVICE_RESERVED_SPACE;

global.getReservedSpace = function (totalStorage) {
  const product = deviceInfo.product;
  const reserved = global.deviceReservedSpace[product];
  if (typeof reserved === "number" && reserved < 1) {
    return Math.floor(totalStorage * reserved);
  }
  return reserved || 0;
};

global.isXiaomiSmartBand10Pro = function () {
  return deviceInfo.product === "Xiaomi Smart Band 10 Pro";
};

global.applyDeviceRecommendedSettings = function () {
  if (global.APP_SETTING && global.isXiaomiSmartBand10Pro()) {
    global.APP_SETTING.imageUsePng = true;
    // 10 Pro 不支持快应用原生 fetch,强制网桥连接
    global.APP_SETTING.preferBridge = true;
  }
};

device.getInfo({
  success: function (deviceRet) {
    screenSize.width = deviceRet.screenWidth;
    screenSize.height = deviceRet.screenHeight;
    global.screenShape = deviceRet.screenShape;
    global.screenSize = screenSize;
    deviceInfo = {
      product: deviceRet.product,
      brand: deviceRet.brand,
      osType: deviceRet.osType,
      osVersionName: deviceRet.osVersionName,
      osVersionCode: deviceRet.osVersionCode,
      language: deviceRet.language,
      region: deviceRet.region,
    };
    global.applyDeviceRecommendedSettings();
  },
});

global.userAgent = function () {
  return `${appInfo.packageName}(${appInfo.versionName}(${appInfo.versionCode}))/${deviceInfo.product}/${deviceInfo.brand}/${deviceInfo.osType}/${deviceInfo.osVersionName}/${deviceInfo.osVersionCode}/${deviceInfo.language}/${deviceInfo.region}`;
};

global.getTime = function () {
  const date = new Date();
  const hour = date.getHours().toString().padStart(2, "0");
  const minute = date.getMinutes().toString().padStart(2, "0");
  return hour + ":" + minute;
};

global.APP_SETTING = {
  searchPageSize: "10",
  imageQuality: "50",
  imageSize: "600",
  showCoverInSearch: true,
  keepDefaultZoom: false,
  imageUsePng: false,
  imagePreTranscode: false,
  imagePreload: false,
  preferBridge: false,
};

export default {};
</script>
