<template>
  <div class="demo-page">
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/info.png"
      @click="routeAbout"
    />

    <text class="time">{{ time }}</text>
    <text if.static="{{ global.screenShape == 'circle' }}" @click="routeBack" class="title">
      <span class="iconfont" if.static="{{ global.screenShape == 'circle' }}">&#xe685;</span>
      <span static>{{ $t("edit.title") }}</span>
    </text>
    <text class="title" if.static="{{ global.screenShape != 'circle' }}">
      <span static>{{ $t("edit.title") }}</span>
    </text>

    <list class="search-results" bounces="true">
      <list-item
        for="{{ source in Object.keys(API_SETTING).filter((key) => key != 'using') }}"
        type="source"
        class="result-item"
      >
        <text style="font-weight: bold">
          {{ global.API_SETTING[source].name }}
        </text>
        <image
          if="{{ !global.buildin.includes(source) }}"
          src="/common/listDel.png"
          @click="del(source)"
        ></image>
      </list-item>
    </list>

    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton bottom"
      src="/common/add.png"
      @click="openIme"
    />
    <img
      if.static="{{ global.screenShape == 'circle' }}"
      class="bottom"
      src="/common/add_s4.png"
      @click="openIme"
    />
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { updateJsonFile, FILE_ERROR, SOURCES_URI } = global.$storage;
const { safeJsonParse } = global.$json;
const { apiFetch, getFetchErrorType, ensureUsingSourceValid, replaceIfDuplicate, mergeSourcesToGlobal } = global.$api;
const { createConfirmGuard } = global;

const { getTime } = global;

const confirmDelSource = createConfirmGuard();

function normalizeApiUrl(url) {
  return url
    .trim()
    .replace(/^https?:\/\//i, "")
    .replace(/\/+$/, "");
}

function validateApiUrl(url) {
  if (!url || url.trim() === "") {
    return "empty";
  }

  const normalized = normalizeApiUrl(url);

  const domainRegex = /^([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(:\d{1,5})?$/;
  const ipv4Regex = /^(\d{1,3}\.){3}\d{1,3}(:\d{1,5})?$/;
  if (!domainRegex.test(normalized) && !ipv4Regex.test(normalized)) {
    return "invalidDomain";
  }

  return true;
}

export default {
  private: {
    context: "",
    time: "",
    API_SETTING: global.API_SETTING,
  },

  onShow() {
    // 写入页面顶部时间
    this.time = getTime();
    // 输入法页面回传：确认走校验+写入流程，取消仅保留文本
    const imeResult = global.__imeResult;
    if (imeResult) {
      global.__imeResult = null;
      this.context = imeResult.text;
      if (imeResult.confirmed) {
        this.submitSource();
      }
    }
  },

  onBackPress() {
    return false;
  },

  openIme() {
    global.__imeText = this.context;
    global.__imeLabel = this.$t("edit.input");
    router.push({
      uri: "/pages/ime",
    });
  },

  submitSource() {
    const validation = validateApiUrl(this.context);
    if (validation !== true) {
      prompt.showToast({ message: this.$t("edit.validation." + validation) });
      return;
    }
    this.context = normalizeApiUrl(this.context);
    this.writeSource();
  },

  writeSource() {
    this.fetchSourceConfig("https");
  },

  fetchSourceConfig(protocol) {
    apiFetch({
      url: protocol + "://" + this.context + "/config",
      responseType: "text",
      success: (response) => {
        const data = safeJsonParse(response.data, null);
        if (data == null) {
          prompt.showToast({
            message: this.$t("edit.unknownReadError") + response.data,
          });
          return;
        }
        if (typeof data !== "object") {
          prompt.showToast({ message: this.$t("error.invalidResponse") });
          return;
        }
        // 串行队列内与最新 sources.json 合并落盘，避免与手机端同步并发时丢配置
        updateJsonFile(SOURCES_URI, [], (existing) => {
          const list = Array.isArray(existing) ? existing : [];
          return replaceIfDuplicate(list, data);
        }).then(
          () => {
            // HTTPS 降级 HTTP 成功时延长 toast 并明示安全风险，避免用户忽略
            prompt.showToast({
              message: this.$t(protocol === "http" ? "edit.completeHttp" : "edit.complete"),
              duration: protocol === "http" ? 3000 : 2000,
            });
            mergeSourcesToGlobal(Object.keys(data).map((key) => ({ [key]: data[key] })));
            this.API_SETTING = global.API_SETTING;
          },
          ({ data: errData, code }) => {
            if (code === FILE_ERROR.IO_ERROR) {
              prompt.showToast({ message: this.$t("edit.storageError") });
            } else {
              prompt.showToast({
                message: this.$t("edit.unknownWriteError") + errData,
              });
            }
          }
        );
      },
      fail: (data, code) => {
        const errorType = getFetchErrorType(code);
        if (protocol === "https" && (errorType === "ssl" || errorType === "connection")) {
          this.fetchSourceConfig("http");
          return;
        }
        if (errorType === "domain") {
          prompt.showToast({ message: this.$t("edit.domainError") });
        } else if (errorType === "timeout") {
          prompt.showToast({ message: this.$t("edit.timeoutError") });
        } else if (errorType === "ssl") {
          prompt.showToast({ message: this.$t("edit.sslError") });
        } else if (errorType === "connection") {
          prompt.showToast({ message: this.$t("edit.connectionError") });
        } else {
          prompt.showToast({
            message: this.$t("edit.unknownRequestError") + data,
          });
        }
      },
    });
  },

  del(source) {
    if (!confirmDelSource(source, this.$t("edit.delConfirm"), { duration: 2000 })) return;
    updateJsonFile(SOURCES_URI, [], (datas) => {
      const list = Array.isArray(datas) ? datas : [];
      return list.filter((item) => Object.keys(item)[0] !== source);
    }).then(
      () => {
        prompt.showToast({ message: this.$t("edit.del") });
        delete global.API_SETTING[source];
        ensureUsingSourceValid();
        this.API_SETTING = global.API_SETTING;
      },
      ({ data }) => {
        prompt.showToast({
          message: this.$t("edit.unknownDelError") + data,
        });
      }
    );
  },

  routeBack() {
    router.back();
  },

  routeAbout() {
    router.push({
      uri: "/pages/about",
    });
  },
};
</script>

<style>
@import "../../common/base.css";

.demo-page {
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.search-results {
  height: 65%;
  width: 324px;
  margin-top: 10px;
  align-self: center;
}

.result-item {
  margin-bottom: 10px;
  height: 84px;
  background-color: rgba(38, 38, 38, 0.8);
  padding: 20px;
  border-radius: 36px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* 看看是不是小米手表s3/s4 */
@media (min-width: 200) and (max-width: 235) and (shape: circle) {
  .bottom {
    left: 182px;
    position: absolute;
    bottom: 6px;
  }

  .search-results {
    width: 80%;
    height: 65%;
  }
}

/* 看看是不是小米手表s1 pro */
@media (min-width: 235) and (max-width: 250) and (shape: circle) {
  .bottom {
    left: 189px;
    position: absolute;
    bottom: 6px;
  }

  .search-results {
    width: 80%;
    height: 65%;
  }
}

/* 看看是不是红米手表 */
@media (device-type: watch) and (shape: rect) {
  .search-results {
    width: 392px;
    margin-top: 30px;
  }
}
</style>
