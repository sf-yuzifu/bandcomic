<template>
  <div class="container">
    <img
      if="{{ global.screenShape != 'circle' && !forceUpdate }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <text class="time">{{ time }}</text>
    <text
      class="title"
      @click="
        () => {
          if (global.screenShape == 'circle' && !forceUpdate) {
            routeBack();
          }
        }
      "
    >
      <span class="iconfont" if="{{ global.screenShape == 'circle' && !forceUpdate }}">
        &#xe685;
      </span>
      <span static>{{ $t("update.title") }}</span>
    </text>

    <div class="box">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div class="card">
          <image static class="logo" src="/common/logo.png"></image>
          <text class="main-title">{{ updateTitle }}</text>
          <text class="version">
            {{ $t("update.currentVersion") }}{{ currentVersionName }}({{ currentVersionCode }})
          </text>
          <text class="version">
            {{ $t("update.latestVersion") }}{{ latestVersionName }}({{ latestVersionCode }})
          </text>
          <text class="force" if="{{ forceUpdate }}">
            {{ $t("update.force") }}
          </text>
          <div class="retry-btn" if="{{ forceUpdate }}" @click="retryCheck">
            <text class="retry-text">{{ retrying ? $t("update.checking") : $t("update.retry") }}</text>
          </div>
          <text class="message" if="{{ message }}">{{ message }}</text>
        </div>

        <div class="content-card">
          <text static class="section-title">{{ $t("update.changelog") }}</text>
          <text class="content" for="{{ item in changelogList }}">
            {{ item }}
          </text>
          <text class="content" if="{{ changelogList.length == 0 }}">
            {{ $t("update.noChangelog") }}
          </text>
        </div>

        <div class="content-card" if="{{ downloadUrl }}">
          <text static class="section-title">{{ $t("update.download") }}</text>
          <div class="qrcode-box">
            <qrcode class="download-qrcode" value="{{ downloadUrl }}"></qrcode>
          </div>
          <text static class="qrcode-tip">{{ $t("update.scanTip") }}</text>
        </div>
        <div static class="padding"></div>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";

const { getTime, checkUpdate } = global;

// pendingUpdateInfo 消费即清（P1-14）后的实例重建兜底：模块级状态跨实例存活
//（photo.ux 模块级缓存同款语义），重建时重读快照不再依赖已被清空的 global
let lastUpdateInfo = null;

export default {
  private: {
    time: "",
    currentVersionCode: "",
    currentVersionName: "",
    latestVersionCode: "",
    latestVersionName: "",
    forceUpdate: false,
    updateTitle: "",
    message: "",
    changelogList: [],
    downloadUrl: "",
    retrying: false,
    destroyed: false,
  },

  onInit() {
    this.destroyed = false;
    // 消费即清（P1-14）：pendingUpdateInfo 不再只置不清、被后续页面驱动旧信息
    if (global.pendingUpdateInfo) {
      lastUpdateInfo = global.pendingUpdateInfo;
      global.pendingUpdateInfo = null;
    }
    this.applyUpdateInfo(lastUpdateInfo || {});
  },

  onShow() {
    this.time = getTime();
  },

  onDestroy() {
    this.destroyed = true;
  },

  onBackPress() {
    // 系统返回与 UI 返回同路径（P1-15）：不复位 updatePageShowing 会让本次会话
    // checkAppUpdate 全部早退、更新提示不再出现；强更下 routeBack 空操作 + 吞返回，
    // 与隐藏的返回键语义一致
    this.routeBack();
    return true;
  },

  applyUpdateInfo(info) {
    this.currentVersionCode = info.currentVersionCode || "";
    this.currentVersionName = info.currentVersionName || "";
    this.latestVersionCode = info.latestVersionCode || "";
    this.latestVersionName = info.latestVersionName || "";
    this.forceUpdate = info.forceUpdate;
    this.updateTitle = info.title || this.$t("update.found");
    this.message = info.message || "";
    this.downloadUrl = info.downloadUrl || "";

    if (Array.isArray(info.changelog)) {
      this.changelogList = info.changelog;
    } else if (typeof info.changelog === "string") {
      this.changelogList = info.changelog.split("\n").filter(function (item) {
        return item.trim() !== "";
      });
    } else {
      this.changelogList = [];
    }
  },

  // 强更专设出口（P1-15）：服务端撤回强更/更新后放行回首页；解除强更则恢复返回键。
  // 原设计强更只能杀进程，服务端误配 force:true 即准变砖
  retryCheck() {
    if (this.retrying) return;
    this.retrying = true;
    checkUpdate(true).then((info) => {
      this.retrying = false;
      if (this.destroyed) return;
      if (info && info.failed) {
        prompt.showToast({ message: this.$t("error.networkError"), duration: 2000 });
        return;
      }
      if (!info) {
        // 服务端已撤回更新：放行回首页（不走 routeBack——它在 forceUpdate 下空操作）
        global.updatePageShowing = false;
        router.back();
        return;
      }
      lastUpdateInfo = info;
      global.pendingUpdateInfo = null;
      this.applyUpdateInfo(info);
    });
  },

  routeBack() {
    if (this.forceUpdate) return;
    global.updatePageShowing = false;
    router.back();
  },
};
</script>

<style>
@import "../../common/base.css";

.container {
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.box {
  position: relative;
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.card,
.content-card {
  width: 324px;
  margin-top: 10px;
  padding: 20px;
  border-radius: 40px;
  background-color: #262626;
  flex-direction: column;
  align-items: center;
  border: 3px solid rgba(255, 255, 255, 0.06);
}

.logo {
  width: 76px;
  height: 76px;
  margin-bottom: 10px;
}

.main-title {
  font-size: 32px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.version,
.message,
.content,
.qrcode-tip {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 8px;
  width: 100%;
}

.qrcode-box {
  width: 240px;
  height: 240px;
  margin-top: 14px;
  padding: 20px;
  border-radius: 16px;
  background-color: #ffffff;
  align-items: center;
  justify-content: center;
}

.download-qrcode {
  width: 200px;
  height: 200px;
  color: #000000;
  background-color: #ffffff;
}

.qrcode-tip {
  text-align: center;
}

.force {
  font-size: 24px;
  font-weight: bold;
  color: #ff6b6b;
  margin-top: 10px;
}

.retry-btn {
  width: 100%;
  height: 52px;
  margin-top: 12px;
  border-radius: 24px;
  background-color: #1a1a1a;
  justify-content: center;
  align-items: center;
}

.retry-text {
  font-size: 22px;
  color: #fff;
  font-weight: bold;
}

.section-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  width: 100%;
}

.padding {
  height: 10px;
}

@media (device-type: watch) and (shape: circle) {
  .card,
  .content-card {
    width: 332px;
  }

  .padding {
    height: 60px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .card,
  .content-card {
    width: 420px;
  }

  .padding {
    height: 40px;
  }

  .qrcode-box {
    width: 300px;
    height: 300px;
    padding: 12px;
  }

  .download-qrcode {
    width: 276px;
    height: 276px;
  }
}
</style>
