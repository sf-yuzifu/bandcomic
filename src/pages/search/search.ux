<template>
  <div class="demo-page">
    <text class="time">{{ time }}</text>

    <div class="title" style="justify-content: center">
      <text
        class="iconfont"
        style="margin-right: 10px"
        if.static="{{ global.screenShape == 'circle' }}"
      >
        &#xe685;
      </text>
      <marquee
        static
        scrollamount="{{ 20 }}"
        text-offset="{{ 20 }}"
        style="font-size: 32px; font-weight: bold; text-align: center"
        @click="
          () => {
            if (global.screenShape == 'circle') {
              routeBack();
            }
          }
        "
      >
        {{ $t("search.search") }}{{ keyword }}
      </marquee>
    </div>
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/info.png"
      @click="routeAbout"
    />

    <div class="loading-container" if="{{ loading }}">
      <text static class="loading-text">{{ $t("search.searching") }}</text>
    </div>

    <list id="scrollId" class="search-results" bounces="true" if="{{ searchResults.length > 0 }}">
      <list-item
        for="{{ searchResults }}"
        type="result-item"
        class="result-item"
        @click="selectResult($item)"
      >
        <div class="result-content">
          <div
            class="cover-mask"
            if="{{ global.APP_SETTING.showCoverInSearch == 'true' || global.APP_SETTING.showCoverInSearch === true }}"
          >
            <image
              class="result-image"
              src="{{ $item.thumb || '/common/loading.png' }}"
              alt="/common/empty.png"
            ></image>
            <image static class="corner-mask" src="/common/coverMask.png"></image>
          </div>
          <div class="result-text-content">
            <text class="result-title">{{ $item.title }}</text>
            <text if="{{ $item.pages }}" class="result-meta">
              {{ $t("search.totalPage", { page: $item.pages }) }}
            </text>
          </div>
        </div>
      </list-item>

      <list-item type="pagination" class="pagination-wrapper">
        <div class="pagination-controls">
          <div
            class="{{ displayPage > 1 ? 'pagination-button' : 'pagination-button-disabled' }}"
            @click="changeDisplayPage(displayPage - 1)"
          >
            <text class="{{ displayPage > 1 ? 'text-normal' : 'text-disabled' }}">
              {{ $t("search.up") }}
            </text>
          </div>
          <text class="page-indicator">
            {{ $t("search.page", { page: displayPage }) }}
          </text>
          <div
            class="{{ canGoNext() ? 'pagination-button' : 'pagination-button-disabled' }}"
            @click="changeDisplayPage(displayPage + 1)"
          >
            <text class="{{ canGoNext() ? 'text-normal' : 'text-disabled' }}">
              {{ loadingMore ? "..." : $t("search.down") }}
            </text>
          </div>
        </div>
      </list-item>
    </list>

    <div class="no-results" if="{{ !loading && searchResults.length === 0 && searched && !error }}">
      <text static class="no-results-text">{{ $t("search.noFound") }}</text>
    </div>
    <div class="error-state" if="{{ error && searchResults.length === 0 }}">
      <text class="error-text">{{ $t("search.fail") }}{{ errorMsg }}</text>
      <text static class="no-results-subtext">{{ $t("search.noFound") }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { addCoverParams } = global.$img;
const { serializeParams } = global.$route;
const { apiFetch, buildSearchUrl, buildDetailUrl, getFetchErrorType } = global.$api;
const { getSearchPageSize } = global.$set;
const { loadCoverProxies } = global.$cover;

const { getTime } = global;
const MAX_CACHE = 50; // 结果缓存上限，超出后丢弃最旧的服务器页

let requestSeq = 0; // 请求序号，过期请求的回调直接忽略
let lastFillEnd = -1; // 填页进度记录，连续请求无新数据则放弃填充

// 结果仓库与 UI 无关（模板只渲染 searchResults 分页切片），放模块级减少
// viewModel 的 observer/数据代理开销；模块级变量跨页面实例共享，需 onInit/onDestroy 重置
// （requestSeq 须保持单调递增以作废旧实例的在途回调，不在重置之列）
let apiResults = []; // 数据仓库，存储当前缓存的API数据
let apiDroppedCount = 0; // 因缓存上限被丢弃的前部数据条数
let apiPageMap = []; // 每个服务器页对应的全局起始下标，用于回翻已丢弃页时重新请求
let apiNextCursor = null; // 下一次网络请求的游标
let apiHasNext = true; // API是否还有更多数据

export default {
  protected: {
    keyword: "",
  },
  private: {
    searchResults: [], // 当前显示的10项数据
    displayPage: 1, // 前端显示的页码

    loading: true,
    loadingMore: false,
    searched: false,
    error: false,
    errorMsg: "",
    time: "",
  },

  onInit() {
    this.time = getTime();
    apiResults = [];
    apiDroppedCount = 0;
    apiPageMap = [];
    apiNextCursor = null;
    apiHasNext = true;
    lastFillEnd = -1;
    this.fetchMore(); // 初始化时，获取第一批数据
  },

  onDestroy() {
    // 作废旧实例全部在途回调（requestSeq 单调递增，新实例请求会继续 +1 不受影响），
    // 并释放结果仓库引用，避免页面销毁后带封面数据驻留内存
    requestSeq++;
    apiResults = [];
    apiPageMap = [];
  },

  // 网络请求模块：只负责获取数据并追加到仓库
  fetchMore() {
    if (this.loadingMore || !apiHasNext) return;

    this.loadingMore = true;
    this.error = false;
    const seq = ++requestSeq;
    const apiKey = {
      search: true,
    };

    apiKey.text = this.keyword;
    if (apiNextCursor) {
      apiKey.page = apiNextCursor;
    }

    if (apiKey.search) {
      apiFetch({
        url: buildSearchUrl(apiKey.text, apiKey.page),
        responseType: "json",
        success: (response) => {
          if (seq !== requestSeq) return;
          this.ComicHandleSearchSuccess(response);
        },
        fail: (data, code) => {
          if (seq !== requestSeq) return;
          this.error = true;
          this.errorMsg =
            getFetchErrorType(code) === "timeout"
              ? this.$t("search.networkError")
              : this.$t("search.requestError");
        },
        complete: () => {
          if (seq !== requestSeq) return;
          this.loadingMore = false;
          this.searched = true;
          if (this.error) {
            this.loading = false;
          } else {
            this.fillCurrentPage();
          }
        },
      });
    }
  },

  ComicHandleSearchSuccess(response) {
    const data = response.data;

    if (!data || !Array.isArray(data.results)) {
      this.error = true;
      this.errorMsg = this.$t("error.invalidResponse");
      return;
    }

    this.error = false;
    this.errorMsg = "";
    const results = this.parseResults(data.results);

    apiPageMap.push({
      serverPage: data.page,
      start: apiDroppedCount + apiResults.length,
    });
    apiResults = apiResults.concat(results);
    this.trimCache();

    apiHasNext = data.has_more;
    apiNextCursor = data.page + 1;
  },

  // 填页模块：当前显示页填满设置项数（或已无更多数据）才渲染，否则继续请求
  fillCurrentPage() {
    const cachedEnd = apiDroppedCount + apiResults.length;
    const startIndex = (this.displayPage - 1) * getSearchPageSize();
    if (cachedEnd >= startIndex + getSearchPageSize() || !apiHasNext) {
      lastFillEnd = -1;
      this.loading = false;
      this.updateSearchResults();
    } else if (cachedEnd !== lastFillEnd) {
      lastFillEnd = cachedEnd;
      this.fetchMore();
    } else {
      // 连续请求没有拿到新数据，放弃填充，显示现有内容
      lastFillEnd = -1;
      this.loading = false;
      this.updateSearchResults();
    }
  },

  parseResults(results) {
    return results.map((result) => {
      return {
        gid: result.comic_id,
        title: result.title,
        thumb: result.cover_url ? addCoverParams(result.cover_url) : "",
      };
    });
  },

  // 缓存超过上限时，按服务器页粒度丢弃最旧的数据
  trimCache() {
    while (apiResults.length > MAX_CACHE) {
      const cached = apiPageMap.filter((entry) => entry.start >= apiDroppedCount);
      if (cached.length <= 1) {
        break;
      }
      const dropCount = cached[1].start - apiDroppedCount - (cached[0].start - apiDroppedCount);
      if (dropCount <= 0) {
        break;
      }
      apiResults = apiResults.slice(dropCount);
      apiDroppedCount += dropCount;
    }
  },

  // 前端翻页模块：只负责从仓库切片数据并显示
  changeDisplayPage(targetPage) {
    if (targetPage < 1) return;

    lastFillEnd = -1;
    const startIndex = (targetPage - 1) * getSearchPageSize();
    const cachedEnd = apiDroppedCount + apiResults.length;

    if (startIndex >= apiDroppedCount && cachedEnd > startIndex) {
      if (cachedEnd >= startIndex + getSearchPageSize() || !apiHasNext) {
        // 数据足够填满（或已是最后一页），直接更新显示
        this.displayPage = targetPage;
        this.updateSearchResults();
      } else if (!this.loadingMore) {
        // 不够填满，先翻页再补数据
        this.displayPage = targetPage;
        this.fetchMore();
      }
    } else if (startIndex < apiDroppedCount) {
      // 数据已被清理，按服务器页码重新请求
      this.refetchDroppedPage(targetPage, startIndex);
    } else if (apiHasNext && !this.loadingMore) {
      // 不足，但API还有数据，则先更新目标页码，然后去请求
      this.displayPage = targetPage;
      this.fetchMore();
    }
  },

  // 回翻到已丢弃的页时，找到覆盖该页的服务器页码并重新请求
  refetchDroppedPage(targetPage, startIndex) {
    if (this.loadingMore) return;

    let target = null;
    for (const entry of apiPageMap) {
      if (entry.start <= startIndex) {
        target = entry;
      } else {
        break;
      }
    }
    if (!target) return;

    this.loadingMore = true;
    this.displayPage = targetPage;
    const seq = ++requestSeq;
    let ok = false;

    apiFetch({
      url: buildSearchUrl(this.keyword, target.serverPage),
      responseType: "json",
      success: (response) => {
        if (seq !== requestSeq) return;
        const data = response.data;
        if (data && Array.isArray(data.results)) {
          // 丢弃该服务器页之后的旧映射，后续翻页会重新记录
          apiPageMap = apiPageMap.filter((entry) => entry.serverPage < target.serverPage);
          apiPageMap.push({
            serverPage: target.serverPage,
            start: target.start,
          });
          apiDroppedCount = target.start;
          apiResults = this.parseResults(data.results);
          apiHasNext = data.has_more;
          apiNextCursor = data.page + 1;
          this.trimCache();
          ok = true;
        } else {
          prompt.showToast({
            message: this.$t("error.invalidResponse"),
            duration: 3000,
          });
        }
      },
      fail: (data, code) => {
        if (seq !== requestSeq) return;
        prompt.showToast({
          message:
            getFetchErrorType(code) === "timeout"
              ? this.$t("search.networkError")
              : this.$t("search.requestError"),
          duration: 3000,
        });
      },
      complete: () => {
        if (seq !== requestSeq) return;
        this.loadingMore = false;
        if (ok) {
          this.fillCurrentPage();
        }
      },
    });
  },

  // 更新显示列表的辅助函数
  updateSearchResults() {
    const startIndex = (this.displayPage - 1) * getSearchPageSize() - apiDroppedCount;
    const endIndex = startIndex + getSearchPageSize();
    this.searchResults = apiResults.slice(startIndex, endIndex);
    this.loadResultCovers();

    const scrollToTop = () => {
      const el = this.$element("scrollId");
      if (el && typeof el.scrollTo === "function") {
        el.scrollTo({ index: 0, behavior: "instant" });
      }
    };
    if (typeof this.$nextTick === "function") {
      this.$nextTick(scrollToTop);
    } else {
      setTimeout(scrollToTop, 50);
    }
  },

  // 不支持直接加载远程图片的设备，通过插件把封面拉为本地文件后替换显示
  loadResultCovers() {
    loadCoverProxies(this.searchResults, {
      getUrl: (item) => item.thumb,
      getName: (item) => `${global.API_SETTING.using}_${item.gid}_cover`,
      match: (row, item) => row.gid === item.gid && row.thumb === item.thumb,
      merge: (item, uri) => ({ ...item, thumb: uri }),
      skipSame: true,
      onLocal: (item, updated) => {
        // 同步更新数据仓库，回翻页时不再重复代理
        const cacheIndex = apiResults.findIndex(
          (r) => r.gid === item.gid && r.thumb === item.thumb
        );
        if (cacheIndex !== -1) {
          apiResults[cacheIndex] = updated;
        }
      },
    });
  },

  // 判断是否可以点击下一页
  canGoNext() {
    const nextNeededIndex = this.displayPage * getSearchPageSize();
    return apiDroppedCount + apiResults.length > nextNeededIndex || apiHasNext;
  },

  selectResult(result) {
    apiFetch({
      url: buildDetailUrl(result.gid),
      responseType: "json",
      success: (response) => {
        if (!response.data || typeof response.data !== "object") {
          prompt.showToast({
            message: this.$t("error.invalidResponse"),
            duration: 3000,
          });
          return;
        }
        router.push({
          uri: "/pages/album",
          params: serializeParams(response.data),
        });
      },
      fail: (data, code) => {
        console.debug(data, code);
        if (getFetchErrorType(code) === "timeout") {
          prompt.showToast({
            message: this.$t("error.noComicFound"),
            duration: 3000,
          });
        } else {
          prompt.showToast({
            message: this.$t("error.unknownError") + data,
            duration: 3000,
          });
        }
      },
    });
  },

  routeBack() {
    router.back();
  },
  routeAbout() {
    router.push({ uri: "/pages/about" });
  },
};
</script>

<style>
@import "../../common/base.css";
@import "../../common/pagination.css";

.demo-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  flex: 1;
}
.title,
.time,
.loading-container,
.no-results,
.error-state {
  align-self: center;
}
.loading-container,
.no-results,
.error-state {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 100%;
}
.search-results {
  flex: 1;
  width: 90%;
  margin-top: 10px;
  align-self: center;
}

.result-item {
  margin-bottom: 10px;
  height: 120px;
  width: 100%;
  background-color: transparent;
  border-radius: 24px;
  padding: 0;
  align-items: center;
  justify-content: space-around;
}

.result-content {
  width: 100%;
  height: 100%;
  background-color: #262626;
  border-radius: 24px;
  padding: 12px 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.result-image {
  width: 60px;
  height: 80px;
  background-color: #1a1a1a;
  flex-shrink: 0;
  object-fit: cover;
}

.cover-mask {
  width: 60px;
  height: 80px;
  position: relative;
}

.corner-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.result-text-content {
  flex: 1;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 10px;
}

.result-title {
  width: 100%;
  font-size: 24px;
  color: #ffffff;
  lines: 3;
  font-weight: bold;
}

.result-meta {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.6);
}

.loading-text,
.no-results-text,
.error-text {
  font-size: 24px;
}

.error-state {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-text {
  margin-bottom: 10px;
}

.no-results-subtext {
  font-size: 24px;
  color: rgb(255, 255, 255);
}

@media (shape: circle) {
  .search-results {
    width: 80%;
  }
}

/* 看看是不是小米手环Pro */
@media (device-type: band) and (shape: rect) {
  .title {
    width: 180px;
  }
}

/* 看看是不是红米手表 */
@media (device-type: watch) and (shape: rect) {
  .title {
    width: 248px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .title {
    width: 240px;
  }
}
</style>
