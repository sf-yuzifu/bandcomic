<template>
  <div class="demo-page">
    <text class="time">{{ time }}</text>

    <div class="title" style="justify-content: center">
      <text
        class="iconfont"
        style="margin-right: 10px"
        if.static="{{ global.screenShape == 'circle' }}"
      >
        &#xe685;
      </text>
      <marquee
        static
        scrollamount="{{ 20 }}"
        text-offset="{{ 20 }}"
        style="font-size: 32px; font-weight: bold; text-align: center"
        @click="
          () => {
            if (global.screenShape == 'circle') {
              routeBack();
            }
          }
        "
      >
        {{ $t("search.search") }}{{ keyword }}
      </marquee>
    </div>
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/info.png"
      @click="routeAbout"
    />

    <div class="loading-container" if="{{ loading }}">
      <text static class="loading-text">{{ $t("search.searching") }}</text>
    </div>

    <list id="scrollId" class="search-results" bounces="true" if="{{ searchResults.length > 0 }}">
      <list-item
        for="{{ searchResults }}"
        type="result-item"
        class="result-item {{ $item.opening ? 'result-item-opening' : '' }}"
        @click="selectResult($item)"
      >
        <div class="result-content">
          <div
            class="cover-mask"
            if="{{ showCoverInSearch }}"
          >
            <image
              class="result-image"
              src="{{ $item.thumbDisplay || $item.thumb || '/common/loading.png' }}"
              alt="/common/empty.png"
            ></image>
            <image static class="corner-mask" src="/common/coverMask.png"></image>
          </div>
          <div class="result-text-content">
            <text class="result-title">{{ $item.title }}</text>
            <text if="{{ $item.opening }}" class="result-meta">{{ $t("search.opening") }}</text>
            <text if="{{ !$item.opening && $item.pages }}" class="result-meta">
              {{ $t("search.totalPage", { page: $item.pages }) }}
            </text>
          </div>
        </div>
      </list-item>

      <list-item type="pagination" class="pagination-wrapper">
        <div class="pagination-controls">
          <div
            class="{{ displayPage > 1 ? 'pagination-button' : 'pagination-button-disabled' }}"
            @click="changeDisplayPage(displayPage - 1)"
          >
            <text class="{{ displayPage > 1 ? 'text-normal' : 'text-disabled' }}">
              {{ $t("search.up") }}
            </text>
          </div>
          <text class="page-indicator">
            {{ $t("search.page", { page: displayPage }) }}
          </text>
          <div
            class="{{ canGoNext() ? 'pagination-button' : 'pagination-button-disabled' }}"
            @click="changeDisplayPage(displayPage + 1)"
          >
            <text class="{{ canGoNext() ? 'text-normal' : 'text-disabled' }}">
              {{ loadingMore ? "..." : $t("search.down") }}
            </text>
          </div>
        </div>
      </list-item>
    </list>

    <div class="no-results" if="{{ !loading && searchResults.length === 0 && searched && !error }}">
      <text static class="no-results-text">{{ $t("search.noFound") }}</text>
    </div>
    <div class="error-state" if="{{ error && searchResults.length === 0 }}">
      <text class="error-text">{{ $t("search.fail") }}{{ errorMsg }}</text>
      <text static class="no-results-subtext">{{ $t("search.noFound") }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { addCoverParams } = global.$img;
const { serializeParams } = global.$route;
const { apiFetch, buildSearchUrl, buildDetailUrl, getFetchErrorType, isComicDetailResponse } = global.$api;
const { getSearchPageSize } = global.$set;
const { loadCoverProxies } = global.$cover;

const { getTime } = global;
const MAX_CACHE = 50; // 结果缓存上限，超出后丢弃最旧的服务器页

function isCoverSearchEnabled() {
  const value = global.APP_SETTING && global.APP_SETTING.showCoverInSearch;
  return value === true || value === "true";
}

let requestSeq = 0; // 请求序号，过期请求的回调直接忽略
let lastFillEnd = -1; // 填页进度记录，连续请求无新数据则放弃填充
let pendingPrevPage = 0; // 翻页在途前的页码快照：中途失败回退指示器（P1-16②）

// 结果仓库与 UI 无关（模板只渲染 searchResults 分页切片），放模块级减少
// viewModel 的 observer/数据代理开销；模块级变量跨页面实例共享，需 onInit/onDestroy 重置
// （requestSeq 须保持单调递增以作废旧实例的在途回调，不在重置之列）
let apiResults = []; // 数据仓库，存储当前缓存的API数据
let apiDroppedCount = 0; // 因缓存上限被丢弃的前部数据条数
let apiPageMap = []; // 每个服务器页对应的全局起始下标，用于回翻已丢弃页时重新请求
let apiNextCursor = null; // 下一次网络请求的游标
let apiHasNext = true; // API是否还有更多数据

export default {
  protected: {
    keyword: "",
  },
  private: {
    searchResults: [], // 当前显示的10项数据
    displayPage: 1, // 前端显示的页码

    loading: true,
    loadingMore: false,
    loadingDetail: false, // 详情拉取在途：防双击重入（P1-16③）
    searched: false,
    error: false,
    errorMsg: "",
    time: "",
    showCoverInSearch: true,
    cleanSeq: 0,
  },

  onInit() {
    this.destroyed = false;
    this.time = getTime();
    this.showCoverInSearch = isCoverSearchEnabled();
    this.cleanSeq = (typeof global !== "undefined" && global.__tempFilesCleanSeq) || 0;
    apiResults = [];
    apiDroppedCount = 0;
    apiPageMap = [];
    apiNextCursor = null;
    apiHasNext = true;
    lastFillEnd = -1;
    pendingPrevPage = 0;
    this.fetchMore(); // 初始化时，获取第一批数据
  },

  onShow() {
    // 从 album 返回时清掉行级"打开中"反馈（P1-16③ 返修）：页级变量绑定 for 行
    // 不触发重绘、push 前清又与导航同帧竞争——改行数据字段 + splice 清除
    this.clearOpening();
    this.loadingDetail = false;
    const currentCleanSeq = (typeof global !== "undefined" && global.__tempFilesCleanSeq) || 0;
    const cleanOccurred = currentCleanSeq !== this.cleanSeq;
    if (cleanOccurred) {
      this.cleanSeq = currentCleanSeq;
      // 临时文件被清理后，失效本地展示 URI 并重新触发代理补载（P1-37）
      this.searchResults = this.searchResults.map((item) => ({ ...item, thumbDisplay: "" }));
      apiResults = apiResults.map((item) => ({ ...item, thumbDisplay: "" }));
    }
    const showCoverInSearch = isCoverSearchEnabled();
    if (showCoverInSearch !== this.showCoverInSearch || cleanOccurred) {
      this.showCoverInSearch = showCoverInSearch;
      if (showCoverInSearch) {
        this.loadResultCovers();
      } else {
        this.cancelResultCovers();
      }
    }
  },

  onDestroy() {
    // 作废旧实例全部在途回调（requestSeq 单调递增，新实例请求会继续 +1 不受影响），
    // 并释放结果仓库引用，避免页面销毁后带封面数据驻留内存
    this.cancelResultCovers();
    requestSeq++;
    this.destroyed = true;
    apiResults = [];
    apiPageMap = [];
  },

  // 网络请求模块：只负责获取数据并追加到仓库
  fetchMore() {
    if (this.loadingMore || !apiHasNext) return;

    this.loadingMore = true;
    this.error = false;
    const seq = ++requestSeq;
    const apiKey = {
      search: true,
    };

    apiKey.text = this.keyword;
    if (apiNextCursor) {
      apiKey.page = apiNextCursor;
    }

    if (apiKey.search) {
      apiFetch({
        url: buildSearchUrl(apiKey.text, apiKey.page),
        responseType: "json",
        success: (response) => {
          if (seq !== requestSeq) return;
          this.ComicHandleSearchSuccess(response);
        },
        fail: (data, code) => {
          if (seq !== requestSeq) return;
          this.error = true;
          this.errorMsg =
            getFetchErrorType(code) === "timeout"
              ? this.$t("search.networkError")
              : this.$t("search.requestError");
          // 中途失败不再静默（P1-16②）：toast + 回退指示器；初始加载走 error-state
          this.failPageFlip(this.errorMsg);
        },
        complete: () => {
          if (seq !== requestSeq) return;
          this.loadingMore = false;
          this.searched = true;
          if (this.error) {
            this.loading = false;
          } else {
            this.fillCurrentPage();
          }
        },
      });
    }
  },

  ComicHandleSearchSuccess(response) {
    const data = response.data;

    if (!data || !Array.isArray(data.results)) {
      this.error = true;
      this.errorMsg = this.$t("error.invalidResponse");
      this.failPageFlip(this.errorMsg);
      return;
    }

    this.error = false;
    this.errorMsg = "";
    const results = this.parseResults(data.results);

    apiPageMap.push({
      serverPage: data.page,
      start: apiDroppedCount + apiResults.length,
    });
    apiResults = apiResults.concat(results);
    this.trimCache();

    apiHasNext = data.has_more;
    apiNextCursor = data.page + 1;
  },

  // 填页模块：当前显示页填满设置项数（或已无更多数据）才渲染，否则继续请求
  fillCurrentPage() {
    const cachedEnd = apiDroppedCount + apiResults.length;
    const startIndex = (this.displayPage - 1) * getSearchPageSize();
    if (cachedEnd >= startIndex + getSearchPageSize() || !apiHasNext) {
      lastFillEnd = -1;
      this.loading = false;
      this.updateSearchResults();
    } else if (cachedEnd !== lastFillEnd) {
      lastFillEnd = cachedEnd;
      this.fetchMore();
    } else {
      // 连续请求没有拿到新数据，放弃填充，显示现有内容
      lastFillEnd = -1;
      this.loading = false;
      this.updateSearchResults();
    }
  },

  parseResults(results) {
    return results.map((result) => {
      return {
        gid: result.comic_id,
        title: result.title,
        thumb: result.cover_url ? addCoverParams(result.cover_url) : "",
        thumbDisplay: "",
      };
    });
  },

  // 缓存超过上限时，按服务器页粒度丢弃最旧的数据；
  // 必须保护当前待展示页所覆盖的数据范围，避免淘汰越界导致当前显示页数据被删
  trimCache() {
    const protectedStart = (this.displayPage - 1) * getSearchPageSize();
    while (apiResults.length > MAX_CACHE) {
      const cached = apiPageMap.filter((entry) => entry.start >= apiDroppedCount);
      if (cached.length <= 1) {
        break;
      }
      const nextStart = cached[1].start;
      // 若丢弃该服务端页后，起始点将跨过当前展示页所需的起始下标，则停止丢弃（允许临时受控超限）
      if (nextStart > protectedStart) {
        break;
      }
      const dropCount = nextStart - apiDroppedCount;
      if (dropCount <= 0) {
        break;
      }
      apiResults = apiResults.slice(dropCount);
      apiDroppedCount += dropCount;
    }
  },

  // 翻页/补页请求失败收口（P1-16②）：中途失败（列表已有内容）toast 并把页码
  // 指示器回退到内容实际所在页——列表数据未变，指示器复位即对齐；初始加载
  //（空列表）保持 error-state 现状
  failPageFlip(message) {
    if (this.searchResults.length === 0) return;
    prompt.showToast({ message: message, duration: 3000 });
    if (pendingPrevPage > 0 && pendingPrevPage !== this.displayPage) {
      this.displayPage = pendingPrevPage;
    }
    pendingPrevPage = 0;
  },

  // 前端翻页模块：只负责从仓库切片数据并显示
  changeDisplayPage(targetPage) {
    if (targetPage < 1) return;

    lastFillEnd = -1;
    pendingPrevPage = this.displayPage; // 中途失败回退目标（P1-16②）
    const startIndex = (targetPage - 1) * getSearchPageSize();
    const cachedEnd = apiDroppedCount + apiResults.length;

    if (startIndex >= apiDroppedCount && cachedEnd > startIndex) {
      if (cachedEnd >= startIndex + getSearchPageSize() || !apiHasNext) {
        // 数据足够填满（或已是最后一页），直接更新显示
        this.displayPage = targetPage;
        this.updateSearchResults();
      } else if (!this.loadingMore) {
        // 不够填满，先翻页再补数据
        this.displayPage = targetPage;
        this.fetchMore();
      }
    } else if (startIndex < apiDroppedCount) {
      // 数据已被清理，按服务器页码重新请求
      this.refetchDroppedPage(targetPage, startIndex);
    } else if (apiHasNext && !this.loadingMore) {
      // 不足，但API还有数据，则先更新目标页码，然后去请求
      this.displayPage = targetPage;
      this.fetchMore();
    }
  },

  // 回翻到已丢弃的页时，找到覆盖该页的服务器页码并重新请求
  refetchDroppedPage(targetPage, startIndex) {
    if (this.loadingMore) return;

    let target = null;
    for (const entry of apiPageMap) {
      if (entry.start <= startIndex) {
        target = entry;
      } else {
        break;
      }
    }
    if (!target) return;

    this.loadingMore = true;
    this.displayPage = targetPage;
    const seq = ++requestSeq;
    let ok = false;

    apiFetch({
      url: buildSearchUrl(this.keyword, target.serverPage),
      responseType: "json",
      success: (response) => {
        if (seq !== requestSeq) return;
        const data = response.data;
        if (data && Array.isArray(data.results)) {
          // 丢弃该服务器页之后的旧映射，后续翻页会重新记录
          apiPageMap = apiPageMap.filter((entry) => entry.serverPage < target.serverPage);
          apiPageMap.push({
            serverPage: target.serverPage,
            start: target.start,
          });
          apiDroppedCount = target.start;
          apiResults = this.parseResults(data.results);
          apiHasNext = data.has_more;
          apiNextCursor = data.page + 1;
          this.trimCache();
          ok = true;
        } else {
          this.failPageFlip(this.$t("error.invalidResponse"));
        }
      },
      fail: (data, code) => {
        if (seq !== requestSeq) return;
        this.failPageFlip(
          getFetchErrorType(code) === "timeout"
            ? this.$t("search.networkError")
            : this.$t("search.requestError")
        );
      },
      complete: () => {
        if (seq !== requestSeq) return;
        this.loadingMore = false;
        if (ok) {
          this.fillCurrentPage();
        }
      },
    });
  },

  // 更新显示列表的辅助函数
  updateSearchResults() {
    const rawStart = (this.displayPage - 1) * getSearchPageSize() - apiDroppedCount;
    const startIndex = Math.max(0, rawStart);
    const endIndex = Math.min(apiResults.length, startIndex + getSearchPageSize());
    this.searchResults = rawStart < 0 ? [] : apiResults.slice(startIndex, endIndex);
    if (this.showCoverInSearch) {
      this.loadResultCovers();
    } else {
      this.cancelResultCovers();
    }

    const scrollToTop = () => {
      const el = this.$element("scrollId");
      if (el && typeof el.scrollTo === "function") {
        el.scrollTo({ index: 0, behavior: "instant" });
      }
    };
    if (typeof this.$nextTick === "function") {
      this.$nextTick(scrollToTop);
    } else {
      setTimeout(scrollToTop, 50);
    }
  },

  // 不支持直接加载远程图片的设备，通过插件把封面拉为本地文件后替换显示
  loadResultCovers() {
    this.cancelResultCovers();
    this._cancelResultCovers = loadCoverProxies(this.searchResults, {
      getUrl: (item) => item.thumb,
      getName: (item) => `${global.API_SETTING.using}_${item.gid}_cover`,
      getSourceKey: () => global.API_SETTING.using,
      match: (row, item) => row.gid === item.gid && row.thumb === item.thumb,
      merge: (item, uri) => ({ ...item, thumbDisplay: uri }),
      skipSame: true,
      onLocal: (item, updated) => {
        // 同步更新数据仓库，回翻页时不再重复代理
        const cacheIndex = apiResults.findIndex(
          (r) => r.gid === item.gid && r.thumb === item.thumb
        );
        if (cacheIndex !== -1) {
          apiResults[cacheIndex] = updated;
        }
      },
    });
  },

  cancelResultCovers() {
    if (!this._cancelResultCovers) return;
    this._cancelResultCovers();
    this._cancelResultCovers = null;
  },

  // 判断是否可以点击下一页
  canGoNext() {
    const nextNeededIndex = this.displayPage * getSearchPageSize();
    return apiDroppedCount + apiResults.length > nextNeededIndex || apiHasNext;
  },

  // 行级"打开中"清除（P1-16③ 返修）：splice 原地替换触发该行重绘——
  // coverLoader/oobe applySourceResult 同款、真机已验证的 for 行刷新方式
  clearOpening() {
    const index = this.searchResults.findIndex((row) => row.opening);
    if (index === -1) return;
    this.searchResults.splice(index, 1, { ...this.searchResults[index], opening: false });
  },

  selectResult(result) {
    // 防重入 + 行级反馈（P1-16③）：双击只发一次；requestSeq 与 fetchMore 链绑定
    // 不能共用（并发会互相作废），详情链用 loadingDetail + destroyed 双守卫
    if (this.loadingDetail) return;
    this.loadingDetail = true;
    // 行状态走行数据字段 + splice（P1-16③ 返修），页级绑定不触发 for 行重绘
    const openIndex = this.searchResults.findIndex((row) => row.gid === result.gid);
    if (openIndex !== -1) {
      this.searchResults.splice(openIndex, 1, {
        ...this.searchResults[openIndex],
        opening: true,
      });
    }
    apiFetch({
      url: buildDetailUrl(result.gid),
      responseType: "json",
      success: (response) => {
        if (this.destroyed) return;
        this.loadingDetail = false;
        // 不在此清行状态（P1-16③ 返修）：与 router.push 同帧竞争会留下永久灰显；
        // 行在跳转期间保持灰显，返回瞬间由 onShow 的 clearOpening 清掉
        if (!isComicDetailResponse(response)) {
          this.clearOpening();
          prompt.showToast({
            message: this.$t("error.invalidResponse"),
            duration: 3000,
          });
          return;
        }
        router.push({
          uri: "/pages/album",
          params: serializeParams(response.data),
        });
      },
      fail: (data, code) => {
        if (this.destroyed) return;
        this.loadingDetail = false;
        this.clearOpening();
        console.debug(data, code);
        // 超时是网络问题不是"未找到"（P1-16①，与 index getAlbum 对齐）
        if (getFetchErrorType(code) === "timeout") {
          prompt.showToast({
            message: this.$t("error.networkError"),
            duration: 3000,
          });
        } else {
          prompt.showToast({
            message: this.$t("error.unknownError") + data,
            duration: 3000,
          });
        }
      },
    });
  },

  routeBack() {
    router.back();
  },
  routeAbout() {
    router.push({ uri: "/pages/about" });
  },
};
</script>

<style>
@import "../../common/base.css";
@import "../../common/pagination.css";

.demo-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  flex: 1;
}
.title,
.time,
.loading-container,
.no-results,
.error-state {
  align-self: center;
}
.loading-container,
.no-results,
.error-state {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 100%;
}
.search-results {
  flex: 1;
  width: 90%;
  margin-top: 10px;
  align-self: center;
}

.result-item {
  margin-bottom: 10px;
  height: 120px;
  width: 100%;
  background-color: transparent;
  border-radius: 24px;
  padding: 0;
  align-items: center;
  justify-content: space-around;
}

/* 详情在途的被点行（P1-16③）：灰显提示等待 */
.result-item-opening {
  opacity: 0.5;
}

.result-content {
  width: 100%;
  height: 100%;
  background-color: #262626;
  border-radius: 24px;
  padding: 12px 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.result-image {
  width: 60px;
  height: 80px;
  background-color: #1a1a1a;
  flex-shrink: 0;
  object-fit: cover;
}

.cover-mask {
  width: 60px;
  height: 80px;
  position: relative;
}

.corner-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.result-text-content {
  flex: 1;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 10px;
}

.result-title {
  width: 100%;
  font-size: 24px;
  color: #ffffff;
  lines: 3;
  font-weight: bold;
}

.result-meta {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.6);
}

.loading-text,
.no-results-text,
.error-text {
  font-size: 24px;
}

.error-state {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-text {
  margin-bottom: 10px;
}

.no-results-subtext {
  font-size: 24px;
  color: rgb(255, 255, 255);
}

@media (shape: circle) {
  .search-results {
    width: 80%;
  }
}

/* 看看是不是小米手环Pro */
@media (device-type: band) and (shape: rect) {
  .title {
    width: 180px;
  }
}

/* 看看是不是红米手表 */
@media (device-type: watch) and (shape: rect) {
  .title {
    width: 248px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .title {
    width: 240px;
  }
}
</style>
