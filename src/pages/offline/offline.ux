<template>
  <div class="container">
    <img
      if="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/trans.png"
      @click="changeTab"
    />
    <text class="time">{{ time }}</text>
    <text
      @click="
        () => {
          if (global.screenShape == 'circle') {
            routeBack();
          }
        }
      "
      class="title"
    >
      <span class="iconfont" if="{{ global.screenShape == 'circle' }}">&#xe685;</span>
      <span>{{ currentTab === 'offline' ? $t("offline.offline") : $t("offline.historyTitle") }}</span>
    </text>

    <swiper index="{{currentTab === 'offline' ? 0 : 1}}" class="swiper" @change="switchTab" enableswipe="{{enableSwipe}}">
      <!-- 本地漫画标签页 -->
      <div class="tab-switcher">
        <div if="{{ storageLoaded }}" class="storage-container">
          <text class="storage-label">{{ $t("offline.storage") }}</text>
          <div class="storage-bar">
            <div class="storage-bar-segment-reserved" style="width: {{ systemReservedPercent }}%"></div>
            <div class="storage-bar-segment-comics" style="width: {{ comicsUsedPercent }}%"></div>
            <div class="storage-bar-segment-other" style="width: {{ actualUsedPercent - comicsUsedPercent }}%"></div>
            <div class="storage-bar-segment-remaining" style="width: {{ 100 - actualUsedPercent - systemReservedPercent }}%"></div>
          </div>
          <div class="storage-list">
            <div class="storage-list-item" @click="toggleStorageList">
              <div class="storage-list-color storage-list-color-remaining"></div>
              <text class="storage-list-label">{{ $t("offline.remaining") }}</text>
              <text class="storage-list-value">{{ remaining }}</text>
              <text class="storage-list-arrow">{{ storageListExpanded ? '&#xe686' : '&#xe685' }}</text>
            </div>
            <div if="{{ storageListExpanded && systemReservedPercent }}" class="storage-list-item">
              <div class="storage-list-color storage-list-color-reserved"></div>
              <text class="storage-list-label">{{ $t("offline.legendReserved") }}</text>
              <text class="storage-list-value">{{ systemReserved }}</text>
              <text class="storage-list-arrow" style="opacity: 0;">&#xe686</text>
            </div>
            <div if="{{ storageListExpanded }}" class="storage-list-item">
              <div class="storage-list-color storage-list-color-comics"></div>
              <text class="storage-list-label">{{ $t("offline.comicsUsed") }}</text>
              <text class="storage-list-value">{{ comicsUsed }}</text>
              <text class="storage-list-arrow" style="opacity: 0;">&#xe686</text>
            </div>
            <div if="{{ storageListExpanded }}" class="storage-list-item">
              <div class="storage-list-color storage-list-color-other"></div>
              <text class="storage-list-label">{{ $t("offline.otherUsed") }}</text>
              <text class="storage-list-value">{{ otherUsed }}</text>
              <text class="storage-list-arrow" style="opacity: 0;">&#xe686</text>
            </div>
          </div>
        </div>
        <div style="height: 10px"></div>

        <list if="{{ comicsList.length != 0 }}" id="comicsScroll" class="box" bounces="true">
          <list-item for="{{ comicsList }}" class="item" type="list-item">
            <scroll class="swipe-item" scroll-x="true" id="scroll_{{ $idx }}" @scroll="(event) => onScroll(event.scrollX, $idx)">
              <div class="swipe-content" @click="toPhoto($item)">
                <div class="cover-mask">
                  <image class="cover" src="internal://files/{{ $item.id }}/cover" alt="/common/empty.png"></image>
                  <text class="tri iconfont" if="{{ $item.incomplete }}">&#xeb65;</text>
                  <image class="corner-mask" src="/common/coverMask.png"></image>
                </div>
                <div class="text-content">
                  <text class="itemText">{{ $item.name }}</text>
                  <text class="meta">{{ $t("offline.size") }} {{ $item.size }}</text>
                </div>
              </div>
              <div class="delete-btn" @click="del($item.id)">
                <image src="/common/del.png" class="delete-icon"></image>
              </div>
            </scroll>
          </list-item>
          <list-item type="pagination" class="pagination-wrapper" if="{{ comicsTotalPages() > 1 }}">
            <div class="pagination-controls">
              <div
                class="{{ comicsPage > 1 ? 'pagination-button' : 'pagination-button-disabled' }}"
                @click="changeComicsPage(comicsPage - 1)"
              >
                <text class="{{ comicsPage > 1 ? 'text-normal' : 'text-disabled' }}">
                  {{ $t("offline.up") }}
                </text>
              </div>
              <text class="page-indicator">
                {{ $t("offline.pageIndicator", { page: comicsPage }) }}
              </text>
              <div
                class="{{ comicsPage < comicsTotalPages() ? 'pagination-button' : 'pagination-button-disabled' }}"
                @click="changeComicsPage(comicsPage + 1)"
              >
                <text class="{{ comicsPage < comicsTotalPages() ? 'text-normal' : 'text-disabled' }}">
                  {{ $t("offline.down") }}
                </text>
              </div>
            </div>
          </list-item>
          <div if="{{ global.screenShape == 'circle' }}" style="height: 56px"></div>
        </list>

        <div class="empty" if="{{ comicsList.length == 0 }}">
          <image src="/common/empty.png"></image>
          <text class="empty-text">{{ isLoading ? $t("offline.loading") : $t("offline.empty") }}</text>
        </div>
      </div>

      <!-- 历史记录标签页 -->
      <div class="tab-switcher">
        <div style="height: 10px"></div>
        <list if="{{ historyList.length != 0 }}" id="historyScroll" class="box" bounces="true">
          <list-item for="{{ historyList }}" class="item" type="list-item">
            <scroll class="swipe-item" scroll-x="true" id="history_scroll_{{ $idx }}" @scroll="(event) => onHistoryScroll(event.scrollX, $idx)">
              <div class="swipe-content" @click="toHistoryPhoto($item)">
                <div class="cover-mask">
                  <image class="cover" src="{{ $item.coverLocal || $item.cover }}" alt="/common/empty.png"></image>
                  <image class="corner-mask" src="/common/coverMask.png"></image>
                </div>
                <div class="text-content">
                  <text class="itemText">{{ $item.title }}</text>
                  <text class="meta" if="{{ $item.is_serial }}">
                    {{ $t("offline.chapter", { chapter: $item.chapter }) }} {{ formatTime($item.last_read_time) }}
                  </text>
                  <text class="meta" else>{{ $t("offline.page", { page: $item.page }) }} {{ formatTime($item.last_read_time) }}</text>
                </div>
              </div>
              <div class="delete-btn" @click="delHistory($item.id)">
                <image src="/common/del.png" class="delete-icon"></image>
              </div>
            </scroll>
          </list-item>
          <list-item type="pagination" class="pagination-wrapper" if="{{ historyTotalPages() > 1 }}">
            <div class="pagination-controls">
              <div
                class="{{ historyPage > 1 ? 'pagination-button' : 'pagination-button-disabled' }}"
                @click="changeHistoryPage(historyPage - 1)"
              >
                <text class="{{ historyPage > 1 ? 'text-normal' : 'text-disabled' }}">
                  {{ $t("offline.up") }}
                </text>
              </div>
              <text class="page-indicator">
                {{ $t("offline.pageIndicator", { page: historyPage }) }}
              </text>
              <div
                class="{{ historyPage < historyTotalPages() ? 'pagination-button' : 'pagination-button-disabled' }}"
                @click="changeHistoryPage(historyPage + 1)"
              >
                <text class="{{ historyPage < historyTotalPages() ? 'text-normal' : 'text-disabled' }}">
                  {{ $t("offline.down") }}
                </text>
              </div>
            </div>
          </list-item>
          <div if="{{ global.screenShape == 'circle' }}" style="height: 56px"></div>
        </list>

        <div class="empty" if="{{ historyList.length == 0 }}">
          <image src="/common/empty.png"></image>
          <text class="empty-text">{{ isLoadingHistory ? $t("offline.historyLoading") : $t("offline.historyEmpty") }}</text>
        </div>
      </div>
    </swiper>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file";
import prompt from "@system.prompt";
import device from "@system.device";
import { serializeParams } from "../../components/routerParams";
import { addCoverParams } from "../../components/imageUrl";
import { proxyImage } from "../../components/api";
import { readComics, writeComics, updateComicMeta, readHistory, writeHistory } from "../../components/storage";

const { getTime } = global;

function getPageSize() {
  return parseInt(global.APP_SETTING.searchPageSize) || 10;
}

let del;

function formatFileSize(size) {
  if (size < 0) {
    return "0B";
  }
  if (size < 1024) {
    return size + "B";
  } else if (size < 1024 * 1024) {
    return (size / 1024).toFixed(2) + "KB";
  } else if (size < 1024 * 1024 * 1024) {
    return (size / (1024 * 1024)).toFixed(2) + "MB";
  } else {
    return (size / (1024 * 1024 * 1024)).toFixed(2) + "GB";
  }
}

let delHistoryId;

export default {
  private: {
    time: "",
    allComics: [],
    comicsList: [],
    comicsPage: 1,
    allHistory: [],
    historyList: [],
    historyPage: 1,
    storage: "",
    storagePercent: 0,
    storageUsed: "",
    storageTotal: "",
    totalStorage: 0,
    systemReserved: "",
    actualTotal: "",
    systemReservedPercent: 25,
    actualUsedPercent: 0,
    comicsUsed: "",
    comicsUsedPercent: 0,
    otherUsed: "",
    remaining: "",
    storageListExpanded: false,
    storageLoaded: false,
    isLoading: false,
    currentTab: "offline",
    isLoadingHistory: false,
    openedComicsIndex: -1,
    openedHistoryIndex: -1,
    enableSwipe: true,
  },

  onShow() {
    this.time = getTime();
  },

  onInit() {
    device.getInfo({
      success: (data) => {
        this.enableSwipe = data.product !== 'Xiaomi Smart Band 9 Pro';
      }
    });
    this.loadingComic();
    this.loadHistory();
  },

  switchTab(tab) {
    this.currentTab = tab.index ? 'history' : 'offline';
  },

  changeTab() {
    this.currentTab = this.currentTab === 'offline' ? 'history' : 'offline';
  },

  onScroll(scrollLeft, index) {
    if (scrollLeft === 0) return;
    this.comicsList[index].scrollLeft = scrollLeft;
    // 如果有其他已滑出的卡片，回滚它
    if (this.openedComicsIndex !== -1 && this.openedComicsIndex !== index) {
      const scrollEl = this.$element('scroll_' + this.openedComicsIndex);
      if (scrollEl) {
        scrollEl.scrollBy({ left: -100 });
      }
      this.comicsList[this.openedComicsIndex].scrollLeft = 0;
    }
    // 更新当前滑出的卡片索引
    this.openedComicsIndex = scrollLeft > 0 ? index : -1;
  },

  onHistoryScroll(scrollLeft, index) {
    if (scrollLeft === 0) return;
    this.historyList[index].scrollLeft = scrollLeft;
    // 如果有其他已滑出的历史记录卡片，回滚它
    if (this.openedHistoryIndex !== -1 && this.openedHistoryIndex !== index) {
      const scrollEl = this.$element('history_scroll_' + this.openedHistoryIndex);
      if (scrollEl) {
        scrollEl.scrollBy({ left: -100 });
      }
      this.historyList[this.openedHistoryIndex].scrollLeft = 0;
    }
    // 更新当前滑出的卡片索引
    this.openedHistoryIndex = scrollLeft > 0 ? index : -1;
  },

  loadHistory() {
    this.isLoadingHistory = true;
    readHistory().then(
      (historyList) => {
        if (!Array.isArray(historyList)) {
          historyList = [];
        }
        this.allHistory = historyList.filter(item => !item.local);
        if (this.historyPage > this.historyTotalPages()) {
          this.historyPage = this.historyTotalPages();
        }
        this.updateHistoryList();
        this.isLoadingHistory = false;
      },
      () => {
        this.allHistory = [];
        this.historyPage = 1;
        this.updateHistoryList();
        this.isLoadingHistory = false;
      }
    );
  },

  historyTotalPages() {
    return Math.max(1, Math.ceil(this.allHistory.length / getPageSize()));
  },

  comicsTotalPages() {
    return Math.max(1, Math.ceil(this.allComics.length / getPageSize()));
  },

  updateHistoryList() {
    const start = (this.historyPage - 1) * getPageSize();
    // 拷贝一份，封面代理结果只覆盖 coverLocal，不污染待持久化的原始数据
    this.historyList = this.allHistory
      .slice(start, start + getPageSize())
      .map((item) => ({ ...item }));
    this.loadHistoryCovers();
    this.openedHistoryIndex = -1;
    this.scrollListToTop("historyScroll");
  },

  // 不支持直接加载远程图片的设备，通过插件把封面拉为本地文件后替换显示
  loadHistoryCovers() {
    this.historyList.forEach((item) => {
      if (!item.cover || item.cover.indexOf("http") !== 0) return;
      proxyImage(
        addCoverParams(item.cover),
        `${item.source}_${item.originalId}_cover`,
        (uri) => {
          if (!uri) return;
          const index = this.historyList.findIndex((r) => r.id === item.id);
          if (index === -1) return;
          this.historyList.splice(index, 1, { ...item, coverLocal: uri });
        },
        1
      );
    });
  },

  updateComicsList() {
    const start = (this.comicsPage - 1) * getPageSize();
    this.comicsList = this.allComics.slice(start, start + getPageSize());
    this.openedComicsIndex = -1;
    this.scrollListToTop("comicsScroll");
  },

  scrollListToTop(id) {
    const scrollToTop = () => {
      const el = this.$element(id);
      if (el && typeof el.scrollTo === "function") {
        el.scrollTo({ index: 0, behavior: "instant" });
      }
    };
    if (typeof this.$nextTick === "function") {
      this.$nextTick(scrollToTop);
    } else {
      setTimeout(scrollToTop, 50);
    }
  },

  changeHistoryPage(targetPage) {
    if (targetPage < 1 || targetPage > this.historyTotalPages() || targetPage === this.historyPage) {
      return;
    }
    this.historyPage = targetPage;
    this.updateHistoryList();
  },

  changeComicsPage(targetPage) {
    if (targetPage < 1 || targetPage > this.comicsTotalPages() || targetPage === this.comicsPage) {
      return;
    }
    this.comicsPage = targetPage;
    this.updateComicsList();
  },

  formatTime(timestamp) {
    const date = new Date(timestamp);
    const now = new Date();
    const diff = now - date;

    // 小于1小时
    if (diff < 60 * 60 * 1000) {
      const minutes = Math.floor(diff / (60 * 1000));
      if (minutes < 1) {
        return this.$t("offline.justNow");
      }
      return this.$t("offline.minutesAgo", { minutes });
    }
    // 小于24小时
    if (diff < 24 * 60 * 60 * 1000) {
      const hours = Math.floor(diff / (60 * 60 * 1000));
      return this.$t("offline.hoursAgo", { hours });
    }
    // 小于7天
    if (diff < 7 * 24 * 60 * 60 * 1000) {
      const days = Math.floor(diff / (24 * 60 * 60 * 1000));
      return this.$t("offline.daysAgo", { days });
    }
    // 显示具体日期
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    return `${month}-${day}`;
  },

  toHistoryPhoto(item) {
    router.push({
      uri: "/pages/photo",
      params: {
        id: item.originalId,
        page_count: item.page_count,
        total_chapters: item.total_chapters,
        title: item.title,
        cover: item.cover,
        source: item.source,
      },
    });
  },

  delHistory(id) {
    if (delHistoryId !== id) {
      // 第一次点击，提示二次确认
      delHistoryId = id;
      prompt.showToast({
        message: this.$t("offline.historyDel"),
      });
      // 3秒后重置
      setTimeout(() => {
        if (delHistoryId === id) {
          delHistoryId = null;
        }
      }, 3000);
      return;
    }
    // 第二次点击，执行删除
    prompt.showToast({
      message: this.$t("offline.historySecondDel"),
    });

    // 从列表中删除
    const newList = this.allHistory.filter(item => item.id !== id);
    this.allHistory = newList;
    if (this.historyPage > this.historyTotalPages()) {
      this.historyPage = this.historyTotalPages();
    }
    this.updateHistoryList();

    // 保存到文件
    writeHistory(newList).then(
      () => {
        prompt.showToast({
          message: this.$t("offline.historyDelComplete"),
        });
      },
      ({ code }) => {
        prompt.showToast({
          message: this.$t("offline.historyDeleteFailed", { code }),
        });
      }
    );

    delHistoryId = null;
  },

  // 书架排序：按 max(最近阅读时间, 下载时间) 降序，都没有的保持原顺序沉底
  async sortComicsByRecent(comics) {
    let history = [];
    try {
      history = await readHistory();
      if (!Array.isArray(history)) {
        history = [];
      }
    } catch (e) {
      history = [];
    }
    const lastRead = {};
    history.forEach((item) => {
      if (item.local && item.originalId) {
        const t = item.last_read_time || 0;
        if (!lastRead[item.originalId] || lastRead[item.originalId] < t) {
          lastRead[item.originalId] = t;
        }
      }
    });
    return comics
      .map((comic, index) => ({
        comic: comic,
        index: index,
        key: Math.max(lastRead[comic.id] || 0, comic.downloaded_at || 0),
      }))
      .sort((a, b) => b.key - a.key || a.index - b.index)
      .map((w) => w.comic);
  },

  async loadingComic() {
    this.isLoading = true;
    let comics = [];
    try {
      comics = await readComics();
      if (!Array.isArray(comics)) {
        comics = [];
      }
    } catch (err) {
      console.debug(`读取comics.json失败, code = ${err.code}`);
      comics = [];
    }
    const stats = await this.getStorage(comics);
    comics.forEach((comic) => {
      comic.incomplete = this.isComicIncomplete(comic);
    });
    this.allComics = await this.sortComicsByRecent(comics);
    if (this.comicsPage > this.comicsTotalPages()) {
      this.comicsPage = this.comicsTotalPages();
    }
    this.updateComicsList();
    this.totalStorage = stats.totalStorage;
    this.storageTotal = stats.storageTotal;
    this.systemReserved = stats.systemReserved;
    this.actualTotal = stats.actualTotal;
    this.storage = stats.storage;
    this.comicsUsed = stats.comicsUsed;
    this.comicsUsedPercent = stats.comicsUsedPercent;
    this.storageUsed = stats.storageUsed;
    this.actualUsedPercent = stats.actualUsedPercent;
    this.otherUsed = stats.otherUsed;
    this.remaining = stats.remaining;
    this.systemReservedPercent = stats.systemReservedPercent;
    this.storageLoaded = true;
    this.isLoading = false;
  },

  checkFileExists() {
    return readComics().then(
      () => true,
      () => false
    );
  },

  async getStorage(comics) {
    let totalStorage = 0;
    let availableStorage = 0;

    const [totalResult, availableResult] = await Promise.all([
      new Promise((resolve) => {
        device.getTotalStorage({
          success: (data) => resolve(data),
          fail: (data, code) => {
            console.debug(`获取总存储空间失败, code = ${code}`);
            resolve(null);
          },
        });
      }),
      new Promise((resolve) => {
        device.getAvailableStorage({
          success: (data) => resolve(data),
          fail: (data, code) => {
            console.debug(`获取可用存储空间失败, code = ${code}`);
            resolve(null);
          },
        });
      }),
    ]);

    const stats = {
      totalStorage: 0,
      storageTotal: "",
      systemReserved: "",
      actualTotal: "",
      storage: "",
      comicsUsed: "",
      comicsUsedPercent: 0,
      storageUsed: "",
      actualUsedPercent: 0,
      otherUsed: "",
      remaining: "",
      systemReservedPercent: 25,
    };

    if (totalResult) {
      totalStorage = totalResult.totalStorage;
      const systemReserved = global.getReservedSpace(totalStorage);
      stats.totalStorage = totalStorage;
      stats.storageTotal = formatFileSize(totalStorage);
      stats.systemReserved = formatFileSize(systemReserved);
      stats.actualTotal = formatFileSize(totalStorage - systemReserved);
    }

    if (availableResult) {
      availableStorage = availableResult.availableStorage;
      stats.storage = formatFileSize(availableStorage);
    }

    const comicsSizeResults = await Promise.all(
      comics.map((comic, index) => {
        return new Promise((resolve) => {
          // 有元数据：直接使用，不再扫描目录
          if (typeof comic.size === "number") {
            this.applyComicMeta(comic);
            const length = comic.size;
            comic.size = formatFileSize(length);
            resolve({ index, length });
            return;
          }
          file.get({
            uri: `internal://files/${comic.id}`,
            recursive: true,
            success: (data) => {
              let length = 0;
              const scannedChapters = [];
              for (const i of data.subFiles) {
                if (i.type === "dir" && i.subFiles.length !== 0) {
                  if (!comic.totalChapter) {
                    comic.totalChapter = [];
                  }
                  const folderName = i.uri.split("/").pop();
                  const parts = folderName.split("　");
                  const chapterNum = parts[0];
                  const chapterName = parts.slice(1).join("　");
                  comic.totalChapter.push([chapterName, i.subFiles.length, chapterNum]);
                  const num = parseInt(chapterNum);
                  // 导入漫画的章节目录不带数字前缀，跳过（保留导入时写入的元数据）
                  if (!isNaN(num)) {
                    scannedChapters.push({
                      num: num,
                      name: chapterName,
                      downloaded: i.subFiles.length,
                    });
                  }
                  for (const m of i.subFiles) {
                    length += m.length;
                  }
                } else if (i.type !== "dir") {
                  length += i.length;
                }
              }
              if (!comic.is_serial) {
                // 单本：根目录文件含封面，页数减一
                const fileCount = data.subFiles.filter((f) => f.type !== "dir").length;
                scannedChapters.push({ num: 0, name: "", downloaded: Math.max(0, fileCount - 1) });
              }
              if (comic.totalChapter) {
                comic.totalChapter.sort((a, b) => a[2] - b[2]);
              }
              comic.size = formatFileSize(length);
              this.backfillComicMeta(comic, length, scannedChapters);
              resolve({ index, length });
            },
            fail: (data, code) => {
              console.debug(`获取漫画大小失败, code = ${code}`);
              resolve({ index, length: 0 });
            },
          });
        });
      })
    );

    const comicsTotalSize = comicsSizeResults.reduce((sum, r) => sum + r.length, 0);

    if (totalStorage > 0) {
      const systemReserved = global.getReservedSpace(totalStorage);
      const actualTotal = totalStorage - systemReserved;
      const actualAvailable = Math.max(0, availableStorage - systemReserved);
      stats.comicsUsed = formatFileSize(comicsTotalSize);
      // 统一基于 totalStorage 计算百分比，确保进度条显示正确
      stats.comicsUsedPercent = Math.floor((comicsTotalSize / totalStorage) * 100);
      stats.storageUsed = formatFileSize(actualTotal - actualAvailable);
      stats.actualUsedPercent = Math.floor(((actualTotal - actualAvailable) / totalStorage) * 100);
      stats.otherUsed = formatFileSize(Math.max(0, actualTotal - actualAvailable - comicsTotalSize));
      stats.remaining = formatFileSize(actualAvailable);
      stats.systemReservedPercent = Math.floor((systemReserved / totalStorage) * 100);
    }

    return stats;
  },

  // 未完成判断：任一章 downloaded < page_count，或连载已下载章数 < 作品总章数
  // 无元数据（旧数据）视为完整，首次扫描回写后下次即可判断
  isComicIncomplete(comic) {
    if (!comic || !Array.isArray(comic.chapters) || comic.chapters.length === 0) {
      return false;
    }
    if (comic.is_serial && comic.total_chapters && comic.chapters.length < comic.total_chapters) {
      return true;
    }
    return comic.chapters.some((c) => (c.downloaded || 0) < (c.page_count || 0));
  },

  // 从元数据构建章节列表（与扫描产生的 totalChapter 格式一致：[名称, 可读页数, 章节号]）
  applyComicMeta(comic) {
    if (comic.is_serial && Array.isArray(comic.chapters) && comic.chapters.length > 0) {
      comic.totalChapter = comic.chapters
        .slice()
        .sort((a, b) => a.num - b.num)
        .map((c) => [c.name, c.downloaded != null ? c.downloaded : c.page_count || 0, c.num]);
    }
  },

  // 无元数据的漫画（旧数据/下载中断）扫描后回写，下次进页面免扫描
  backfillComicMeta(comic, length, scannedChapters) {
    updateComicMeta(comic.id, (record) => {
      const prev = Array.isArray(record.chapters) ? record.chapters : [];
      record.chapters = scannedChapters.map((sc) => {
        const p = prev.find((c) => c.num === sc.num);
        return {
          num: sc.num,
          name: sc.name || (p ? p.name : ""),
          // 已登记过 API 页数则保留（下载中断时 downloaded < page_count 即为未完成）
          page_count: p && p.page_count ? p.page_count : sc.downloaded,
          downloaded: sc.downloaded,
        };
      });
      // 保留已登记但扫描不到的章节（如刚下载中断、目录未建）
      prev.forEach((c) => {
        if (!record.chapters.find((m) => m.num === c.num)) {
          record.chapters.push(c);
        }
      });
      record.chapters.sort((a, b) => a.num - b.num);
      record.size = length;
      return record;
    }).catch((e) => {
      console.debug(`元数据回写失败: ${e && e.code}`);
    });
  },

  toPhoto(val) {
    router.push({
      uri: "/pages/photo",
      params: serializeParams({
        id: val.id,
        page_count: val.page_count,
        is_serial: val.is_serial ? 1 : "",
        downloadChapter: val.totalChapter,
        local: true,
      }),
    });
  },

  del(id) {
    if (del !== id) {
      // 第一次点击，提示二次确认
      del = id;
      prompt.showToast({
        message: this.$t("offline.del"),
        duration: 2000,
      });
      // 3秒后重置
      setTimeout(() => {
        if (del === id) {
          del = null;
        }
      }, 3000);
      return;
    }
    // 第二次点击，执行删除
    del = null;
    prompt.showToast({
      message: this.$t("offline.secondDel"),
      duration: 1000,
    });

    const folderUri = "internal://files/" + id + "/";

    file.access({
      uri: folderUri,
      success: () => {
        file.rmdir({
          uri: folderUri,
          recursive: true,
          success: () => {
            this.updateComicsIndex(id);
          },
          fail: (data, code) => {
            console.debug(`递归删除失败(code=${code})，尝试逐文件删除`);
            this.deleteFilesOneByOne(id, folderUri);
          },
        });
      },
      fail: () => {
        console.debug(`文件夹不存在，直接删除索引`);
        this.updateComicsIndex(id);
      },
    });
  },

  deleteFilesOneByOne(id, folderUri) {
    file.get({
      uri: folderUri,
      recursive: true,
      success: (data) => {
        const allFiles = [];
        const flatten = (entries) => {
          for (const entry of entries) {
            if (entry.type === "dir" && entry.subFiles && entry.subFiles.length) {
              flatten(entry.subFiles);
            } else if (entry.type !== "dir") {
              allFiles.push(entry.uri);
            }
          }
        };
        flatten(data.subFiles || []);

        const deleteNext = (index) => {
          if (index >= allFiles.length) {
            file.rmdir({
              uri: folderUri,
              recursive: true,
              success: () => {
                this.updateComicsIndex(id);
              },
              fail: () => {
                console.debug(`清理空目录失败，直接更新索引`);
                this.updateComicsIndex(id);
              },
            });
            return;
          }

          file.delete({
            uri: allFiles[index],
            success: () => {
              deleteNext(index + 1);
            },
            fail: (data, code) => {
              console.debug(`删除文件失败: ${allFiles[index]}, code=${code}`);
              deleteNext(index + 1);
            },
          });
        };

        deleteNext(0);
      },
      fail: (data, code) => {
        console.debug(`列出文件失败, code=${code}，直接更新索引`);
        this.updateComicsIndex(id);
      },
    });
  },

  updateComicsIndex(id) {
    const onError = (err) => {
      if (err.parseError) {
        console.debug(`解析comics.json失败: ${err.parseError}`);
        prompt.showToast({
          message: this.$t("offline.indexReadFailed"),
          duration: 2000,
        });
      } else {
        console.debug(`读取comics.json失败, code = ${err.code}`);
        prompt.showToast({
          message: this.$t("offline.indexNotExist"),
          duration: 2000,
        });
      }
      this.loadingComic();
    };

    readComics(true).then(
      (comicsData) => {
        const existingIndex = comicsData.findIndex(
          (comic) => comic.id === id
        );

        if (existingIndex !== -1) {
          comicsData.splice(existingIndex, 1);
        }

        writeComics(comicsData).then(
          () => {
            console.debug("comics.json更新成功");
            prompt.showToast({
              message: this.$t("offline.delComplete"),
              duration: 1000,
            });
            this.loadingComic();
          },
          ({ code }) => {
            console.debug(`写入comics.json失败, code = ${code}`);
            prompt.showToast({
              message: this.$t("offline.indexUpdateFailed"),
              duration: 2000,
            });
            this.loadingComic();
          }
        );
      },
      onError
    );
  },

  toggleStorageList() {
    this.storageListExpanded = !this.storageListExpanded;
  },

  routeBack() {
    router.back();
  },

  onBackPress () {
      return true;
  },
};
</script>

