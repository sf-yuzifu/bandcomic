<template>
  <div class="boot-page">
    <image static class="logo" src="/common/logo.png"></image>
    <text static class="appName">{{ $t("appName") }}</text>
    <text static class="loading">{{ $t("boot.loading") }}</text>
  </div>
</template>

<script>
import router from "@system.router";

// 共享模块统一挂 global（见 app.ux）
const { bootstrapAppData } = global.$boot;

export default {
  private: {
    destroyed: false,
  },

  onBackPress() {
    return true;
  },

  onInit() {
    this.destroyed = false;
    bootstrapAppData().then((result) => {
      if (this.destroyed) return;
      if (result && result.skipOobe) {
        router.replace({ uri: "/pages/index" });
        return;
      }
      global.__oobeMode = "firstRun";
      router.replace({ uri: "/pages/oobe" });
    });
  },

  onDestroy() {
    this.destroyed = true;
  },
};
</script>

<style>
.boot-page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}

.appName {
  margin-top: 16px;
  font-size: 28px;
  color: #fff;
  font-weight: bold;
}

.loading {
  margin-top: 10px;
  font-size: 22px;
  color: rgba(255, 255, 255, 0.55);
  font-weight: bold;
}
</style>
