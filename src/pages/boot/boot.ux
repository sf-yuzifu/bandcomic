<template>
  <div class="boot-page">
    <image static class="logo" src="/common/logo.png"></image>
    <text static class="appName">{{ $t("appName") }}</text>
    <text static class="loading">{{ $t("boot.loading") }}</text>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";

// 共享模块统一挂 global（见 app.ux）
const { bootstrapAppData } = global.$boot;
const { setRecoveryNotifier } = global.$storage;

// 启动读盘超时兜底（P0-12）：正常读盘毫秒级完成，超时说明固件回调挂起
const BOOT_TIMEOUT_MS = 10000;
// 定时器句柄与完成标志放模块级（photo.ux brightTimer 同款，不进响应式）
let bootTimer = 0;
let bootSettled = false;

export default {
  private: {
    destroyed: false,
  },

  onBackPress() {
    return true;
  },

  onInit() {
    this.destroyed = false;
    bootSettled = false;
    // 损坏 JSON 自愈通知器（P0-15）：页面注入 $t 译文（confirmGuard 同款），
    // 先于 bootstrap 注册——启动期 settings/sources/cookie 损坏即提示
    setRecoveryNotifier((name) => {
      prompt.showToast({
        message: this.$t("storage.fileRecovered", { name }),
        duration: 3000,
      });
    });
    if (bootTimer) {
      clearTimeout(bootTimer);
      bootTimer = 0;
    }
    bootTimer = setTimeout(() => {
      bootTimer = 0;
      // 超时兜底（P0-12）：读盘未归无法确认"什么都没设置"→进首页 + 提示
      this.finishBoot(true, true);
    }, BOOT_TIMEOUT_MS);
    bootstrapAppData().then(
      (result) => {
        if (bootSettled || this.destroyed) return;
        this.finishBoot(!!(result && result.failed), !!(result && result.skipOobe));
      },
      () => {
        // bootstrap 内部已 try/catch 不拒载；万一仍拒按"有数据进首页"降级（P0-12）——
        // 无法确认"真什么都没设置"时不进 OOBE
        if (bootSettled || this.destroyed) return;
        this.finishBoot(true, true);
      }
    );
  },

  // 路由收口（P0-12）：partial=数据未完整加载需提示；skipOobe=进首页，否则进引导
  finishBoot(partial, skipOobe) {
    bootSettled = true;
    if (bootTimer) {
      clearTimeout(bootTimer);
      bootTimer = 0;
    }
    if (partial) {
      prompt.showToast({
        message: this.$t("boot.loadPartial"),
        duration: 2000,
      });
    }
    if (skipOobe) {
      router.replace({ uri: "/pages/index" });
      return;
    }
    router.replace({ uri: "/pages/oobe", params: { mode: "firstRun" } });
  },

  onDestroy() {
    this.destroyed = true;
    if (bootTimer) {
      clearTimeout(bootTimer);
      bootTimer = 0;
    }
  },
};
</script>

<style>
.boot-page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000;
}

.appName {
  margin-top: 16px;
  font-size: 28px;
  color: #fff;
  font-weight: bold;
}

.loading {
  margin-top: 10px;
  font-size: 22px;
  color: rgba(255, 255, 255, 0.55);
  font-weight: bold;
}
</style>
