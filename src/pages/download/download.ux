<template>
  <div class="container">
    <div
      id="mask"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && !downloadError }}"
    >
      <image
        style="top: 300px; width: 926px; height: 926px"
        src="/common/{{ processing ? 'success':'dling' }}_s4.png"
      ></image>
    </div>
    <div id="mask" if="{{ !showChapterSelect && global.screenShape == 'circle' && downloadError }}">
      <image
        static
        style="top: 300px; width: 926px; height: 926px"
        src="/common/fail_s4.png"
      ></image>
    </div>

    <text class="time">{{ time }}</text>

    <div class="title" style="justify-content: center">
      <text
        class="iconfont"
        style="margin-right: 10px"
        if.static="{{ global.screenShape == 'circle' }}"
      >
        &#xe685;
      </text>
      <marquee
        scrollamount="{{ 20 }}"
        text-offset="{{ 20 }}"
        style="font-size: 32px; font-weight: bold; text-align: center"
        @click="
          () => {
            if (global.screenShape == 'circle') {
              routeBack();
            }
          }
        "
      >
        {{ $t("download.title") }}{{ queuePosition }}{{ chapterName ? " - " + chapterName : "" }}
      </marquee>
    </div>

    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />

    <!-- 章节选择界面 -->
    <div class="chapter-select" if="{{ showChapterSelect && !downloadError }}">
      <div style="width: 100%; height: 100%">
        <scroll
          id="chapterScroll"
          scroll-y="true"
          class="chapter-list"
          bounces="true"
          onscrolltop="onScrollTop"
          onscrollbottom="onScrollBottom"
        >
          <div
            for="{{ chapter in chapterList.slice(displayStart, displayEnd) }}"
            class="chapter-item {{ chapter.selected ? 'selected' : '' }} {{ chapter.dlState }}"
            @click="toggleChapter(chapter.num)"
          >
            <text static class="chapter-text">{{ $t("photo.chapter") }}</text>
            <text class="chapter-text">{{ chapter.num }}</text>
          </div>
        </scroll>
      </div>
      <div class="select-buttons">
        <div class="button" @click="selectAll">
          <text class="select-text">
            {{
              selectedChapters.length == total_chapters
                ? $t("download.deselectAll")
                : $t("download.selectAll")
            }}
          </text>
        </div>
        <div class="button" @click="startBatchDownload">
          <text class="select-text">
            {{ $t("download.startDownload") }}({{ selectedChapters.length }})
          </text>
        </div>
      </div>
    </div>

    <!-- 方形手表下载界面 -->
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape != 'circle' && !downloadError }}"
    >
      <image src="/common/{{ processing ? 'success':'dling' }}.png"></image>
      <text class="dl-text">
        {{ processing ? $t("download.complete") : $t("download.downloading") }}
      </text>
    </div>
    <div
      id="process"
      if="{{ !showChapterSelect && global.screenShape != 'circle' && !downloadError }}"
    >
      <text class="content">
        {{ $t("download.page", { page: page, total_page: page_count }) }}
      </text>
      <text class="per">{{ page_count > 0 ? Math.floor((page / page_count) * 100) : 0 }}%</text>
    </div>
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape != 'circle' && downloadError }}"
    >
      <image static src="/common/fail.png"></image>
      <text class="dl-text">{{ downloadError }}</text>
    </div>

    <!-- 圆形手表下载界面 -->
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && !downloadError }}"
    >
      <text class="dl-text">
        {{ processing ? $t("download.complete") : $t("download.downloading") }}
      </text>
      <image src="/common/{{ processing ? 'success':'dl' }}_icon.png"></image>
    </div>
    <div
      id="process"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && !downloadError }}"
    >
      <text class="content">
        {{ $t("download.page", { page: page, total_page: page_count }) }}
      </text>
      <text class="per">{{ page_count > 0 ? Math.floor((page / page_count) * 100) : 0 }}%</text>
    </div>
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && downloadError }}"
    >
      <text static class="dl-text">{{ $t("download.downloadFailed") }}</text>
      <image static src="/common/fail_icon.png"></image>
    </div>
    <div
      id="process-s4"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && downloadError }}"
    >
      <text class="content">{{ downloadError }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import file from "@system.file";
import prompt from "@system.prompt";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { addImageParams, addCoverParams, appendCoverSuffix, appendLvglSuffix } = global.$img;
const { updateComicMeta, isAlreadyExistsError, readComics } = global.$storage;
const { apiFetch, buildPhotoUrl, getCurrentSource, FETCH_ERROR, getHttpStatus, isHttpSuccess } = global.$api;
const { isValidImageFile, deleteImageTemp } = global.$imageFile;

const { getTime } = global;

const MAX_RETRY = 3;
// 失败页数超过该阈值视为网络/服务器整体故障
const MAX_FAILED_TOLERANCE = 3;

const CHAPTER_WINDOW = 18;
const DOWNLOAD_ABORTED = new Error("download aborted");

function sanitizeFolderName(name) {
  if (!name) return name;
  const invalidChars = /[\\/:*?"<>|]/g;
  return name.replace(invalidChars, "_");
}

// 章节本地下载状态：完整下载 → "dl-full"；本地有页但不完整 → "dl-partial"；
// 无记录或 0 页 → ""（无标记）。page_count 缺失的旧数据有页即视为完整
function getChapterDlState(entry) {
  if (!entry || !entry.downloaded) return "";
  if (!entry.page_count || entry.downloaded >= entry.page_count) return "dl-full";
  return "dl-partial";
}

export default {
  private: {
    time: "",
    id: 0,
    page_count: 0,
    page: 0,
    processing: false,
    chapter: 0,
    downloadError: "",
    showChapterSelect: false,
    chapterList: [],
    selectedChapters: [],
    total_chapters: 0,
    chapterName: "",
    displayStart: 0,
    displayEnd: 18,
    queuePosition: "",
  },

  onShow() {
    this.time = getTime();
  },

  onDestroy() {
    this.cancelDownload();
  },

  onBackPress() {
    this.cancelDownload();
    return false;
  },

  cancelDownload() {
    this.destroyed = true;
    const state = this._downloadState;
    if (!state) return;
    // 同时结束页面的等待 Promise：底层取消排队任务时可能不再调用 success/fail。
    const pending = state.pending.splice(0);
    pending.forEach((cancel) => cancel());
    state.imageCache = [];
    state.failedChapters = [];
  },

  async onInit() {
    this.cancelDownload();
    this.destroyed = false;
    // 不放 private，避免图片列表的响应式开销；每个实例拥有独立的运行状态。
    // 异步链捕获 state 身份，实例重新初始化后旧链也不能继续。
    const state = (this._downloadState = {
      comicId: global.API_SETTING.using + "_" + this.id,
      originalName: this.name,
      imageCache: [],
      failedChapters: [],
      coverDone: false,
      retryNotified: false,
      currentChapterIndex: 0,
      loadingMore: false,
      scrollTopTriggered: false,
      scrollBottomTriggered: false,
      pending: [],
      storageDirty: false,
    });
    this.showChapterSelect = this.total_chapters > 1;
    await this.initData();
    if (!this.isDownloadActive(state)) return;
    if (!(this.is_serial && this.total_chapters > 1)) {
      // 错误已在 startDownloadProcess 内反映到 downloadError UI
      this.startDownloadProcess(state).catch(() => {});
    }
  },

  isDownloadActive(state) {
    return !this.destroyed && !!state && state === this._downloadState;
  },

  checkDownloadActive(state) {
    if (!this.isDownloadActive(state)) throw DOWNLOAD_ABORTED;
  },

  // 统一登记等待操作，退出时立即 reject 并尝试底层取消。原生 IO 无法撤回，
  // 迟到回调仍需守卫；它只能完成自己的操作，不能推进下载或修改新实例。
  downloadOperation(start, state) {
    return new Promise((resolve, reject) => {
      if (!this.isDownloadActive(state)) {
        reject(DOWNLOAD_ABORTED);
        return;
      }
      let settled = false;
      let cancelNative;
      const finish = (callback, value) => {
        if (settled) return;
        settled = true;
        const index = state.pending.indexOf(cancel);
        if (index !== -1) state.pending.splice(index, 1);
        if (this.isDownloadActive(state)) callback(value);
        else reject(DOWNLOAD_ABORTED);
      };
      const cancel = () => {
        finish(reject, DOWNLOAD_ABORTED);
        if (cancelNative) {
          try {
            cancelNative();
          } catch (e) {}
        }
      };
      state.pending.push(cancel);
      try {
        cancelNative = start(
          (value) => finish(resolve, value),
          (error) => finish(reject, error)
        );
      } catch (e) {
        finish(reject, e);
      }
    });
  },

  waitForDownload(ms, state) {
    return this.downloadOperation((resolve) => {
      const timer = setTimeout(resolve, ms);
      return () => clearTimeout(timer);
    }, state);
  },

  requestDownload(options, state) {
    return this.downloadOperation((resolve, reject) => {
      const task = apiFetch({
        ...options,
        success: (response) => {
          if (!this.isDownloadActive(state) && options.responseType === "file") {
            deleteImageTemp(response && response.data);
          }
          if (this.isDownloadActive(state) && !isHttpSuccess(response)) {
            if (options.responseType === "file") deleteImageTemp(response && response.data);
            const code = getHttpStatus(response) || 0;
            reject({ code: code, data: "HTTP " + code });
            return;
          }
          resolve(response);
        },
        fail: (data, code) => reject({ data: data, code: code }),
      });
      return task && typeof task.cancel === "function" ? () => task.cancel() : null;
    }, state);
  },

  async initData() {
    this.is_serial = this.total_chapters > 1;
    this.displayStart = 0;
    this.displayEnd = Math.min(CHAPTER_WINDOW, this.total_chapters);
    if (this.is_serial) {
      // 先同步渲染章节网格，已下载标记异步补齐，进页不被 IO 阻塞
      this.chapterList = [];
      for (let i = 1; i <= this.total_chapters; i++) {
        this.chapterList.push({
          num: i,
          selected: false,
          dlState: "",
        });
      }
      this.markDownloadedChapters();
    }
  },

  // 异步标记各章本地下载状态，让用户分辨哪些章已下载过。
  // 已下页数以磁盘实际文件为准（下载中途退出时元数据 downloaded 滞后，
  // syncComicStorageMeta 要等队列完整结束后才回写）；总页数取元数据登记的 API 页数。
  // 两个 IO 无依赖，并行发起
  async markDownloadedChapters() {
    const state = this._downloadState;
    const comicId = state.comicId;
    const results = await Promise.all([
      readComics().catch(() => []),
      this.scanLocalChapterPages(comicId),
    ]);
    // 页面已销毁（IO 期间退出）则不再 patch
    if (!this.isDownloadActive(state)) return;
    const comics = results[0];
    const scannedPages = results[1];
    const comic = (Array.isArray(comics) ? comics : []).find((c) => c.id === comicId);
    const pageCountMap = {};
    ((comic && comic.chapters) || []).forEach((c) => {
      pageCountMap[c.num] = c.page_count || 0;
    });
    // 一次性整体替换触发一次渲染；用户已勾选的 selected 状态保留
    this.chapterList = this.chapterList.map((item) => ({
      ...item,
      dlState: getChapterDlState({
        downloaded: scannedPages[item.num] || 0,
        page_count: pageCountMap[item.num] || 0,
      }),
    }));
  },

  // 扫描本漫磁盘目录，返回 { 章节号: 实际页数 }；目录不存在/扫描失败回空对象
  scanLocalChapterPages(comicId) {
    return new Promise((resolve) => {
      file.get({
        uri: `internal://files/${comicId}`,
        recursive: true,
        success: (data) => {
          const pages = {};
          (data.subFiles || []).forEach((item) => {
            if (item.type !== "dir") return;
            const num = parseInt(item.uri.split("/").pop().split("　")[0], 10);
            if (!isNaN(num)) {
              pages[num] = (item.subFiles || []).length;
            }
          });
          resolve(pages);
        },
        fail: () => resolve({}),
      });
    });
  },

  toggleChapter(chapterNum) {
    const index = this.selectedChapters.indexOf(chapterNum);
    if (index === -1) {
      this.selectedChapters.push(chapterNum);
    } else {
      this.selectedChapters.splice(index, 1);
    }
    for (let i = 0; i < this.chapterList.length; i++) {
      if (this.chapterList[i].num === chapterNum) {
        this.chapterList[i].selected = !this.chapterList[i].selected;
        break;
      }
    }
  },

  selectAll() {
    if (this.selectedChapters.length == this.total_chapters) {
      this.selectedChapters = [];
      for (let i = 0; i < this.chapterList.length; i++) {
        this.chapterList[i].selected = false;
      }
    } else {
      this.selectedChapters = [];
      for (let i = 1; i <= this.total_chapters; i++) {
        this.selectedChapters.push(i);
      }
      for (let i = 0; i < this.chapterList.length; i++) {
        this.chapterList[i].selected = true;
      }
    }
  },

  onScrollTop() {
    const state = this._downloadState;
    if (!this.isDownloadActive(state)) return;
    if (this.displayStart === 0 || state.loadingMore) {
      state.scrollTopTriggered = false;
      return;
    }
    if (!state.scrollTopTriggered) {
      state.scrollTopTriggered = true;
      return;
    }
    state.scrollTopTriggered = false;
    state.scrollBottomTriggered = false;
    state.loadingMore = true;
    this.displayStart = Math.max(0, this.displayStart - CHAPTER_WINDOW);
    // 窗口长度恒 min(CHAPTER_WINDOW, total)：首窗不满时向尾部取满，保证可滚动
    this.displayEnd = Math.min(this.displayStart + CHAPTER_WINDOW, this.total_chapters);
    state.loadingMore = false;
  },

  onScrollBottom() {
    const state = this._downloadState;
    if (!this.isDownloadActive(state)) return;
    if (this.displayEnd >= this.total_chapters || state.loadingMore) {
      state.scrollBottomTriggered = false;
      return;
    }
    if (!state.scrollBottomTriggered) {
      state.scrollBottomTriggered = true;
      return;
    }
    state.scrollTopTriggered = false;
    state.scrollBottomTriggered = false;
    state.loadingMore = true;
    this.displayEnd = Math.min(this.displayEnd + CHAPTER_WINDOW, this.total_chapters);
    // 末窗不足一页时向前回填取满，保证窗口内容始终超高可滚动回翻
    this.displayStart = Math.max(0, this.displayEnd - CHAPTER_WINDOW);
    state.loadingMore = false;
  },

  async startBatchDownload() {
    const state = this._downloadState;
    if (!this.isDownloadActive(state) || !this.showChapterSelect) return;
    if (this.selectedChapters.length === 0) {
      prompt.showToast({
        message: this.$t("download.selectAtLeastOne"),
        duration: 2000,
      });
      return;
    }
    this.showChapterSelect = false;
    state.failedChapters = [];
    state.coverDone = false;
    this.queuePosition = "";
    state.currentChapterIndex = 0;
    try {
      await this.downloadNextChapter(state);
    } catch (e) {
      if (this.isDownloadActive(state)) throw e;
    }
  },

  async downloadNextChapter(state = this._downloadState) {
    if (!this.isDownloadActive(state)) return;
    if (state.currentChapterIndex >= this.selectedChapters.length) {
      // 队列结束，回写一次真实存储元数据（含失败章节的实际已下载页数）
      await this.syncComicStorageMeta(state);
      if (!this.isDownloadActive(state)) return;
      // 整批下载结束，清掉大对象后主动收一次 GC
      state.imageCache = [];
      if (typeof global !== "undefined" && global.runGC) global.runGC();
      if (state.failedChapters.length === 0) {
        this.processing = true;
        prompt.showToast({
          message: this.$t("download.allComplete"),
          duration: 2000,
        });
        await this.waitForDownload(1000, state);
        if (!this.isDownloadActive(state)) return;
        router.replace({
          uri: "/pages/offline",
        });
      } else {
        this.showSummaryView(state);
      }
      return;
    }

    this.chapter = this.selectedChapters[state.currentChapterIndex];
    this.queuePosition = "(" + (state.currentChapterIndex + 1) + "/" + this.selectedChapters.length + ")";
    this.chapterName = "";
    this.processing = false;
    this.page = 0;
    // 切章间隙重置总数：fetchImageList 返回前不残留上一章的 page_count，
    // 避免进度条短暂显示 "0/旧N" 的失真百分比
    this.page_count = 0;
    this.downloadError = "";

    try {
      await this.startDownloadProcess(state);
    } catch (error) {
      if (!this.isDownloadActive(state)) return;
      console.error(`章节 ${this.chapter} 下载失败:`, error);
      state.failedChapters.push(this.chapter);
      // 队列模式不用整屏错误 UI，toast 提示原因后继续下一章
      this.downloadError = "";
      const reason = typeof error === "string" ? error : String(error);
      prompt.showToast({
        message: this.$t("download.chapterFailed", { chapter: this.chapter, reason: reason }),
        duration: 2500,
      });
      await this.waitForDownload(500, state);
    }

    if (!this.isDownloadActive(state)) return;
    state.currentChapterIndex++;
    await this.waitForDownload(500, state);
    await this.downloadNextChapter(state);
  },

  showSummaryView(state = this._downloadState) {
    if (!this.isDownloadActive(state)) return;
    this.queuePosition = "";
    // 复用原本的失败 UI：fail 图标 + downloadError 文案，用户自行返回
    if (state.failedChapters.length === this.selectedChapters.length) {
      this.downloadError = this.$t("download.allFailed");
    } else {
      this.downloadError = this.$t("download.summaryWithFailed", {
        success: this.selectedChapters.length - state.failedChapters.length,
        total: this.selectedChapters.length,
        chapters: state.failedChapters.join("、"),
      });
    }
  },

  async startDownloadProcess(state = this._downloadState) {
    try {
      this.checkDownloadActive(state);
      await this.ensureComicRegistered(state);
      this.checkDownloadActive(state);
      await this.createFolderAndDownload(state);
    } catch (error) {
      if (!this.isDownloadActive(state)) return;
      console.debug(`下载过程出错: ${error}`);
      this.downloadError = error;
      this.processing = false;
      throw error;
    }
  },

  // 把漫画登记进 comics.json（串行队列内读-改-写 + 原子落盘）：
  // 已存在则合并（保留 chapters/size/downloaded_at 等元数据），不存在则新建
  ensureComicRegistered(state = this._downloadState) {
    this.checkDownloadActive(state);
    const newComic = {
      name: this.is_serial ? state.originalName : this.name,
      page_count: this.page_count,
      id: state.comicId,
      is_serial: this.is_serial,
    };
    return updateComicMeta(newComic.id, (comic) => {
      // updater 在存储队列中延后执行；退出后不得再写索引。
      this.checkDownloadActive(state);
      return {
        ...comic,
        ...newComic,
        // 连载每章登记时页数重置为 0，真实页数由 syncChapterMeta 登记。
        page_count: newComic.page_count || comic.page_count || 0,
      };
    }).catch((e) => {
      this.checkDownloadActive(state);
      if (e && e.parseError) {
        throw this.$t("download.parseIndexFailed");
      }
      throw this.$t("download.writeIndexFailed", { code: e && e.code });
    });
  },

  async createFolderAndDownload(state = this._downloadState) {
    try {
      this.checkDownloadActive(state);
      this.processing = false;
      this.page = 0;
      this.downloadError = "";
      state.retryNotified = false;

      let folderUri;
      let coverUri;

      await this.fetchImageList(0, state);
      this.checkDownloadActive(state);

      // 先把当前章节登记进元数据，下载中断时离线页可据此判断未完成
      await this.syncChapterMeta(state);
      this.checkDownloadActive(state);

      if (this.is_serial) {
        const mainFolderUri = `internal://files/${state.comicId}`;
        await this.createFolder(mainFolderUri, state);
        this.checkDownloadActive(state);
        const chapterName = sanitizeFolderName(this.chapterName || this.name);
        folderUri = `${mainFolderUri}/${this.chapter}　${chapterName}`;
        coverUri = mainFolderUri;
      } else {
        folderUri = `internal://files/${state.comicId}`;
        coverUri = folderUri;
      }
      await this.createFolder(folderUri, state);
      this.checkDownloadActive(state);

      // 封面失败不判整本失败（P1-17②）：与连载对称降级——单本 toast 警告后继续
      // 下正文（书架封面 empty.png 兜底），连载静默吞、下一章还会重试
      if (!state.coverDone) {
        try {
          await this.downloadCover(coverUri, 0, state);
          this.checkDownloadActive(state);
          state.coverDone = true;
        } catch (e) {
          this.checkDownloadActive(state);
          console.debug(`封面下载失败: ${e}`);
          if (!this.is_serial) {
            prompt.showToast({ message: String(e), duration: 2000 });
          }
        }
      }

      await this.downloadPages(folderUri, state);
      this.checkDownloadActive(state);

      if (!this.is_serial) {
        await this.syncComicStorageMeta(state);
        this.checkDownloadActive(state);
        // 整本下载完成，图片列表等大对象不再使用，主动收一次 GC
        state.imageCache = [];
        if (typeof global !== "undefined" && global.runGC) global.runGC();
        this.processing = true;
        prompt.showToast({
          message: this.$t("download.complete"),
          duration: 2000,
        });

        await this.waitForDownload(1000, state);
        this.checkDownloadActive(state);
        router.replace({
          uri: "/pages/offline",
        });
      }
    } catch (error) {
      if (!this.isDownloadActive(state)) return;
      // 清掉旧坏页后即使补下载失败，也回写真实数量，避免继续保留“全部下载”的旧统计。
      if (state.storageDirty) {
        await this.syncComicStorageMeta(state);
        if (!this.isDownloadActive(state)) return;
        state.storageDirty = false;
      }
      console.error("下载过程出错:", error);
      this.downloadError = error;
      this.processing = false;
      throw error;
    }
  },

  // 按顺序逐页下载：手环设备性能有限，并发请求只会更卡；
  // 个别页失败先记账不中断，其余页下完后串行补一次，仍失败才抛出；
  // 失败页数超过阈值视为网络/服务器整体故障，直接抛首个错误不再补
  async downloadPages(folderUri, state = this._downloadState) {
    let completed = 0;
    const failedPages = [];

    for (let p = 1; p <= this.page_count; p++) {
      this.checkDownloadActive(state);
      try {
        await this.downloadPage(p, folderUri, 0, state);
        this.checkDownloadActive(state);
        this.page = ++completed;
      } catch (e) {
        this.checkDownloadActive(state);
        failedPages.push({ page: p, error: e });
      }
    }

    this.checkDownloadActive(state);
    if (failedPages.length === 0) {
      return;
    }
    if (failedPages.length > MAX_FAILED_TOLERANCE) {
      throw failedPages[0].error;
    }
    prompt.showToast({
      message: this.$t("download.retryFailedPages", { count: failedPages.length }),
      duration: 2000,
    });
    for (const item of failedPages) {
      this.checkDownloadActive(state);
      // 补拉沿用已耗尽的重试配额（P1-17③）：只再试一次，仍失败才抛出——
      // 不再从 0 重计又获得 3 次重试，与"串行补一次"注释语义一致
      await this.downloadPage(item.page, folderUri, MAX_RETRY, state);
      this.checkDownloadActive(state);
      this.page = ++completed;
    }
  },

  // 把当前章节登记到 comics.json 元数据（下载前调用，downloaded 保留旧值）
  syncChapterMeta(state = this._downloadState) {
    this.checkDownloadActive(state);
    const comicId = state.comicId;
    const chapterNum = this.is_serial ? this.chapter : 0;
    // 章节元数据名与创建物理目录使用同一规范化结果（P1-31），杜绝中断后元数据与磁盘目录不一致
    const chapterName = this.is_serial
      ? sanitizeFolderName(this.chapterName || this.name)
      : "";
    const pageCount = this.page_count;
    return updateComicMeta(comicId, (comic) => {
      this.checkDownloadActive(state);
      comic.name = this.is_serial ? state.originalName : this.name;
      comic.is_serial = this.is_serial;
      if (this.is_serial) {
        if (this.total_chapters) {
          comic.total_chapters = this.total_chapters;
        }
      } else {
        comic.page_count = pageCount;
      }
      if (!Array.isArray(comic.chapters)) {
        comic.chapters = [];
      }
      const idx = comic.chapters.findIndex((c) => c.num === chapterNum);
      const prevDownloaded = idx >= 0 ? comic.chapters[idx].downloaded || 0 : 0;
      const entry = {
        num: chapterNum,
        name: chapterName,
        page_count: pageCount,
        downloaded: prevDownloaded,
      };
      if (idx >= 0) {
        comic.chapters[idx] = entry;
      } else {
        comic.chapters.push(entry);
      }
      return comic;
    }).catch((e) => {
      this.checkDownloadActive(state);
      console.debug(`章节元数据登记失败: ${e && e.code}`);
    });
  },

  // 下载结束后扫描一次目录，回写真实占用大小和各章已下载页数
  syncComicStorageMeta(state = this._downloadState) {
    this.checkDownloadActive(state);
    const comicId = state.comicId;
    const folderUri = `internal://files/${comicId}`;
    return this.downloadOperation((resolve, reject) => {
      file.get({
        uri: folderUri,
        recursive: true,
        success: (data) => {
          if (!this.isDownloadActive(state)) {
            reject(DOWNLOAD_ABORTED);
            return;
          }
          const subFiles = data.subFiles || [];
          updateComicMeta(comicId, (comic) => {
            this.checkDownloadActive(state);
            let size = 0;
            const scanned = [];
            if (this.is_serial) {
              for (const item of subFiles) {
                if (item.type === "dir") {
                  let len = 0;
                  for (const f of item.subFiles || []) {
                    len += f.length;
                  }
                  size += len;
                  const parts = item.uri.split("/").pop().split("　");
                  scanned.push({
                    num: parseInt(parts[0], 10),
                    name: parts.slice(1).join("　"),
                    downloaded: (item.subFiles || []).length,
                  });
                } else {
                  size += item.length;
                }
              }
            } else {
              let pages = 0;
              for (const item of subFiles) {
                if (item.type !== "dir") {
                  size += item.length;
                  pages++;
                }
              }
              // 根目录文件含封面，页数减一
              scanned.push({ num: 0, name: "", downloaded: Math.max(0, pages - 1) });
            }
            const prev = Array.isArray(comic.chapters) ? comic.chapters : [];
            const merged = scanned.map((sc) => {
              const p = prev.find((c) => c.num === sc.num);
              return {
                num: sc.num,
                name: sc.name || (p ? p.name : ""),
                page_count: p && p.page_count ? p.page_count : sc.downloaded,
                downloaded: sc.downloaded,
              };
            });
            // 保留已登记但扫描不到的章节（如失败/未开始的章）
            prev.forEach((c) => {
              if (!merged.find((m) => m.num === c.num)) {
                merged.push(c);
              }
            });
            merged.sort((a, b) => a.num - b.num);
            comic.chapters = merged;
            comic.size = size;
            comic.downloaded_at = Date.now();
            return comic;
          }).then(
            () => {
              if (this.isDownloadActive(state)) state.storageDirty = false;
              resolve();
            },
            (e) => {
              if (!this.isDownloadActive(state)) {
                reject(DOWNLOAD_ABORTED);
                return;
              }
              console.debug(`存储元数据回写失败: ${e && e.code}`);
              resolve();
            }
          );
        },
        fail: (data, code) => {
          if (!this.isDownloadActive(state)) {
            reject(DOWNLOAD_ABORTED);
            return;
          }
          console.debug(`扫描漫画目录失败, code = ${code}`);
          resolve();
        },
      });
    }, state);
  },

  createFolder(folderUri, state = this._downloadState) {
    return this.downloadOperation((resolve, reject) => {
      file.mkdir({
        uri: folderUri,
        success: () => {
          resolve();
        },
        fail: (data, code) => {
          if (!this.isDownloadActive(state)) {
            reject(DOWNLOAD_ABORTED);
            return;
          }
          if (isAlreadyExistsError(code)) {
            console.debug("文件夹已存在");
            resolve();
          } else {
            reject(this.$t("download.createFolderFailed", { code: code }));
          }
        },
      });
    }, state);
  },

  retryOnFail(code, retryCount, options, state = this._downloadState) {
    if (!this.isDownloadActive(state)) return Promise.reject(DOWNLOAD_ABORTED);
    // 不存在/认证失败等确定性 HTTP 错误无需连续重试；超时/限流仍保留原配额。
    if (code >= 400 && code < 500 && code !== 408 && code !== 429) {
      return Promise.reject(options.failMessage(code));
    }
    console.debug(`${options.label}, code = ${code}, retryCount = ${retryCount}`);

    if (retryCount < MAX_RETRY) {
      const isTimeout = code === FETCH_ERROR.TIMEOUT;
      console.debug(
        isTimeout
          ? `网络超时，正在重试第 ${retryCount + 1} 次...`
          : `网络错误，正在重试第 ${retryCount + 1} 次...`
      );
      // 重试 toast 每次下载运行只发一条（P1-17①）：弱网逐页重试连发成风暴、
      // 多章排队互相顶掉；最终失败另有 downloadError 展示出口
      if (!state.retryNotified) {
        state.retryNotified = true;
        prompt.showToast({
          message: this.$t(isTimeout ? "download.downloadTimeout" : "download.networkErrorRetry", {
            count: retryCount + 1,
          }),
          duration: 1500,
        });
      }
      return this.waitForDownload(1000, state).then(() => {
        this.checkDownloadActive(state);
        return options.retry(retryCount + 1);
      });
    }

    return Promise.reject(
      code === FETCH_ERROR.TIMEOUT ? options.timeoutMessage : options.failMessage(code)
    );
  },

  async fetchImageList(retryCount = 0, state = this._downloadState) {
    this.checkDownloadActive(state);
    const apiUrl = getCurrentSource().apiUrl;
    let response;
    try {
      response = await this.requestDownload(
        { url: buildPhotoUrl(this.id, this.chapter), responseType: "json" },
        state
      );
    } catch (e) {
      this.checkDownloadActive(state);
      return this.retryOnFail(
        e.code,
        retryCount,
        {
          label: "获取图片列表失败",
          retry: (count) => this.fetchImageList(count, state),
          timeoutMessage: this.$t("download.fetchListTimeoutFailed"),
          failMessage: (errCode) => this.$t("download.fetchListFailed", { code: errCode }),
        },
        state
      );
    }
    this.checkDownloadActive(state);
    const body = response.data;
    let urls = null;
    if (
      body &&
      body.images_data &&
      body.images_data.data &&
      Array.isArray(body.images_data.data.picture)
    ) {
      urls = body.images_data.data.picture
        .filter((img) => img && img.url)
        .map((img) => apiUrl + img.url);
      if (body.chapter_info && body.chapter_info.title) {
        this.chapterName = body.chapter_info.title;
      }
    } else if (body && Array.isArray(body.images)) {
      urls = body.images.filter((img) => img && img.url).map((img) => img.url);
      if (body.title) this.chapterName = body.title;
    }
    if (!urls) {
      return this.retryOnFail(
        0,
        retryCount,
        {
          label: "获取图片列表失败",
          retry: (count) => this.fetchImageList(count, state),
          timeoutMessage: this.$t("download.fetchListTimeoutFailed"),
          failMessage: () => this.$t("error.invalidResponse"),
        },
        state
      );
    }
    state.imageCache = urls;
    this.page_count = urls.length;
  },

  fileExists(fileUri, state) {
    return this.downloadOperation((resolve) => {
      file.access({
        uri: fileUri,
        success: () => resolve(true),
        fail: () => resolve(false),
      });
    }, state);
  },

  validateImageFile(uri, allowLvgl, state) {
    return this.downloadOperation((resolve, reject) => {
      isValidImageFile(uri, allowLvgl, () => this.isDownloadActive(state)).then(resolve, reject);
    }, state).catch((e) => {
      this.checkDownloadActive(state);
      throw this.$t("download.downloadFailed") + (e.code || 0);
    });
  },

  async hasValidExistingImage(fileUri, allowLvgl, state) {
    const exists = await this.fileExists(fileUri, state);
    this.checkDownloadActive(state);
    if (!exists) return false;
    const valid = await this.validateImageFile(fileUri, allowLvgl, state);
    this.checkDownloadActive(state);
    if (valid) return true;
    // 仅删除已确认头部无效的目标文件；读取失败会 reject，不误删可读旧图。
    await this.downloadOperation((resolve, reject) => {
      file.delete({
        uri: fileUri,
        success: () => resolve(),
        fail: (data, code) => code === 301 ? resolve() : reject({ data: data, code: code }),
      });
    }, state).catch((e) => {
      this.checkDownloadActive(state);
      throw this.$t("download.downloadFailed") + (e.code || 0);
    });
    this.checkDownloadActive(state);
    state.storageDirty = true;
    return false;
  },

  async saveDownloadedFile(response, fileUri, state, allowLvgl) {
    const tempUri = response && response.data;
    // success 已返回、await 续体尚未运行时也可能退出，必须在 move 前再次校验。
    if (!this.isDownloadActive(state)) {
      deleteImageTemp(tempUri);
      throw DOWNLOAD_ABORTED;
    }
    if (!tempUri) throw this.$t("download.emptyImageData");
    try {
      if (!isHttpSuccess(response)) throw this.$t("error.invalidResponse");
      const valid = await this.validateImageFile(tempUri, allowLvgl, state);
      this.checkDownloadActive(state);
      if (!valid) throw this.$t("error.invalidResponse");
      await this.downloadOperation((resolve, reject) => {
        file.move({
          srcUri: tempUri,
          dstUri: fileUri,
          success: () => resolve(),
          fail: (data, code) => {
            deleteImageTemp(tempUri);
            reject(this.isDownloadActive(state)
              ? this.$t("download.moveImageFailed", { code: code }) : DOWNLOAD_ABORTED);
          },
        });
      }, state);
    } catch (e) {
      deleteImageTemp(tempUri);
      throw e;
    }
  },

  async downloadPage(page, folderUri, retryCount = 0, state = this._downloadState) {
    this.checkDownloadActive(state);
    const imageUrl = addImageParams(
      state.imageCache[page - 1],
      parseInt(global.APP_SETTING.imageSize, 10) || 480,
      parseInt(global.APP_SETTING.imageQuality, 10) || 50
    );
    const fileUri = `${folderUri}/${page}${global.APP_SETTING.imagePreTranscode ? ".bin" : ""}`;
    const exists = await this.hasValidExistingImage(fileUri, !!global.APP_SETTING.imagePreTranscode, state);
    this.checkDownloadActive(state);
    if (exists) return;

    state.storageDirty = true;
    let response;
    try {
      response = await this.requestDownload(
        {
          url: appendLvglSuffix(
            imageUrl,
            `${state.comicId}${this.chapter ? "_ch" + this.chapter : ""}_p${page}`
          ),
          responseType: "file",
        },
        state
      );
    } catch (e) {
      this.checkDownloadActive(state);
      return this.retryOnFail(
        e.code,
        retryCount,
        {
          label: "下载图片失败",
          retry: (count) => this.downloadPage(page, folderUri, count, state),
          timeoutMessage: this.$t("download.downloadTimeoutFailed"),
          failMessage: (errCode) => this.$t("download.downloadFailed") + errCode,
        },
        state
      );
    }
    await this.saveDownloadedFile(response, fileUri, state, !!global.APP_SETTING.imagePreTranscode);
  },

  async downloadCover(folderUri, retryCount = 0, state = this._downloadState) {
    this.checkDownloadActive(state);
    if (!this.cover) return;
    const fileUri = `${folderUri}/cover`;
    // 复用已有封面，路由传入的 cover 始终是源 URL。
    const exists = await this.hasValidExistingImage(fileUri, false, state);
    this.checkDownloadActive(state);
    if (exists) return;

    state.storageDirty = true;
    let response;
    try {
      response = await this.requestDownload(
        {
          url: appendCoverSuffix(addCoverParams(this.cover), `${state.comicId}_cover`),
          responseType: "file",
        },
        state
      );
    } catch (e) {
      this.checkDownloadActive(state);
      return this.retryOnFail(
        e.code,
        retryCount,
        {
          label: "下载封面失败",
          retry: (count) => this.downloadCover(folderUri, count, state),
          timeoutMessage: this.$t("download.coverTimeoutFailed"),
          failMessage: (errCode) => this.$t("download.coverFailed", { code: errCode }),
        },
        state
      );
    }
    await this.saveDownloadedFile(response, fileUri, state, false);
  },

  routeBack() {
    this.cancelDownload();
    router.back();
  },
};
</script>

<style>
@import "../../common/base.css";

.container {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.content {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
}

.per {
  font-size: 32px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: bold;
}

.dl-text {
  margin-top: 24px;
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 80px;
  margin-left: 40px;
  margin-right: 40px;
}

/* 章节选择界面样式 */
.chapter-select {
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}

.chapter-list {
  width: 100%;
  flex: 1;
  flex-wrap: wrap;
}

.chapter-item {
  width: 31%;
  background-color: #262626;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin: 3.33%;
  border: 3px solid rgba(255, 255, 255, 0.24);
  flex-direction: column;
}

/* 已下载状态提示色：蓝=完整下载，橙=部分下载（不完整）
   需定义在 .selected 之前，选中态绿色背景/边框可完整覆盖提示色 */
.dl-full {
  background-color: #17394d;
  border-color: #4fc3f7;
}

.dl-partial {
  background-color: #4d3a17;
  border-color: #ffa726;
}

.selected {
  background-color: #4caf50;
  border-color: #4caf50;
}

.chapter-text {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.select-text {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.select-buttons {
  margin-top: 20px;
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
}

.button {
  min-width: auto;
  height: 100%;
  border: 3px solid rgba(255, 255, 255, 0.24);
  background-color: #262626;
  padding: 10px 6px;
  border-radius: 100%;
  justify-content: center;
  align-items: center;
}

/* 方形手表适配 */
@media (shape: rect) {
  #process {
    position: absolute;
    bottom: 6px;
    width: 95%;
    height: 92px;
    background-color: #262626;
    border-radius: 36px;
    justify-content: space-around;
  }

  .downloading {
    justify-content: center;
    align-items: center;
    width: 100%;
    flex: 1;
    flex-direction: column;
  }

  .select-buttons {
    width: 95%;
  }
}

/* 圆形手表适配 */
@media (device-type: watch) and (shape: circle) {
  .chapter-select {
    width: 90%;
  }

  .container {
    justify-content: center;
  }

  .downloading {
    justify-content: center;
    align-items: center;
    width: 100%;
    flex-direction: column;
    position: absolute;
    bottom: 40px;
  }

  .title {
    position: absolute;
    top: 32px;
  }

  .time {
    position: absolute;
    top: 10px;
  }

  #mask {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    overflow: hidden;
  }

  .dl-text {
    margin-top: 24px;
    font-size: 32px;
    color: #ffffff;
    font-weight: bold;
    margin-bottom: 20px;
  }

  #process {
    position: absolute;
    width: 80%;
    height: 92px;
    background-color: #262626;
    border-radius: 100%;
    justify-content: space-around;
  }

  #process-s4 {
    position: absolute;
    width: 80%;
    padding: 10px 25px;
    background-color: #262626;
    border-radius: 100%;
    justify-content: space-around;
  }

  .chapter-list {
    margin-top: 72px;
    width: 90%;
  }

  .select-buttons {
    flex-direction: column;
    width: 50%;
    height: 160px;
  }

  .button {
    margin-bottom: 10px;
    padding: 5px;
  }
}

/* 看看是不是小米手环Pro */
@media (device-type: band) and (shape: rect) {
  .title {
    width: 180px;
  }
}
/* 看看是不是红米手表 */
@media (device-type: watch) and (shape: rect) {
  .title {
    width: 248px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .title {
    width: 240px;
  }
}
</style>
