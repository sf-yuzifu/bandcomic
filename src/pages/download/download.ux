<template>
  <div class="container">
    <div
      id="mask"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && !downloadError }}"
    >
      <image
        style="top: 300px; width: 926px; height: 926px"
        src="/common/{{ processing ? 'success':'dling' }}_s4.png"
      ></image>
    </div>
    <div id="mask" if="{{ !showChapterSelect && global.screenShape == 'circle' && downloadError }}">
      <image style="top: 300px; width: 926px; height: 926px" src="/common/fail_s4.png"></image>
    </div>

    <text class="time">{{ time }}</text>

    <div class="title" style="justify-content: center">
      <text class="iconfont" style="margin-right: 10px" if="{{ global.screenShape == 'circle' }}">
        &#xe685;
      </text>
      <marquee
        scrollamount="{{ 20 }}"
        text-offset="{{ 20 }}"
        style="font-size: 32px; font-weight: bold; text-align: center"
        @click="
          () => {
            if (global.screenShape == 'circle') {
              routeBack();
            }
          }
        "
      >
        {{ $t("download.title") }}{{ queuePosition }}{{ chapterName ? " - " + chapterName : "" }}
      </marquee>
    </div>

    <img
      if="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />

    <!-- 章节选择界面 -->
    <div class="chapter-select" if="{{ showChapterSelect && !downloadError }}">
      <div style="width: 100%; height: 100%">
        <scroll
          id="chapterScroll"
          scroll-y="true"
          class="chapter-list"
          bounces="true"
          onscrolltop="onScrollTop"
          onscrollbottom="onScrollBottom"
        >
          <div
            for="{{ chapter in chapterList.slice(displayStart, displayEnd) }}"
            class="chapter-item {{ chapter.selected ? 'selected' : '' }} {{ chapter.dlState }}"
            @click="toggleChapter(chapter.num)"
          >
            <text class="chapter-text">{{ $t("photo.chapter") }}</text>
            <text class="chapter-text">{{ chapter.num }}</text>
          </div>
        </scroll>
      </div>
      <div class="select-buttons">
        <div class="button" @click="selectAll">
          <text class="select-text">
            {{
              selectedChapters.length == total_chapters
                ? $t("download.deselectAll")
                : $t("download.selectAll")
            }}
          </text>
        </div>
        <div class="button" @click="startBatchDownload">
          <text class="select-text">
            {{ $t("download.startDownload") }}({{ selectedChapters.length }})
          </text>
        </div>
      </div>
    </div>

    <!-- 方形手表下载界面 -->
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape != 'circle' && !downloadError }}"
    >
      <image src="/common/{{ processing ? 'success':'dling' }}.png"></image>
      <text class="dl-text">
        {{ processing ? $t("download.complete") : $t("download.downloading") }}
      </text>
    </div>
    <div
      id="process"
      if="{{ !showChapterSelect && global.screenShape != 'circle' && !downloadError }}"
    >
      <text class="content">
        {{ $t("download.page", { page: page, total_page: page_count }) }}
      </text>
      <text class="per">{{ page_count > 0 ? Math.floor((page / page_count) * 100) : 0 }}%</text>
    </div>
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape != 'circle' && downloadError }}"
    >
      <image src="/common/fail.png"></image>
      <text class="dl-text">{{ downloadError }}</text>
    </div>

    <!-- 圆形手表下载界面 -->
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && !downloadError }}"
    >
      <text class="dl-text">
        {{ processing ? $t("download.complete") : $t("download.downloading") }}
      </text>
      <image src="/common/{{ processing ? 'success':'dl' }}_icon.png"></image>
    </div>
    <div
      id="process"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && !downloadError }}"
    >
      <text class="content">
        {{ $t("download.page", { page: page, total_page: page_count }) }}
      </text>
      <text class="per">{{ page_count > 0 ? Math.floor((page / page_count) * 100) : 0 }}%</text>
    </div>
    <div
      class="downloading"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && downloadError }}"
    >
      <text class="dl-text">{{ $t("download.downloadFailed") }}</text>
      <image src="/common/fail_icon.png"></image>
    </div>
    <div
      id="process-s4"
      if="{{ !showChapterSelect && global.screenShape == 'circle' && downloadError }}"
    >
      <text class="content">{{ downloadError }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import file from "@system.file";
import prompt from "@system.prompt";

import { addImageParams, addCoverParams, appendLvglSuffix } from "../../components/imageUrl";
import { updateComicMeta, isAlreadyExistsError, readComics } from "../../components/storage";
import { apiFetch, buildPhotoUrl, getCurrentSource, FETCH_ERROR } from "../../components/api";

const { getTime } = global;

const MAX_RETRY = 3;
// 失败页数超过该阈值视为网络/服务器整体故障
const MAX_FAILED_TOLERANCE = 3;

let ImageCache = [];

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function sanitizeFolderName(name) {
  if (!name) return name;
  const invalidChars = /[\\/:*?"<>|]/g;
  return name.replace(invalidChars, "_");
}

// 章节本地下载状态：完整下载 → "dl-full"；本地有页但不完整 → "dl-partial"；
// 无记录或 0 页 → ""（无标记）。page_count 缺失的旧数据有页即视为完整
function getChapterDlState(entry) {
  if (!entry || !entry.downloaded) return "";
  if (!entry.page_count || entry.downloaded >= entry.page_count) return "dl-full";
  return "dl-partial";
}

export default {
  private: {
    time: "",
    id: 0,
    page_count: 0,
    name: "",
    page: 0,
    cover: "",
    processing: false,
    chapter: 0,
    downloadError: "",
    originalName: "",
    is_serial: false,
    showChapterSelect: false,
    chapterList: [],
    selectedChapters: [],
    total_chapters: 0,
    currentChapterIndex: 0,
    chapterName: "",
    displayStart: 0,
    displayEnd: 18,
    loadingMore: false,
    scrollTopTriggered: false,
    scrollBottomTriggered: false,
    failedChapters: [],
    coverDone: false,
    queuePosition: "",
  },

  onShow() {
    this.time = getTime();
  },

  onDestroy() {
    // 页面销毁后中止下载链：各异步环节检查该标志，
    // 避免僵尸回调继续下载、toast 串台或 router.replace 劫持导航
    this.destroyed = true;
    ImageCache = [];
  },

  async onInit() {
    this.destroyed = false;
    this.showChapterSelect = this.total_chapters > 1;
    await this.initData();
    if (!(this.is_serial && this.total_chapters > 1)) {
      // 错误已在 startDownloadProcess 内反映到 downloadError UI
      this.startDownloadProcess().catch(() => {});
    }
  },

  async initData() {
    this.is_serial = this.total_chapters > 1;
    this.originalName = this.name;
    this.displayStart = 0;
    this.displayEnd = Math.min(18, this.total_chapters);
    if (this.is_serial) {
      // 先同步渲染章节网格，已下载标记异步补齐，进页不被 IO 阻塞
      this.chapterList = [];
      for (let i = 1; i <= this.total_chapters; i++) {
        this.chapterList.push({
          num: i,
          selected: false,
          dlState: "",
        });
      }
      this.markDownloadedChapters();
    }
  },

  // 异步标记各章本地下载状态，让用户分辨哪些章已下载过。
  // 已下页数以磁盘实际文件为准（下载中途退出时元数据 downloaded 滞后，
  // syncComicStorageMeta 要等队列完整结束后才回写）；总页数取元数据登记的 API 页数。
  // 两个 IO 无依赖，并行发起
  async markDownloadedChapters() {
    const comicId = global.API_SETTING.using + "_" + this.id;
    const results = await Promise.all([
      readComics().catch(() => []),
      this.scanLocalChapterPages(comicId),
    ]);
    // 页面已销毁（IO 期间退出）则不再 patch
    if (this.destroyed) return;
    const comics = results[0];
    const scannedPages = results[1];
    const comic = (Array.isArray(comics) ? comics : []).find((c) => c.id === comicId);
    const pageCountMap = {};
    ((comic && comic.chapters) || []).forEach((c) => {
      pageCountMap[c.num] = c.page_count || 0;
    });
    // 一次性整体替换触发一次渲染；用户已勾选的 selected 状态保留
    this.chapterList = this.chapterList.map((item) => ({
      ...item,
      dlState: getChapterDlState({
        downloaded: scannedPages[item.num] || 0,
        page_count: pageCountMap[item.num] || 0,
      }),
    }));
  },

  // 扫描本漫磁盘目录，返回 { 章节号: 实际页数 }；目录不存在/扫描失败回空对象
  scanLocalChapterPages(comicId) {
    return new Promise((resolve) => {
      file.get({
        uri: `internal://files/${comicId}`,
        recursive: true,
        success: (data) => {
          const pages = {};
          (data.subFiles || []).forEach((item) => {
            if (item.type !== "dir") return;
            const num = parseInt(item.uri.split("/").pop().split("　")[0], 10);
            if (!isNaN(num)) {
              pages[num] = (item.subFiles || []).length;
            }
          });
          resolve(pages);
        },
        fail: () => resolve({}),
      });
    });
  },

  toggleChapter(chapterNum) {
    const index = this.selectedChapters.indexOf(chapterNum);
    if (index === -1) {
      this.selectedChapters.push(chapterNum);
    } else {
      this.selectedChapters.splice(index, 1);
    }
    for (let i = 0; i < this.chapterList.length; i++) {
      if (this.chapterList[i].num === chapterNum) {
        this.chapterList[i].selected = !this.chapterList[i].selected;
        break;
      }
    }
  },

  selectAll() {
    if (this.selectedChapters.length == this.total_chapters) {
      this.selectedChapters = [];
      for (let i = 0; i < this.chapterList.length; i++) {
        this.chapterList[i].selected = false;
      }
    } else {
      this.selectedChapters = [];
      for (let i = 1; i <= this.total_chapters; i++) {
        this.selectedChapters.push(i);
      }
      for (let i = 0; i < this.chapterList.length; i++) {
        this.chapterList[i].selected = true;
      }
    }
  },

  onScrollTop() {
    if (this.displayStart === 0 || this.loadingMore) {
      this.scrollTopTriggered = false;
      return;
    }
    if (!this.scrollTopTriggered) {
      this.scrollTopTriggered = true;
      return;
    }
    this.scrollTopTriggered = false;
    this.scrollBottomTriggered = false;
    this.loadingMore = true;
    this.displayEnd = this.displayStart;
    this.displayStart = Math.max(0, this.displayStart - 18);
    this.loadingMore = false;
  },

  onScrollBottom() {
    if (this.displayEnd >= this.total_chapters || this.loadingMore) {
      this.scrollBottomTriggered = false;
      return;
    }
    if (!this.scrollBottomTriggered) {
      this.scrollBottomTriggered = true;
      return;
    }
    this.scrollTopTriggered = false;
    this.scrollBottomTriggered = false;
    this.loadingMore = true;
    this.displayStart = this.displayEnd;
    this.displayEnd = Math.min(this.displayEnd + 18, this.total_chapters);
    this.loadingMore = false;
  },

  async startBatchDownload() {
    if (this.selectedChapters.length === 0) {
      prompt.showToast({
        message: this.$t("download.selectAtLeastOne"),
        duration: 2000,
      });
      return;
    }
    this.showChapterSelect = false;
    this.failedChapters = [];
    this.coverDone = false;
    this.queuePosition = "";
    this.currentChapterIndex = 0;
    await this.downloadNextChapter();
  },

  async downloadNextChapter() {
    if (this.destroyed) return;
    if (this.currentChapterIndex >= this.selectedChapters.length) {
      // 队列结束，回写一次真实存储元数据（含失败章节的实际已下载页数）
      await this.syncComicStorageMeta();
      if (this.destroyed) return;
      if (this.failedChapters.length === 0) {
        this.processing = true;
        prompt.showToast({
          message: this.$t("download.allComplete"),
          duration: 2000,
        });
        await sleep(1000);
        if (this.destroyed) return;
        router.replace({
          uri: "/pages/offline",
        });
      } else {
        this.showSummaryView();
      }
      return;
    }

    this.chapter = this.selectedChapters[this.currentChapterIndex];
    this.queuePosition =
      "(" + (this.currentChapterIndex + 1) + "/" + this.selectedChapters.length + ")";
    this.chapterName = "";
    this.processing = false;
    this.page = 0;
    // 切章间隙重置总数：fetchImageList 返回前不残留上一章的 page_count，
    // 避免进度条短暂显示 "0/旧N" 的失真百分比
    this.page_count = 0;
    this.downloadError = "";

    try {
      await this.startDownloadProcess();
    } catch (error) {
      if (this.destroyed) return;
      console.error(`章节 ${this.chapter} 下载失败:`, error);
      this.failedChapters.push(this.chapter);
      // 队列模式不用整屏错误 UI，toast 提示原因后继续下一章
      this.downloadError = "";
      const reason = typeof error === "string" ? error : String(error);
      prompt.showToast({
        message: this.$t("download.chapterFailed", { chapter: this.chapter, reason: reason }),
        duration: 2500,
      });
      await sleep(500);
    }

    this.currentChapterIndex++;
    await sleep(500);
    await this.downloadNextChapter();
  },

  showSummaryView() {
    this.queuePosition = "";
    // 复用原本的失败 UI：fail 图标 + downloadError 文案，用户自行返回
    if (this.failedChapters.length === this.selectedChapters.length) {
      this.downloadError = this.$t("download.allFailed");
    } else {
      this.downloadError = this.$t("download.summaryWithFailed", {
        success: this.selectedChapters.length - this.failedChapters.length,
        total: this.selectedChapters.length,
        chapters: this.failedChapters.join("、"),
      });
    }
  },

  async startDownloadProcess() {
    try {
      await this.ensureComicRegistered();
      await this.createFolderAndDownload();
    } catch (error) {
      console.debug(`下载过程出错: ${error}`);
      this.downloadError = error;
      this.processing = false;
      throw error;
    }
  },

  // 把漫画登记进 comics.json（串行队列内读-改-写 + 原子落盘）：
  // 已存在则合并（保留 chapters/size/downloaded_at 等元数据），不存在则新建
  ensureComicRegistered() {
    const newComic = {
      name: this.is_serial ? this.originalName : this.name,
      page_count: this.page_count,
      id: global.API_SETTING.using + "_" + this.id,
      is_serial: this.is_serial,
    };
    return updateComicMeta(newComic.id, (comic) => ({
      ...comic,
      ...newComic,
      // 连载每章登记时 this.page_count 已被重置为 0，不能用 0 覆盖旧值；
      // 真实页数由 syncChapterMeta 写入 chapters[].page_count
      page_count: this.page_count || comic.page_count || 0,
    })).catch((e) => {
      if (e && e.parseError) {
        throw this.$t("download.parseIndexFailed");
      }
      throw this.$t("download.writeIndexFailed", { code: e && e.code });
    });
  },

  async createFolderAndDownload() {
    try {
      this.processing = false;
      this.page = 0;
      this.downloadError = "";

      let folderUri;
      let coverUri;

      await this.fetchImageList();

      // 先把当前章节登记进元数据，下载中断时离线页可据此判断未完成
      await this.syncChapterMeta();

      if (this.is_serial) {
        const mainFolderUri = `internal://files/${global.API_SETTING.using + "_" + this.id}`;
        await this.createFolder(mainFolderUri);
        const chapterName = sanitizeFolderName(this.chapterName || this.name);
        folderUri = `${mainFolderUri}/${this.chapter}　${chapterName}`;
        coverUri = mainFolderUri;
      } else {
        folderUri = `internal://files/${global.API_SETTING.using + "_" + this.id}`;
        coverUri = folderUri;
      }
      await this.createFolder(folderUri);

      if (this.is_serial) {
        // 封面失败不应中断队列，下一章会重试
        if (!this.coverDone) {
          try {
            await this.downloadCover(coverUri);
            this.coverDone = true;
          } catch (e) {
            console.debug(`封面下载失败，将在下一章重试: ${e}`);
          }
        }
      } else {
        await this.downloadCover(coverUri);
      }

      await this.downloadPages(folderUri);

      if (!this.is_serial) {
        await this.syncComicStorageMeta();
        if (this.destroyed) return;
        this.processing = true;
        prompt.showToast({
          message: this.$t("download.complete"),
          duration: 2000,
        });

        await sleep(1000);
        if (this.destroyed) return;
        router.replace({
          uri: "/pages/offline",
        });
      }
    } catch (error) {
      console.error("下载过程出错:", error);
      this.downloadError = error;
      this.processing = false;
      throw error;
    }
  },

  // 按顺序逐页下载：手环设备性能有限，并发请求只会更卡；
  // 个别页失败先记账不中断，其余页下完后串行补一次，仍失败才抛出；
  // 失败页数超过阈值视为网络/服务器整体故障，直接抛首个错误不再补
  async downloadPages(folderUri) {
    let completed = 0;
    const failedPages = [];

    for (let p = 1; p <= this.page_count; p++) {
      if (this.destroyed) return;
      try {
        await this.downloadPage(p, folderUri);
        this.page = ++completed;
      } catch (e) {
        failedPages.push({ page: p, error: e });
      }
    }

    if (this.destroyed) return;
    if (failedPages.length === 0) {
      return;
    }
    if (failedPages.length > MAX_FAILED_TOLERANCE) {
      throw failedPages[0].error;
    }
    prompt.showToast({
      message: this.$t("download.retryFailedPages", { count: failedPages.length }),
      duration: 2000,
    });
    for (const item of failedPages) {
      await this.downloadPage(item.page, folderUri);
      this.page = ++completed;
    }
  },

  // 把当前章节登记到 comics.json 元数据（下载前调用，downloaded 保留旧值）
  syncChapterMeta() {
    const comicId = global.API_SETTING.using + "_" + this.id;
    const chapterNum = this.is_serial ? this.chapter : 0;
    const chapterName = this.is_serial ? this.chapterName || this.name : "";
    const pageCount = this.page_count;
    return updateComicMeta(comicId, (comic) => {
      comic.name = this.is_serial ? this.originalName : this.name;
      comic.is_serial = this.is_serial;
      if (this.is_serial) {
        if (this.total_chapters) {
          comic.total_chapters = this.total_chapters;
        }
      } else {
        comic.page_count = pageCount;
      }
      if (!Array.isArray(comic.chapters)) {
        comic.chapters = [];
      }
      const idx = comic.chapters.findIndex((c) => c.num === chapterNum);
      const prevDownloaded = idx >= 0 ? comic.chapters[idx].downloaded || 0 : 0;
      const entry = {
        num: chapterNum,
        name: chapterName,
        page_count: pageCount,
        downloaded: prevDownloaded,
      };
      if (idx >= 0) {
        comic.chapters[idx] = entry;
      } else {
        comic.chapters.push(entry);
      }
      return comic;
    }).catch((e) => {
      console.debug(`章节元数据登记失败: ${e && e.code}`);
    });
  },

  // 下载结束后扫描一次目录，回写真实占用大小和各章已下载页数
  syncComicStorageMeta() {
    const comicId = global.API_SETTING.using + "_" + this.id;
    const folderUri = `internal://files/${comicId}`;
    return new Promise((resolve) => {
      file.get({
        uri: folderUri,
        recursive: true,
        success: (data) => {
          const subFiles = data.subFiles || [];
          updateComicMeta(comicId, (comic) => {
            let size = 0;
            const scanned = [];
            if (this.is_serial) {
              for (const item of subFiles) {
                if (item.type === "dir") {
                  let len = 0;
                  for (const f of item.subFiles || []) {
                    len += f.length;
                  }
                  size += len;
                  const parts = item.uri.split("/").pop().split("　");
                  scanned.push({
                    num: parseInt(parts[0], 10),
                    name: parts.slice(1).join("　"),
                    downloaded: (item.subFiles || []).length,
                  });
                } else {
                  size += item.length;
                }
              }
            } else {
              let pages = 0;
              for (const item of subFiles) {
                if (item.type !== "dir") {
                  size += item.length;
                  pages++;
                }
              }
              // 根目录文件含封面，页数减一
              scanned.push({ num: 0, name: "", downloaded: Math.max(0, pages - 1) });
            }
            const prev = Array.isArray(comic.chapters) ? comic.chapters : [];
            const merged = scanned.map((sc) => {
              const p = prev.find((c) => c.num === sc.num);
              return {
                num: sc.num,
                name: sc.name || (p ? p.name : ""),
                page_count: p && p.page_count ? p.page_count : sc.downloaded,
                downloaded: sc.downloaded,
              };
            });
            // 保留已登记但扫描不到的章节（如失败/未开始的章）
            prev.forEach((c) => {
              if (!merged.find((m) => m.num === c.num)) {
                merged.push(c);
              }
            });
            merged.sort((a, b) => a.num - b.num);
            comic.chapters = merged;
            comic.size = size;
            comic.downloaded_at = Date.now();
            return comic;
          }).then(
            () => resolve(),
            (e) => {
              console.debug(`存储元数据回写失败: ${e && e.code}`);
              resolve();
            }
          );
        },
        fail: (data, code) => {
          console.debug(`扫描漫画目录失败, code = ${code}`);
          resolve();
        },
      });
    });
  },

  createFolder(folderUri) {
    return new Promise((resolve, reject) => {
      file.mkdir({
        uri: folderUri,
        success: () => {
          console.debug(`创建文件夹成功: ${folderUri}`);
          resolve();
        },
        fail: (data, code) => {
          if (isAlreadyExistsError(code)) {
            console.debug("文件夹已存在");
            resolve();
          } else {
            reject(this.$t("download.createFolderFailed", { code: code }));
          }
        },
      });
    });
  },

  retryOnFail(code, retryCount, options) {
    if (this.destroyed) return Promise.reject("aborted");
    console.debug(`${options.label}, code = ${code}, retryCount = ${retryCount}`);

    if (retryCount < MAX_RETRY) {
      const isTimeout = code === FETCH_ERROR.TIMEOUT;
      console.debug(
        isTimeout
          ? `网络超时，正在重试第 ${retryCount + 1} 次...`
          : `网络错误，正在重试第 ${retryCount + 1} 次...`
      );
      prompt.showToast({
        message: this.$t(isTimeout ? "download.downloadTimeout" : "download.networkErrorRetry", {
          count: retryCount + 1,
        }),
        duration: 1500,
      });
      return sleep(1000).then(() => options.retry(retryCount + 1));
    }

    return Promise.reject(
      code === FETCH_ERROR.TIMEOUT ? options.timeoutMessage : options.failMessage(code)
    );
  },

  fetchImageList(retryCount = 0) {
    return new Promise((resolve, reject) => {
      apiFetch({
        url: buildPhotoUrl(this.id, this.chapter),
        responseType: "json",
        success: (response) => {
          const body = response.data;
          let urls = null;
          if (
            body &&
            body.images_data &&
            body.images_data.data &&
            Array.isArray(body.images_data.data.picture)
          ) {
            urls = body.images_data.data.picture
              .filter((img) => img && img.url)
              .map((img) => getCurrentSource().apiUrl + img.url);
            if (body.chapter_info && body.chapter_info.title) {
              this.chapterName = body.chapter_info.title;
            }
          } else if (body && Array.isArray(body.images)) {
            urls = body.images.filter((img) => img && img.url).map((img) => img.url);
            if (body.title) {
              this.chapterName = body.title;
            }
          }
          if (!urls) {
            this.retryOnFail(0, retryCount, {
              label: "获取图片列表失败",
              retry: (count) => this.fetchImageList(count),
              timeoutMessage: this.$t("download.fetchListTimeoutFailed"),
              failMessage: () => this.$t("error.invalidResponse"),
            })
              .then(resolve)
              .catch(reject);
            return;
          }
          ImageCache = urls;
          this.page_count = ImageCache.length;
          resolve();
        },
        fail: (data, code) => {
          this.retryOnFail(code, retryCount, {
            label: "获取图片列表失败",
            retry: (count) => this.fetchImageList(count),
            timeoutMessage: this.$t("download.fetchListTimeoutFailed"),
            failMessage: (errCode) => this.$t("download.fetchListFailed", { code: errCode }),
          })
            .then(resolve)
            .catch(reject);
        },
      });
    });
  },

  downloadPage(page, folderUri, retryCount = 0) {
    let imageUrl;

    return new Promise((resolve, reject) => {
      imageUrl = ImageCache[page - 1];
      imageUrl = addImageParams(
        imageUrl,
        parseInt(global.APP_SETTING.imageSize, 10) || 600,
        parseInt(global.APP_SETTING.imageQuality, 10) || 50
      );

      const fileUri = `${folderUri}/${page}${global.APP_SETTING.imagePreTranscode ? ".bin" : ""}`;

      const startFetch = () => {
        apiFetch({
          url: appendLvglSuffix(
            imageUrl,
            `${global.API_SETTING.using}_${this.id}${
              this.chapter ? "_ch" + this.chapter : ""
            }_p${page}`
          ),
          responseType: "file",
          success: (response) => {
            if (response.data) {
              file.move({
                srcUri: response.data,
                dstUri: fileUri,
                success: () => {
                  console.debug(`图片保存成功: ${fileUri}`);
                  resolve();
                },
                fail: (data, code) => {
                  reject(this.$t("download.moveImageFailed", { code: code }));
                },
              });
            } else {
              reject(this.$t("download.emptyImageData"));
            }
          },
          fail: (data, code) => {
            this.retryOnFail(code, retryCount, {
              label: "下载图片失败",
              retry: (count) => this.downloadPage(page, folderUri, count),
              timeoutMessage: this.$t("download.downloadTimeoutFailed"),
              failMessage: (errCode) => this.$t("download.downloadFailed") + errCode,
            })
              .then(resolve)
              .catch(reject);
          },
        });
      };

      file.access({
        uri: fileUri,
        success: () => {
          console.debug(`图片已存在，跳过下载: ${fileUri}`);
          resolve();
        },
        fail: () => {
          startFetch();
        },
      });
    });
  },

  downloadCover(folderUri, retryCount = 0) {
    return new Promise((resolve, reject) => {
      const imageUrl = addCoverParams(this.cover);

      const fileUri = `${folderUri}/cover`;

      apiFetch({
        url: appendLvglSuffix(imageUrl, `${global.API_SETTING.using}_${this.id}_cover`),
        responseType: "file",
        success: (response) => {
          if (response.data) {
            file.move({
              srcUri: response.data,
              dstUri: fileUri,
              success: () => {
                console.debug(`封面保存成功: ${fileUri}`);
                resolve();
              },
              fail: (data, code) => {
                reject(this.$t("download.moveImageFailed", { code: code }));
              },
            });
          } else {
            reject(this.$t("download.emptyImageData"));
          }
        },
        fail: (data, code) => {
          this.retryOnFail(code, retryCount, {
            label: "下载封面失败",
            retry: (count) => this.downloadCover(folderUri, count),
            timeoutMessage: this.$t("download.coverTimeoutFailed"),
            failMessage: (errCode) => this.$t("download.coverFailed", { code: errCode }),
          })
            .then(resolve)
            .catch(reject);
        },
      });
    });
  },

  routeBack() {
    router.back();
  },
};
</script>

<style>
@import "../../common/base.css";

.container {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.content {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
}

.per {
  font-size: 32px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: bold;
}

.dl-text {
  margin-top: 24px;
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 80px;
  margin-left: 40px;
  margin-right: 40px;
}

/* 章节选择界面样式 */
.chapter-select {
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}

.chapter-list {
  width: 100%;
  flex: 1;
  flex-wrap: wrap;
}

.chapter-item {
  width: 31%;
  background-color: #262626;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin: 3.33%;
  border: 3px solid rgba(255, 255, 255, 0.24);
  flex-direction: column;
}

/* 已下载状态提示色：蓝=完整下载，橙=部分下载（不完整）
   需定义在 .selected 之前，选中态绿色背景/边框可完整覆盖提示色 */
.dl-full {
  background-color: #17394d;
  border-color: #4fc3f7;
}

.dl-partial {
  background-color: #4d3a17;
  border-color: #ffa726;
}

.selected {
  background-color: #4caf50;
  border-color: #4caf50;
}

.chapter-text {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.select-text {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}

.select-buttons {
  margin-top: 20px;
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
}

.button {
  min-width: auto;
  height: 100%;
  border: 3px solid rgba(255, 255, 255, 0.24);
  background-color: #262626;
  padding: 10px 6px;
  border-radius: 100%;
  justify-content: center;
  align-items: center;
}

/* 方形手表适配 */
@media (shape: rect) {
  #process {
    position: absolute;
    bottom: 6px;
    width: 95%;
    height: 92px;
    background-color: #262626;
    border-radius: 36px;
    justify-content: space-around;
  }

  .downloading {
    justify-content: center;
    align-items: center;
    width: 100%;
    flex: 1;
    flex-direction: column;
  }

  .select-buttons {
    width: 95%;
  }
}

/* 圆形手表适配 */
@media (device-type: watch) and (shape: circle) {
  .container {
    justify-content: center;
  }

  .downloading {
    justify-content: center;
    align-items: center;
    width: 100%;
    flex-direction: column;
    position: absolute;
    bottom: 40px;
  }

  .title {
    position: absolute;
    top: 32px;
  }

  .time {
    position: absolute;
    top: 10px;
  }

  #mask {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    overflow: hidden;
  }

  .dl-text {
    margin-top: 24px;
    font-size: 32px;
    color: #ffffff;
    font-weight: bold;
    margin-bottom: 20px;
  }

  #process {
    position: absolute;
    width: 80%;
    height: 92px;
    background-color: #262626;
    border-radius: 100%;
    justify-content: space-around;
  }

  #process-s4 {
    position: absolute;
    width: 80%;
    padding: 10px 25px;
    background-color: #262626;
    border-radius: 100%;
    justify-content: space-around;
  }

  .chapter-list {
    margin-top: 72px;
    width: 90%;
  }

  .select-buttons {
    flex-direction: column;
    width: 50%;
    height: 160px;
  }

  .button {
    margin-bottom: 10px;
    padding: 5px;
  }
}

/* 看看是不是小米手环Pro */
@media (device-type: band) and (shape: rect) {
  .title {
    width: 180px;
  }
}
/* 看看是不是红米手表 */
@media (device-type: watch) and (shape: rect) {
  .title {
    width: 248px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .title {
    width: 240px;
  }
}
</style>
