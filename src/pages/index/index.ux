<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="demo-page">
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/info.png"
      @click="routeAbout"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton bottom"
      src="/common/More_B.png"
      @click="routeOffline"
    />
    <img
      if.static="{{ global.screenShape == 'circle' }}"
      class="bottom"
      src="/common/more_s4.png"
      @click="routeOffline"
    />
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ hide && global.screenShape == 'circle' }}" @click="routeAbout">
      {{ $t("appName") }}
    </text>
    <text class="title" if.static="{{ global.screenShape != 'circle' }}">
      {{ $t("appName") }}
    </text>

    <div class="line" style="margin-bottom: 10px">
      <text static style="margin-bottom: 4px">{{ $t("elsePlaceholder") }}</text>
      <div class="input-line" @click="changeState">
        <scroll
          style="position: absolute; width: 100%; height: 42px; margin: 6px 0"
          scroll-x="true"
        >
          <text class="input-text">
            {{ context }}
          </text>
        </scroll>
      </div>
      <div class="padding" style="height: 60%" if="{{ !hide }}"></div>
      <div
        class="padding"
        style="height: 2%"
        if="{{ !hide && global.screenShape == 'circle' }}"
      ></div>
    </div>

    <div if="{{ hide }}" class="source-selector">
      <text class="source-text">{{ $t("currentSourceName") }}{{ currentSourceName }}</text>
      <text if="{{ Object.keys(API_SETTING).length > 2 }}" class="iconfont" @click="toggleSource">
        &#xe628;
      </text>
      <text class="iconfont" @click="routeEdit" static>&#xe607;</text>
    </div>
    <input-method
      hide="{{ hide }}"
      keyboardtype="qwerty"
      maxlength="5"
      screentype="{{ global.screenShape }}"
      @delete="deleteit"
      @complete="complete"
    ></input-method>

    <div
      class="donate"
      if="{{ display }}"
      @click="
        () => {
          display = false;
          global.display = false;
        }
      "
    >
      <image static src="/common/donate.png" />
      <text static style="color: #fff; font-weight: bold">{{ $t("donate") }}</text>
      <text static style="color: rgba(255, 255, 255, 0.6); font-size: 20px; font-weight: bold">
        {{ $t("donateHint") }}
      </text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";
import brightness from "@system.brightness";
import file from "@system.file";
import { createDataBridge } from "../../components/dataBridge";
import { getConnection, registerBridgeHandler } from "../../components/interconnectHub";
import { checkUpdate } from "../../components/updateChecker";
import { serializeParams } from "../../components/routerParams";
import { readSources, readSettings, readCookie } from "../../components/storage";
import { safeJsonParse } from "../../components/jsonUtils";
import { apiFetch, buildDetailUrl, getFetchErrorType } from "../../components/api";

const { getTime } = global;

export default {
  private: {
    context: "",
    hide: true,
    time: "",
    currentSourceName: global.API_SETTING[global.API_SETTING.using].name,
    API_SETTING: global.API_SETTING,
    display: global.display,
  },

  onBackPress() {
    if (this.hide) {
      return false;
    } else {
      this.hide = !this.hide;
      return true;
    }
  },

  onShow() {
    this.time = getTime();
    // 源/设置的全部写入路径（edit 增删、about saveSetting、AstroBox 同步）都会同步
    // global，文件只在 onInit 冷启动读一次；但 global 变更不会触发本页重渲染，
    // 所以每次回首页仍要把 global 同步进 viewModel（纯赋值，零 IO）
    this.API_SETTING = global.API_SETTING;
    this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
    if (global.update) {
      this.checkAppUpdate();
    }
  },

  onInit() {
    // 仅冷启动静默清理一次临时文件（onShow 每次回首页都触发太频繁且弹 toast）；
    // 进程刚启动时不可能有下载在进行，天然避开在途下载的临时文件
    this.cleanTempFiles();
    // sources/settings 文件仅冷启动读一次入 global；此后所有变更（edit 增删源、
    // about 改设置、AstroBox 同步）都先写文件再同步 global，内存即真相
    readSources()
      .then((datas) => {
        datas.forEach((newSourceConfig) => {
          const newKey = Object.keys(newSourceConfig)[0];
          global.API_SETTING[newKey] = newSourceConfig[newKey];
        });
      })
      .catch(() => {})
      .then(() => {
        this.API_SETTING = global.API_SETTING;
        this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
      });
    readSettings()
      .then((datas) => {
        global.APP_SETTING = Object.assign(global.APP_SETTING, datas);
        global.applyDeviceRecommendedSettings();
      })
      .catch(() => {
        global.applyDeviceRecommendedSettings();
      });
    readCookie()
      .then((cookie) => {
        global.cookie = cookie;
      })
      .catch(() => {
        global.cookie = {};
      });

    const connect = getConnection();
    if (connect) {
      const bridge = createDataBridge(connect);

      bridge.onSourceConfigSaved = () => {
        this.API_SETTING = global.API_SETTING;
        this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
      };

      // onmessage 由 interconnectHub 统一分发，注册数据桥处理器即可
      registerBridgeHandler(bridge.handleMessage);
      this._bridge = bridge;
    }

    brightness.setKeepScreenOn({
      keepScreenOn: true,
    });
  },

  cleanTempFiles() {
    file.list({
      uri: "internal://files",
      success: (data) => {
        const files = data.fileList || [];
        const keepFiles = [
          "comics.json",
          "settings.json",
          "cookie.json",
          "sources.json",
          "history.json",
        ];

        const filesToDelete = files.filter(function (item) {
          const fileName = item.uri.split("/").pop();
          return !keepFiles.includes(fileName) && item.type !== "dir";
        });

        if (filesToDelete.length > 0) {
          filesToDelete.forEach(function (item) {
            file.delete({
              uri: item.uri,
              fail: function (errData, code) {
                console.debug("删除临时文件失败: " + item.uri + ", code=" + code);
              },
            });
          });
          // 静默清理，不弹 toast 打扰用户
          console.debug("已清理临时文件: " + filesToDelete.length + " 个");
        }
      },
      fail: function (errData, code) {
        console.debug("列出临时文件失败, code=" + code);
      },
    });
  },

  checkAppUpdate() {
    if (global.updateChecking || global.updatePageShowing) return;
    global.updateChecking = true;
    checkUpdate().then((info) => {
      global.updateChecking = false;
      if (!info || global.updatePageShowing) return;
      global.updatePageShowing = true;
      global.update = false;
      if (info.forceUpdate) {
        router.replace({
          uri: "/pages/update",
        });
      } else {
        router.push({
          uri: "/pages/update",
        });
      }
    });
  },

  deleteit() {
    this.context = this.context.slice(0, -1);
  },

  changeState() {
    this.hide = !this.hide;
    if (this.hide) {
      if (this.context == "") {
        prompt.showToast({
          message: this.$t("tip"),
          duration: 3000,
        });
        return;
      }
      prompt.showToast({
        message: this.$t("loading"),
        duration: 5000,
      });
      if (/^\d{1,20}$/.test(this.context)) {
        this.getAlbum();
      } else {
        router.push({
          uri: "/pages/search",
          params: {
            keyword: this.context.trim(),
          },
        });
      }
    }
  },

  complete(evt) {
    this.context += evt.detail.content;
  },

  toAlbum(data) {
    router.push({
      uri: "/pages/album",
      params: serializeParams(data),
    });
  },

  getAlbum() {
    apiFetch({
      url: buildDetailUrl(this.context),
      responseType: "json",
      success: (response) => {
        if (!response.data || typeof response.data !== "object") {
          prompt.showToast({
            message: this.$t("error.invalidResponse"),
            duration: 3000,
          });
          return;
        }
        this.toAlbum(response.data);
      },
      fail: (data, code) => {
        console.debug(`handling fail, errMsg = ${data}`);
        const parsed = safeJsonParse(data, null);
        if (parsed && parsed.message && parsed.message.indexOf("请求的本子不存在") != -1) {
          prompt.showToast({
            message: this.$t("error.noComicFound"),
            duration: 3000,
          });
          return;
        }
        if (getFetchErrorType(code) === "timeout") {
          prompt.showToast({
            message: this.$t("error.networkError"),
            duration: 3000,
          });
        } else {
          prompt.showToast({
            message: this.$t("error.networkError") + data,
            duration: 3000,
          });
        }
      },
    });
  },

  toggleSource() {
    const sources = Object.keys(global.API_SETTING);
    const currentIndex = sources.indexOf(global.API_SETTING.using);
    const nextIndex = (currentIndex + 1) % sources.length;
    const nextSourceKey = sources[nextIndex];

    global.API_SETTING.using = nextSourceKey;
    if (global.API_SETTING.using === "using") {
      this.toggleSource();
      return;
    }
    this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
  },

  routeBack() {
    if (this.hide) {
      router.back();
    } else {
      this.hide = !this.hide;
    }
  },

  routeAbout() {
    router.push({
      uri: "/pages/about",
    });
  },

  routeEdit() {
    router.push({
      uri: "/pages/edit",
    });
  },

  routeOffline() {
    router.push({
      uri: "/pages/offline",
    });
  },
};
</script>

<style>
@import "../../common/base.css";

.demo-page {
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.line {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 70%;
}

.input-line {
  height: 54px;
  width: 256px;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 100%;
  align-items: center;
  justify-content: center;
}

.source-selector {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: 88px;
}
.source-text {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 10px;
}
.source-button {
  height: 36px;
  padding: 0 15px;
  background-color: #262626;
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;
  justify-content: center;
  align-items: center;
}

.donate {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000;
}

.input-text {
  lines: 1;
  position: absolute;
  padding: 0 12px;
}

/* 看看是不是小米手表s3/s4 */
@media (min-width: 200) and (max-width: 235) and (shape: circle) {
  .bottom {
    left: 182px;
    position: absolute;
    bottom: 6px;
  }
}

/* 看看是不是小米手表s1 pro */
@media (min-width: 235) and (max-width: 250) and (shape: circle) {
  .bottom {
    left: 189px;
    position: absolute;
    bottom: 6px;
  }
}
</style>
