<template>
  <div class="demo-page">
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/info.png"
      @click="routeAbout"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton bottom"
      src="/common/More_B.png"
      @click="routeOffline"
    />
    <img
      if.static="{{ global.screenShape == 'circle' }}"
      class="bottom"
      src="/common/more_s4.png"
      @click="routeOffline"
    />
    <text class="time">{{ time }}</text>
    <text class="title" if.static="{{ global.screenShape == 'circle' }}" @click="routeAbout">
      {{ $t("appName") }}
    </text>
    <text class="title" if.static="{{ global.screenShape != 'circle' }}">
      {{ $t("appName") }}
    </text>

    <div class="line" style="margin-bottom: 10px">
      <text static style="margin-bottom: 4px">{{ $t("elsePlaceholder") }}</text>
      <div class="input-line" @click="openIme">
        <scroll
          style="position: absolute; width: 100%; height: 42px; margin: 6px 0"
          scroll-x="true"
        >
          <text class="input-text">
            {{ context }}
          </text>
        </scroll>
      </div>
      <scroll class="history-scroll" scroll-x="true" if="{{ historyList.length > 0 }}">
        <div class="history-chips">
          <text
            for="{{ word in historyList.slice(0, 5) }}"
            class="history-chip"
            @click="searchFromHistory(word)"
          >
            {{ word }}
          </text>
          <div class="history-spacer"></div>
          <image static class="history-clear" src="/common/del.png" @click="clearHistory"></image>
        </div>
      </scroll>
      <text class="home-tip" if="{{ historyList.length == 0 }}">{{ $t("homeTip") }}</text>
    </div>

    <div class="source-selector">
      <text class="source-text">{{ $t("currentSourceName") }}{{ currentSourceName }}</text>
      <text if="{{ Object.keys(API_SETTING).length > 2 }}" class="iconfont" @click="toggleSource">
        &#xe628;
      </text>
      <text class="iconfont" @click="routeEdit" static>&#xe607;</text>
    </div>

    <div
      class="donate"
      if="{{ display }}"
      @click="
        () => {
          display = false;
          global.display = false;
          global.donateShown = true;
        }
      "
    >
      <image static src="/common/donate.png" />
      <text static style="color: #fff; font-weight: bold">{{ $t("donate") }}</text>
      <text static style="color: rgba(255, 255, 255, 0.6); font-size: 20px; font-weight: bold">
        {{ $t("donateHint") }}
      </text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";
import brightness from "@system.brightness";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { createDataBridge } = global.$bridge;
const { getConnection, registerBridgeHandler } = global.$hub;
const { checkUpdate } = global;
const { serializeParams } = global.$route;
const {
  readSources,
  readSettings,
  readCookie,
  readSearchHistory,
  addSearchHistory,
  clearSearchHistory,
  setRecoveryNotifier,
  FILE_ERROR,
} = global.$storage;
const { apiFetch, buildDetailUrl, mergeSourcesToGlobal, getCurrentSourceName, isComicDetailResponse, isComicId, captureSource, saveSourceContext, formatApiError } = global.$api;

const { getTime, createConfirmGuard } = global;

// 清空搜索历史的二次确认守卫（与 offline/edit 删除确认同一组件）
const confirmClearHistory = createConfirmGuard();

function isMissingStorageFile(error) {
  return !!(error && error.code === FILE_ERROR.NOT_FOUND);
}

export default {
  private: {
    context: "",
    time: "",
    currentSourceName: getCurrentSourceName(),
    API_SETTING: global.API_SETTING,
    // 冷启动先压住捐赠，确认 oobeDone 后再放行（首次进入快速检查）
    display: false,
    historyList: [], // 搜索历史（最新在前），onInit 冷启动读一次，本页是唯一写入方
  },

  onBackPress() {
    return false;
  },

  onShow() {
    this.time = getTime();
    // 输入法页面回传：确认走提交流程，取消仅保留文本
    const imeResult = global.__imeResult;
    if (imeResult) {
      global.__imeResult = null;
      this.context = imeResult.text;
      if (imeResult.confirmed) {
        this.submitSearch();
      }
    }
    // 源/设置的全部写入路径（edit 增删、about saveSetting、AstroBox 同步）都会同步
    // global，文件只在 onInit 冷启动读一次；但 global 变更不会触发本页重渲染，
    // 所以每次回首页仍要把 global 同步进 viewModel（纯赋值，零 IO）
    this.API_SETTING = global.API_SETTING;
    this.currentSourceName = getCurrentSourceName();
    if (global.update) {
      this.checkAppUpdate();
    }
  },

  onDestroy() {
    if (this._unregisterRecoveryNotifier) {
      this._unregisterRecoveryNotifier();
      this._unregisterRecoveryNotifier = null;
    }
  },

  onInit() {
    // 损坏 JSON 自愈通知器重新注入（P0-15）：刷新页面绑定，dataBridge 同步等
    // 中后段损坏也能即时提示（boot.ux 启动期已注册过一次）
    this._unregisterRecoveryNotifier = setRecoveryNotifier((name) => {
      prompt.showToast({
        message: this.$t("storage.fileRecovered", { name }),
        duration: 3000,
      });
    });
    // 仅冷启动静默清理一次临时文件（onShow 每次回首页都触发太频繁且弹 toast）；
    // 进程刚启动时不可能有下载在进行，天然避开在途下载的临时文件
    this.cleanTempFiles();
    // 捐赠：启动页 bootstrap 已加载设置，这里同步放行，不等二次 readSettings（避免延迟弹出）
    if (!global.donateShown) {
      global.display = true;
      this.display = true;
    }
    // Boot records readiness per file so a timeout or partial failure only rereads
    // unfinished data. Direct index entry starts with all three fields not ready.
    const dataStatus =
      global.bootstrapDataStatus ||
      (global.bootstrapDataStatus = { settings: false, sources: false, cookie: false });
    if (typeof dataStatus.sources !== "boolean") dataStatus.sources = false;
    if (typeof dataStatus.settings !== "boolean") dataStatus.settings = false;
    if (typeof dataStatus.cookie !== "boolean") dataStatus.cookie = false;

    const syncSourceView = () => {
      this.API_SETTING = global.API_SETTING;
      this.currentSourceName = getCurrentSourceName();
    };
    if (dataStatus.sources) {
      syncSourceView();
    } else {
      readSources()
        .then((datas) => {
          mergeSourcesToGlobal(Array.isArray(datas) ? datas : []);
          dataStatus.sources = true;
        })
        .catch((error) => {
          if (isMissingStorageFile(error)) dataStatus.sources = true;
        })
        .then(syncSourceView);
    }

    if (dataStatus.settings) {
      global.applyDeviceRecommendedSettings();
    } else {
      readSettings()
        .then((datas) => {
          global.APP_SETTING = Object.assign(global.APP_SETTING, datas || {});
          dataStatus.settings = true;
        })
        .catch((error) => {
          if (isMissingStorageFile(error)) dataStatus.settings = true;
        })
        .then(() => {
          global.applyDeviceRecommendedSettings();
        });
    }

    if (dataStatus.cookie) {
      global.cookie = global.cookie || {};
    } else {
      readCookie()
        .then((cookie) => {
          global.cookie = cookie || {};
          dataStatus.cookie = true;
        })
        .catch((error) => {
          global.cookie = {};
          if (isMissingStorageFile(error)) dataStatus.cookie = true;
        });
    }
    // 搜索历史仅本页读写，冷启动读一次后内存即真相
    readSearchHistory()
      .then((list) => {
        this.historyList = Array.isArray(list) ? list.filter((k) => typeof k === "string") : [];
      })
      .catch(() => {});

    const connect = getConnection();
    if (connect) {
      const bridge = createDataBridge(connect);

      bridge.onSourceConfigSaved = () => {
        this.API_SETTING = global.API_SETTING;
        this.currentSourceName = getCurrentSourceName();
      };

      // onmessage 由 interconnectHub 统一分发，注册数据桥处理器即可
      registerBridgeHandler(bridge.handleMessage);
      this._bridge = bridge;
    }

    brightness.setKeepScreenOn({
      keepScreenOn: true,
    });
  },

  cleanTempFiles() {
    global.$storage
      .cleanTempFiles()
      .then((res) => {
        if (res && res.count > 0) {
          console.debug("已清理临时文件: " + res.count + " 个");
        }
      })
      .catch((err) => {
        console.debug("列出临时文件失败, code=" + (err && err.code));
      });
  },

  checkAppUpdate() {
    if (global.updateChecking || global.updatePageShowing) return;
    global.updateChecking = true;
    checkUpdate().then((info) => {
      global.updateChecking = false;
      // 网络失败 {failed:true} 与"无更新"区分（P2-35③ 随 P1-15 落地）：不弹更新页
      if (!info || info.failed || global.updatePageShowing) return;
      global.updatePageShowing = true;
      global.update = false;
      // 强更/非强更统一 push（P1-15）：强更由隐藏返回键 + onBackPress 吞返把守；
      // 保留首页在栈内，update 页「重新检查」撤回强更后才能正常 router.back() 返回
      router.push({
        uri: "/pages/update",
      });
    });
  },

  openIme() {
    global.__imeText = this.context;
    global.__imeLabel = this.$t("elsePlaceholder");
    router.push({
      uri: "/pages/ime",
    });
  },

  submitSearch() {
    if (this.context == "") {
      prompt.showToast({
        message: this.$t("tip"),
        duration: 3000,
      });
      return;
    }
    const keyword = this.context.trim();
    if (keyword) {
      this.recordSearchHistory(keyword);
    }
    prompt.showToast({
      message: this.$t("loading"),
      duration: 5000,
    });
    const sourceContext = captureSource();
    if (isComicId(keyword, sourceContext.source, sourceContext.key)) {
      this.getAlbum();
    } else {
      router.push({
        uri: "/pages/search",
        params: {
          keyword: this.context.trim(),
          sourceToken: saveSourceContext(sourceContext),
        },
      });
    }
  },

  // 记录搜索关键词：先乐观更新本地列表（去重置顶，上限与存储层一致），
  // 落盘完成后以文件内容校对一次；写盘失败仅记日志，不影响搜索主流程
  recordSearchHistory(keyword) {
    this.historyList = [keyword].concat(this.historyList.filter((k) => k !== keyword)).slice(0, 5);
    addSearchHistory(keyword)
      .then((list) => {
        this.historyList = Array.isArray(list) ? list : [];
      })
      .catch((e) => {
        console.debug("搜索历史写入失败: " + (e && e.code));
      });
  },

  searchFromHistory(keyword) {
    this.context = keyword;
    this.submitSearch();
  },

  clearHistory() {
    if (!confirmClearHistory("searchHistory", this.$t("search.historyClear"), { duration: 2000 })) {
      return;
    }
    this.historyList = [];
    clearSearchHistory().catch((e) => {
      console.debug("搜索历史清空失败: " + (e && e.code));
    });
  },

  toAlbum(data) {
    router.push({
      uri: "/pages/album",
      params: serializeParams(data),
    });
  },

  getAlbum() {
    const sourceContext = captureSource();
    apiFetch({
      url: buildDetailUrl(this.context.trim(), sourceContext.source),
      sourceContext: sourceContext,
      responseType: "json",
      success: (response) => {
        if (!isComicDetailResponse(response)) {
          prompt.showToast({
            message: this.$t("error.invalidResponse"),
            duration: 3000,
          });
          return;
        }
        this.toAlbum({ ...response.data, sourceToken: saveSourceContext(sourceContext) });
      },
      fail: (data, code) => {
        console.debug(`handling fail, errMsg = ${data}, code = ${code}`);
        const errorInfo = formatApiError(data, code, {
          sourceKey: sourceContext.key,
          t: (k, p) => this.$t(k, p),
        });
        prompt.showToast({
          message: errorInfo.formatted,
          duration: 4000,
        });
      },
    });
  },

  toggleSource() {
    const sources = Object.keys(global.API_SETTING);
    const currentIndex = sources.indexOf(global.API_SETTING.using);
    const nextIndex = (currentIndex + 1) % sources.length;
    const nextSourceKey = sources[nextIndex];

    global.API_SETTING.using = nextSourceKey;
    if (global.API_SETTING.using === "using") {
      this.toggleSource();
      return;
    }
    this.currentSourceName = getCurrentSourceName();
  },

  routeBack() {
    router.back();
  },

  routeAbout() {
    router.push({
      uri: "/pages/about",
    });
  },

  routeEdit() {
    router.push({
      uri: "/pages/edit",
    });
  },

  routeOffline() {
    router.push({
      uri: "/pages/offline",
    });
  },
};
</script>

<style>
@import "../../common/base.css";

.demo-page {
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.line {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 70%;
}

.input-line {
  height: 54px;
  width: 256px;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 100%;
  align-items: center;
  justify-content: center;
}

.source-selector {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: 88px;
}

/* 首次空态引导（P2-31）：无搜索历史时占位在输入行下方，首搜后自动消失 */
.home-tip {
  width: 256px;
  font-size: 20px;
  color: rgba(255, 255, 255, 0.45);
  font-weight: bold;
  text-align: center;
  margin-top: 10px;
  flex-shrink: 0;
}
.source-text {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 10px;
}

.donate {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000;
}

.input-text {
  lines: 1;
  position: absolute;
  padding: 0 12px;
}

/* 搜索历史条：输入行下方横向滚动，词条自适应宽度 */
.history-scroll {
  width: 256px;
  height: 48px;
  margin-top: 10px;
}

/* min-width 大于 scroll 可视宽（256）+ 清空按钮（36+4），词条少时由 spacer 把
   清空按钮挤出首屏可视区（右滑 ~44px 才可达），词条多时 spacer 收缩为 0 自然排布 */
.history-chips {
  flex-direction: row;
  align-items: center;
  min-width: 300px;
}

.history-spacer {
  flex-grow: 1;
  height: 1px;
}

.history-chip {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.85);
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 24px;
  padding: 2px 10px;
  margin-right: 8px;
  lines: 1;
  flex-shrink: 0;
}

.history-clear {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  margin-right: 4px;
}

/* 看看是不是小米手表s3/s4 */
@media (min-width: 200) and (max-width: 235) and (shape: circle) {
  .bottom {
    left: 182px;
    position: absolute;
    bottom: 6px;
  }
}

/* 看看是不是小米手表s1 pro */
@media (min-width: 235) and (max-width: 250) and (shape: circle) {
  .bottom {
    left: 189px;
    position: absolute;
    bottom: 6px;
  }
}
</style>
