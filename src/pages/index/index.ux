<template>
  <div class="demo-page">
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="leftButton top"
      src="/common/back.png"
      @click="routeBack"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton top"
      src="/common/info.png"
      @click="routeAbout"
    />
    <img
      if.static="{{ global.screenShape != 'circle' }}"
      class="rightButton bottom"
      src="/common/More_B.png"
      @click="routeOffline"
    />
    <img
      if.static="{{ global.screenShape == 'circle' }}"
      class="bottom"
      src="/common/more_s4.png"
      @click="routeOffline"
    />
    <text class="time">{{ time }}</text>
    <text class="title" if.static="{{ global.screenShape == 'circle' }}" @click="routeAbout">
      {{ $t("appName") }}
    </text>
    <text class="title" if.static="{{ global.screenShape != 'circle' }}">
      {{ $t("appName") }}
    </text>

    <div class="line" style="margin-bottom: 10px">
      <text static style="margin-bottom: 4px">{{ $t("elsePlaceholder") }}</text>
      <div class="input-line" @click="openIme">
        <scroll
          style="position: absolute; width: 100%; height: 42px; margin: 6px 0"
          scroll-x="true"
        >
          <text class="input-text">
            {{ context }}
          </text>
        </scroll>
      </div>
      <scroll class="history-scroll" scroll-x="true" if="{{ historyList.length > 0 }}">
        <div class="history-chips">
          <text
            for="{{ word in historyList.slice(0, 5) }}"
            class="history-chip"
            @click="searchFromHistory(word)"
          >
            {{ word }}
          </text>
          <div class="history-spacer"></div>
          <image static class="history-clear" src="/common/del.png" @click="clearHistory"></image>
        </div>
      </scroll>
    </div>

    <div class="source-selector">
      <text class="source-text">{{ $t("currentSourceName") }}{{ currentSourceName }}</text>
      <text if="{{ Object.keys(API_SETTING).length > 2 }}" class="iconfont" @click="toggleSource">
        &#xe628;
      </text>
      <text class="iconfont" @click="routeEdit" static>&#xe607;</text>
    </div>

    <div
      class="donate"
      if="{{ display }}"
      @click="
        () => {
          display = false;
          global.display = false;
        }
      "
    >
      <image static src="/common/donate.png" />
      <text static style="color: #fff; font-weight: bold">{{ $t("donate") }}</text>
      <text static style="color: rgba(255, 255, 255, 0.6); font-size: 20px; font-weight: bold">
        {{ $t("donateHint") }}
      </text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import prompt from "@system.prompt";
import brightness from "@system.brightness";
import file from "@system.file";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { createDataBridge } = global.$bridge;
const { getConnection, registerBridgeHandler } = global.$hub;
const { checkUpdate } = global;
const { serializeParams } = global.$route;
const {
  readSources,
  readSettings,
  readCookie,
  readSearchHistory,
  addSearchHistory,
  clearSearchHistory,
} = global.$storage;
const { safeJsonParse } = global.$json;
const { apiFetch, buildDetailUrl, getFetchErrorType, mergeSourcesToGlobal } = global.$api;

const { getTime, createConfirmGuard } = global;

// 清空搜索历史的二次确认守卫（与 offline/edit 删除确认同一组件）
const confirmClearHistory = createConfirmGuard();

export default {
  private: {
    context: "",
    time: "",
    currentSourceName: global.API_SETTING[global.API_SETTING.using].name,
    API_SETTING: global.API_SETTING,
    display: global.display,
    historyList: [], // 搜索历史（最新在前），onInit 冷启动读一次，本页是唯一写入方
  },

  onBackPress() {
    return false;
  },

  onShow() {
    this.time = getTime();
    // 输入法页面回传：确认走提交流程，取消仅保留文本
    const imeResult = global.__imeResult;
    if (imeResult) {
      global.__imeResult = null;
      this.context = imeResult.text;
      if (imeResult.confirmed) {
        this.submitSearch();
      }
    }
    // 源/设置的全部写入路径（edit 增删、about saveSetting、AstroBox 同步）都会同步
    // global，文件只在 onInit 冷启动读一次；但 global 变更不会触发本页重渲染，
    // 所以每次回首页仍要把 global 同步进 viewModel（纯赋值，零 IO）
    this.API_SETTING = global.API_SETTING;
    this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
    if (global.update) {
      this.checkAppUpdate();
    }
  },

  onInit() {
    // 仅冷启动静默清理一次临时文件（onShow 每次回首页都触发太频繁且弹 toast）；
    // 进程刚启动时不可能有下载在进行，天然避开在途下载的临时文件
    this.cleanTempFiles();
    // sources/settings 文件仅冷启动读一次入 global；此后所有变更（edit 增删源、
    // about 改设置、AstroBox 同步）都先写文件再同步 global，内存即真相
    readSources()
      .then((datas) => {
        mergeSourcesToGlobal(datas);
      })
      .catch(() => {})
      .then(() => {
        this.API_SETTING = global.API_SETTING;
        this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
      });
    readSettings()
      .then((datas) => {
        global.APP_SETTING = Object.assign(global.APP_SETTING, datas);
        global.applyDeviceRecommendedSettings();
      })
      .catch(() => {
        global.applyDeviceRecommendedSettings();
      });
    readCookie()
      .then((cookie) => {
        global.cookie = cookie;
      })
      .catch(() => {
        global.cookie = {};
      });
    // 搜索历史仅本页读写，冷启动读一次后内存即真相
    readSearchHistory()
      .then((list) => {
        this.historyList = Array.isArray(list) ? list.filter((k) => typeof k === "string") : [];
      })
      .catch(() => {});

    const connect = getConnection();
    if (connect) {
      const bridge = createDataBridge(connect);

      bridge.onSourceConfigSaved = () => {
        this.API_SETTING = global.API_SETTING;
        this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
      };

      // onmessage 由 interconnectHub 统一分发，注册数据桥处理器即可
      registerBridgeHandler(bridge.handleMessage);
      this._bridge = bridge;
    }

    brightness.setKeepScreenOn({
      keepScreenOn: true,
    });
  },

  cleanTempFiles() {
    file.list({
      uri: "internal://files",
      success: (data) => {
        const files = data.fileList || [];
        const keepFiles = [
          "comics.json",
          "settings.json",
          "cookie.json",
          "sources.json",
          "history.json",
          "search_history.json",
        ];

        const filesToDelete = files.filter(function (item) {
          const fileName = item.uri.split("/").pop();
          return !keepFiles.includes(fileName) && item.type !== "dir";
        });

        if (filesToDelete.length > 0) {
          filesToDelete.forEach(function (item) {
            file.delete({
              uri: item.uri,
              fail: function (errData, code) {
                console.debug("删除临时文件失败: " + item.uri + ", code=" + code);
              },
            });
          });
          // 静默清理，不弹 toast 打扰用户
          console.debug("已清理临时文件: " + filesToDelete.length + " 个");
        }
      },
      fail: function (errData, code) {
        console.debug("列出临时文件失败, code=" + code);
      },
    });
  },

  checkAppUpdate() {
    if (global.updateChecking || global.updatePageShowing) return;
    global.updateChecking = true;
    checkUpdate().then((info) => {
      global.updateChecking = false;
      if (!info || global.updatePageShowing) return;
      global.updatePageShowing = true;
      global.update = false;
      if (info.forceUpdate) {
        router.replace({
          uri: "/pages/update",
        });
      } else {
        router.push({
          uri: "/pages/update",
        });
      }
    });
  },

  openIme() {
    global.__imeText = this.context;
    global.__imeLabel = this.$t("elsePlaceholder");
    router.push({
      uri: "/pages/ime",
    });
  },

  submitSearch() {
    if (this.context == "") {
      prompt.showToast({
        message: this.$t("tip"),
        duration: 3000,
      });
      return;
    }
    const keyword = this.context.trim();
    if (keyword) {
      this.recordSearchHistory(keyword);
    }
    prompt.showToast({
      message: this.$t("loading"),
      duration: 5000,
    });
    if (/^\d{1,20}$/.test(this.context)) {
      this.getAlbum();
    } else {
      router.push({
        uri: "/pages/search",
        params: {
          keyword: this.context.trim(),
        },
      });
    }
  },

  // 记录搜索关键词：先乐观更新本地列表（去重置顶，上限与存储层一致），
  // 落盘完成后以文件内容校对一次；写盘失败仅记日志，不影响搜索主流程
  recordSearchHistory(keyword) {
    this.historyList = [keyword].concat(this.historyList.filter((k) => k !== keyword)).slice(0, 5);
    addSearchHistory(keyword)
      .then((list) => {
        this.historyList = Array.isArray(list) ? list : [];
      })
      .catch((e) => {
        console.debug("搜索历史写入失败: " + (e && e.code));
      });
  },

  searchFromHistory(keyword) {
    this.context = keyword;
    this.submitSearch();
  },

  clearHistory() {
    if (!confirmClearHistory("searchHistory", this.$t("search.historyClear"), { duration: 2000 })) {
      return;
    }
    this.historyList = [];
    clearSearchHistory().catch((e) => {
      console.debug("搜索历史清空失败: " + (e && e.code));
    });
  },

  toAlbum(data) {
    router.push({
      uri: "/pages/album",
      params: serializeParams(data),
    });
  },

  getAlbum() {
    apiFetch({
      url: buildDetailUrl(this.context),
      responseType: "json",
      success: (response) => {
        if (!response.data || typeof response.data !== "object") {
          prompt.showToast({
            message: this.$t("error.invalidResponse"),
            duration: 3000,
          });
          return;
        }
        this.toAlbum(response.data);
      },
      fail: (data, code) => {
        console.debug(`handling fail, errMsg = ${data}`);
        const parsed = safeJsonParse(data, null);
        if (parsed && parsed.message && parsed.message.indexOf("请求的本子不存在") != -1) {
          prompt.showToast({
            message: this.$t("error.noComicFound"),
            duration: 3000,
          });
          return;
        }
        if (getFetchErrorType(code) === "timeout") {
          prompt.showToast({
            message: this.$t("error.networkError"),
            duration: 3000,
          });
        } else {
          prompt.showToast({
            message: this.$t("error.networkError") + data,
            duration: 3000,
          });
        }
      },
    });
  },

  toggleSource() {
    const sources = Object.keys(global.API_SETTING);
    const currentIndex = sources.indexOf(global.API_SETTING.using);
    const nextIndex = (currentIndex + 1) % sources.length;
    const nextSourceKey = sources[nextIndex];

    global.API_SETTING.using = nextSourceKey;
    if (global.API_SETTING.using === "using") {
      this.toggleSource();
      return;
    }
    this.currentSourceName = global.API_SETTING[global.API_SETTING.using].name;
  },

  routeBack() {
    router.back();
  },

  routeAbout() {
    router.push({
      uri: "/pages/about",
    });
  },

  routeEdit() {
    router.push({
      uri: "/pages/edit",
    });
  },

  routeOffline() {
    router.push({
      uri: "/pages/offline",
    });
  },
};
</script>

<style>
@import "../../common/base.css";

.demo-page {
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.line {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 70%;
}

.input-line {
  height: 54px;
  width: 256px;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 100%;
  align-items: center;
  justify-content: center;
}

.source-selector {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: 88px;
}
.source-text {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 10px;
}

.donate {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000;
}

.input-text {
  lines: 1;
  position: absolute;
  padding: 0 12px;
}

/* 搜索历史条：输入行下方横向滚动，词条自适应宽度 */
.history-scroll {
  width: 256px;
  height: 48px;
  margin-top: 10px;
}

/* min-width 大于 scroll 可视宽（256）+ 清空按钮（36+4），词条少时由 spacer 把
   清空按钮挤出首屏可视区（右滑 ~44px 才可达），词条多时 spacer 收缩为 0 自然排布 */
.history-chips {
  flex-direction: row;
  align-items: center;
  min-width: 300px;
}

.history-spacer {
  flex-grow: 1;
  height: 1px;
}

.history-chip {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.85);
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 24px;
  padding: 2px 10px;
  margin-right: 8px;
  lines: 1;
  flex-shrink: 0;
}

.history-clear {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  margin-right: 4px;
}

/* 看看是不是小米手表s3/s4 */
@media (min-width: 200) and (max-width: 235) and (shape: circle) {
  .bottom {
    left: 182px;
    position: absolute;
    bottom: 6px;
  }
}

/* 看看是不是小米手表s1 pro */
@media (min-width: 235) and (max-width: 250) and (shape: circle) {
  .bottom {
    left: 189px;
    position: absolute;
    bottom: 6px;
  }
}
</style>
