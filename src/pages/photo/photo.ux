<template>
  <div class="demo-page">
    <img
      if="{{ showit && global.screenShape == 'circle' }}"
      src="/common/mask.png"
      class="leftButton"
    />
    <img
      if="{{ showit&& global.screenShape == 'circle' }}"
      src="/common/mask.png"
      class="rightButton"
    />
    <scroll
      id="scrollId"
      class="box"
      scroll-x="true"
      scroll-y="true"
      bounces="true"
      @scroll="onScroll"
    >
      <div @click="showButton" if="{{ images }}" class="padding"></div>
      <div
        if="{{ images }}"
        style="{{ `width:100%; height:${Math.max(0, (global.screenSize.height - size.height * (1 + scale / 100 * 2))/
2 + 2)}px;` }}"
      ></div>
      <image
        if="{{ images }}"
        class="cover"
        src="{{ images }}"
        @complete="getPhoto"
        alt="blank"
        @error="
          () => {
            if (images != '') {
              loading = '';
              images = '';
            }
          }
        "
        @click="showButton"
        style="{{ `width:${size.width * (1 + scale / 100 * 2)}px;height:${size.height * (1 + scale / 100 * 2)}px;` }}"
      ></image>
      <div
        if="{{ images }}"
        style="{{ `width:100%; height:${Math.max(0, (global.screenSize.height - size.height * (1 + scale / 100 * 2))/
2 + 2)}px;` }}"
      ></div>
      <div @click="showButton" if="{{ images }}" class="padding"></div>
    </scroll>

    <div if="{{ !images }}" class="state-wrap" @click="showButton">
      <image
        class="state-img"
        src="{{ loading == 'end' ? '/common/end.png' : loading ? '/common/loading.png' : '/common/error.png' }}"
      ></image>
    </div>

    <img
      if="{{ showit }}"
      src="/common/upCover.png"
      style="position: absolute; top: 0px; width: {{ global.screenSize.width }}px;"
    />
    <img
      if="{{ showit }}"
      src="/common/bottomCover.png"
      style="position: absolute; bottom: 0px; width: {{ global.screenSize.width }}px;"
    />

    <!-- 方表适配 -->
    <img
      if="{{ showit && global.screenShape != 'circle' }}"
      src="/common/left.png"
      onclick="toPage('-')"
      class="leftButton bottom"
    />
    <img
      if="{{ showit && global.screenShape != 'circle' }}"
      src="/common/right.png"
      onclick="toPage('+')"
      class="rightButton bottom"
    />

    <!-- 圆表适配 -->
    <img
      if="{{ showit && global.screenShape == 'circle' }}"
      src="/common/left_s4.png"
      onclick="toPage('-')"
      class="leftButton"
    />
    <img
      if="{{ showit&& global.screenShape == 'circle' }}"
      src="/common/right_s4.png"
      onclick="toPage('+')"
      class="rightButton"
    />

    <div class="com" if="{{ showSlider }}">
      <div class="shade">
        <div if="{{ total_chapters > 1 }}" class="chapter">
          <img src="/common/left.png" onclick="toChapter('-')" class="" />
          <marquee class="subtitle" scrollamount="{{ 20 }}" text-offset="{{ 20 }}">
            {{ title }}
          </marquee>
          <img src="/common/right.png" onclick="toChapter('+')" class="" />
        </div>
        <text class="subtitle" if="{{ total_chapters > 1 }}">
          {{ $t("photo.chapterChange") }}
        </text>
        <div if="{{ total_chapters > 1 }}" style="height: 10px"></div>
        <div
          if="{{ total_chapters > 1 }}"
          style="flex-direction: row; justify-content: space-around; height: 40px"
        >
          <picker
            for="pickerValue in pickerValues"
            type="text"
            style="width:{{ 80/pickerValues.length }}%; selected-font-size: 32px;"
            range="{{ pickerValue }}"
            selected="{{ chapter.toString().padStart(pickerValues.length, '0')[$idx] }}"
            onchange="onPickerChange($idx)"
          ></picker>
        </div>
        <div if="{{ total_chapters > 1 }}" style="height: 20px"></div>
        <text static class="subtitle">{{ $t("photo.photoSizeChange") }}</text>
        <div static style="height: 10px"></div>
        <slider
          class="slider"
          min="0"
          max="100"
          step="1"
          value="{{ scale }}"
          onchange="onSliderChange"
        ></slider>
        <div static style="height: 10px"></div>
      </div>
    </div>

    <img
      if="{{ showit && global.screenShape != 'circle' }}"
      src="/common/left.png"
      @click="routeBack"
      class="leftButton top"
    />
    <img
      if="{{ showit && global.screenShape != 'circle' }}"
      src="/common/more.png"
      class="rightButton top"
      @click="() => (showSlider = !showSlider)"
    />
    <img
      if="{{ showit && global.screenShape == 'circle' }}"
      src="/common/check.png"
      class="bottom"
      @click="() => (showSlider = !showSlider)"
    />

    <text class="time" if="{{ showit }}">{{ time }}</text>
    <text
      class="title"
      @click="
        () => {
          if (global.screenShape == 'circle') {
            routeBack();
          }
        }
      "
      if="{{ showit }}"
    >
      <span class="iconfont" if="{{ global.screenShape == 'circle' }}">&#xe685;</span>
      <span>
        {{ $t("photo.page", { page: page > page_count ? page_count : page }) }}
      </span>
    </text>
  </div>
</template>

<script>
import router from "@system.router";
import file from "@system.file";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { addImageParams, appendLvglSuffix } = global.$img;
const { parseParam } = global.$route;
const { readHistory, updateJsonFile, HISTORY_URI } = global.$storage;
const { apiFetch, buildPhotoUrl } = global.$api;

const { screenSize, getTime } = global;

let ImageCache = [];
let PreloadCache = {};
let PreloadInflight = {};
let originalName;

// 以下状态与 UI 无关（不参与模板绑定），放模块级减少 viewModel 的 observer/数据
// 代理开销；模块级变量跨页面实例共享，需 onInit 重置（onDestroy 已有清缓存模式）。
// downloadChapter 为路由参数，未声明也可经 this.downloadChapter 收到（同 this.source），
// 移出 private 后只是失去响应式，其不参与渲染，安全
let reachedEdge = null; // 滚边翻页戒备状态：记录已到达过的边缘（top/bottom）
let posX = 0; // 上一次滚动位置（标量对，替代原每个滚动事件都重建的 pos 数组）
let posY = 0;
let shownPage = 0; // 当前实际显示图片对应的页码（翻页时回存预加载缓存用）

// 翻多少页才把阅读历史落盘一次
const HISTORY_FLUSH_INTERVAL = 5;

export default {
  private: {
    id: "",
    page_count: 0,
    page: 1,
    time: "",
    scale: 0,
    size: { width: 0, height: 0 },
    showit: true,
    showSlider: false,
    images: "",
    local: false,
    loading: "loading",
    title: "",
    chapter: 1,
    cover: "",
    total_chapters: 0,
    is_serial: false,
    pickerValues: [],
  },

  onShow() {
    this.time = getTime();
  },

  onBackPress() {
    return true;
  },

  onHide() {
    // 退后台时把未落盘的阅读进度写入，防被杀丢进度
    this.flushHistory();
  },

  onDestroy() {
    this.flushHistory();
    ImageCache = [];
    PreloadCache = {};
    PreloadInflight = {};
    // 整章图片缓存刚释放，主动收一次 GC（官方内存优化建议，勿高频调用）
    if (typeof global !== "undefined" && global.runGC) global.runGC();
  },

  onInit() {
    // 模块级状态跨页面实例共享，进页重置
    reachedEdge = null;
    posX = 0;
    posY = 0;
    shownPage = 0;

    // 如果有传入的 source 参数，切换到对应的漫画源
    if (this.source) {
      global.API_SETTING.using = this.source;
    }

    // 读取历史记录，恢复上次阅读位置（本地和在线漫画都支持）
    const comicId = this.getComicId();
    const restorePosition = (historyList) => {
      const historyItem = historyList.find((item) => item.id === comicId);
      if (historyItem) {
        // 恢复上次阅读的章节和页码
        this.chapter = historyItem.chapter || 1;
        this.page = historyItem.page || 1;
        console.debug(`恢复阅读位置: 章节 ${this.chapter}, 页码 ${this.page}`);
      }
    };
    readHistory().then(
      (historyList) => {
        restorePosition(historyList);
        this.initData();
      },
      () => {
        // 没有历史记录，正常初始化
        this.initData();
      }
    );
  },

  initData() {
    if (!this.local) {
      originalName = this.title;
      this.is_serial = this.total_chapters > 1;
      if (this.is_serial) {
        this.generatePickerRanges(this.total_chapters);
      }
    } else if (this.is_serial) {
      this.downloadChapter = parseParam(this.downloadChapter);
      this.total_chapters = this.downloadChapter.length;
      this.generatePickerRanges(this.total_chapters);
    }
    this.processData();
  },

  generatePickerRanges(total) {
    const values = [];
    const totalStr = total.toString();
    const digits = totalStr.length;

    for (let i = 0; i < digits; i++) {
      const digit = parseInt(totalStr[i], 10);
      const maxDigit = i === 0 ? digit : 9;
      const valueRange = [];
      for (let j = 0; j <= maxDigit; j++) {
        valueRange.push(j.toString());
      }
      values.push(valueRange);
    }
    this.pickerValues = values;
  },

  processData() {
    if (this.local) {
      this.getImageForPage();
    } else {
      this.fetchAllImageUrls();
    }
  },

  fetchAllImageUrls() {
    this.loading = "loading";
    this.images = "";
    this.scale = 0;
    const chapter = this.chapter;
    PreloadCache = {};
    PreloadInflight = {};

    apiFetch({
      url: buildPhotoUrl(this.id, Math.floor(this.chapter)),
      responseType: "json",
      success: (response) => {
        if (chapter != this.chapter) {
          return;
        }
        const body = response.data;
        const urls =
          body && Array.isArray(body.images)
            ? body.images.filter((img) => img && img.url).map((img) => img.url)
            : null;
        if (!urls) {
          this.loading = "";
          this.images = "";
          console.debug("handling fail, invalid response data");
          return;
        }
        ImageCache = urls;
        this.title = body.title;
        this.page_count = ImageCache.length;
        this.getImageForPage();
      },
      fail: (data, code) => {
        if (chapter != this.chapter) {
          return;
        }
        this.loading = "";
        this.images = "";
        console.debug(`handling fail, errMsg = ${data}`);
        console.debug(`handling fail, errCode = ${code}`);
      },
    });
  },

  getImageForPage(keepScale) {
    this.loading = "loading";
    // 离开当前页前把已显示的图片放回预加载缓存，回翻时优先使用本地
    if (
      !this.local &&
      shownPage &&
      shownPage !== this.page &&
      this.images &&
      !PreloadCache[shownPage]
    ) {
      PreloadCache[shownPage] = this.images;
    }
    this.images = "";
    if (!keepScale) {
      this.scale = 0;
    }

    // 本地连载：先同步当前章的章节名与总页数，再做"到底"判断。
    // 路由传入的顶层 page_count 对连载不可靠（下载流程登记的是 0 或残留值），
    // 若先判断会用脏值永远早退 end，正确值永远没机会赋值
    // （表现为第 0 页、无法翻页、章节名不显示）
    let localChapterEntry = null;
    if (this.local && this.is_serial) {
      localChapterEntry = this.downloadChapter[this.chapter - 1];
      if (!localChapterEntry) {
        // 章节号越界（历史记录章数 > 本地登记章数）：显示加载失败而非卡死
        this.loading = "";
        return;
      }
      this.title = localChapterEntry[0];
      this.page_count = localChapterEntry[1];
    }

    if (this.page > this.page_count) {
      this.loading = "end";
      return;
    }

    const page = this.page;

    if (this.local) {
      reachedEdge = null;
      posX = posY = 0;
      if (this.is_serial) {
        const chapterNum = localChapterEntry[2];
        const chapterName = localChapterEntry[0];
        const baseUri = `internal://files/${this.id}/${chapterNum}　${chapterName}/${this.page}`;
        this.resolveLocalImage(baseUri);
      } else {
        const baseUri = `internal://files/${this.id}/${this.page}`;
        this.resolveLocalImage(baseUri);
      }
      return;
    }

    let imageUrl = "";

    if (ImageCache.length > 0 && this.page <= ImageCache.length) {
      imageUrl = ImageCache[this.page - 1];
      imageUrl = addImageParams(
        imageUrl,
        parseInt(global.APP_SETTING.imageSize, 10) || 600,
        parseInt(global.APP_SETTING.imageQuality, 10) || 50
      );
    } else {
      return;
    }

    if (PreloadCache[this.page]) {
      const cachedUri = PreloadCache[this.page];
      delete PreloadCache[this.page];
      this.images = cachedUri;
      shownPage = this.page;
      reachedEdge = null;
      posX = posY = 0;
      this.preloadAdjacentPages();
      return;
    }

    if (PreloadInflight[this.page]) {
      return;
    }

    imageUrl = appendLvglSuffix(
      imageUrl,
      `${global.API_SETTING.using}_${this.id}_ch${this.chapter}_p${page}`
    );

    apiFetch({
      url: imageUrl,
      responseType: "file",
      success: (response) => {
        if (page != this.page) {
          return;
        }
        this.images = response.data;
        shownPage = page;
        reachedEdge = null;
        posX = posY = 0;
        this.preloadAdjacentPages();
      },
      fail: () => {
        if (page != this.page) {
          return;
        }
        this.loading = "";
        this.images = "";
        shownPage = 0;
      },
    });
  },

  preloadAdjacentPages() {
    if (this.local || !global.APP_SETTING.imagePreload) {
      return;
    }
    const chapter = this.chapter;
    const preloadPage = (p) => {
      if (p < 1 || p > ImageCache.length || PreloadCache[p] || PreloadInflight[p]) {
        return;
      }
      let url = addImageParams(
        ImageCache[p - 1],
        parseInt(global.APP_SETTING.imageSize, 10) || 600,
        parseInt(global.APP_SETTING.imageQuality, 10) || 50
      );
      url = appendLvglSuffix(url, `${global.API_SETTING.using}_${this.id}_ch${chapter}_p${p}`);
      PreloadInflight[p] = true;
      apiFetch({
        url: url,
        responseType: "file",
        priority: 1,
        success: (response) => {
          delete PreloadInflight[p];
          if (chapter != this.chapter) {
            return;
          }
          if (p == this.page && !this.images) {
            this.images = response.data;
            shownPage = p;
            reachedEdge = null;
            posX = posY = 0;
            return;
          }
          PreloadCache[p] = response.data;
        },
        fail: () => {
          delete PreloadInflight[p];
          if (chapter != this.chapter) {
            return;
          }
          if (p == this.page && !this.images) {
            this.loading = "";
            this.images = "";
            shownPage = 0;
          }
        },
      });
    };
    preloadPage(this.page + 1);
    preloadPage(this.page - 1);
  },

  resolveLocalImage(baseUri) {
    const binUri = baseUri + ".bin";
    const self = this;
    file.access({
      uri: binUri,
      success() {
        self.images = binUri;
      },
      fail() {
        self.images = baseUri;
      },
    });
  },

  routeBack() {
    router.back();
  },

  toChapter(value) {
    switch (value) {
      case "+":
        if (this.chapter < this.total_chapters) {
          this.chapter += 1;
        }
        break;
      case "-":
        if (this.chapter > 1) {
          this.chapter -= 1;
        }
        break;
    }
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.page = 1;
    this.processData();
    this.saveHistory(true);
  },

  toPage(value) {
    switch (value) {
      case "+":
        if (this.page <= this.page_count) {
          this.page += 1;
        }
        break;
      case "-":
        if (this.page > 1) {
          this.page -= 1;
        }
        break;
    }
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.getImageForPage(global.APP_SETTING.keepDefaultZoom);
    this.saveHistory();
  },

  getPhoto(value) {
    this.size.width = screenSize.width;
    this.size.height = (screenSize.width / value.width) * value.height;
  },

  // 获取漫画ID（区分本地和在线）
  getComicId() {
    if (this.local) {
      // 本地漫画使用 local_ 前缀
      return "local_" + this.id;
    } else {
      // 在线漫画使用 online_ 前缀
      return "online_" + global.API_SETTING.using + "_" + this.id;
    }
  },

  // 构造当前阅读进度快照
  buildHistoryData() {
    const comicId = this.getComicId();
    return {
      id: comicId,
      originalId: this.id,
      title: this.is_serial && originalName ? originalName : this.title,
      cover: this.cover,
      chapter: this.chapter,
      page: this.page > this.page_count ? this.page_count : this.page,
      total_chapters: this.total_chapters,
      page_count: this.page_count,
      is_serial: this.is_serial,
      local: this.local,
      source: this.local ? null : global.API_SETTING.using,
      last_read_time: Date.now(),
    };
  },

  // 保存阅读历史：默认只更新内存快照，翻满 HISTORY_FLUSH_INTERVAL 页才真正落盘，
  // 避免每翻一页一次全文件 IO（耗电、闪存磨损）；切章/退页/退后台强制落盘。
  // 极端情况（OOM 被杀等 onDestroy 不执行）最多丢失最近几页进度，可接受
  saveHistory(force) {
    this._historyData = this.buildHistoryData();
    this._historyDirty = true;
    this._pagesSinceFlush = (this._pagesSinceFlush || 0) + 1;
    if (force || this._pagesSinceFlush >= HISTORY_FLUSH_INTERVAL) {
      this.flushHistory();
    }
  },

  // 有脏数据时把内存快照落盘
  flushHistory() {
    if (!this._historyDirty || !this._historyData) {
      return;
    }
    this._historyDirty = false;
    this._pagesSinceFlush = 0;
    const historyData = this._historyData;
    const comicId = historyData.id;

    // 串行队列内读-改-写 + 原子落盘：快速连翻时多次 flush 按序执行，不再丢更新
    updateJsonFile(HISTORY_URI, [], (historyList) => {
      const list = Array.isArray(historyList) ? historyList : [];

      // 查找是否已存在该漫画的记录
      const existingIndex = list.findIndex((item) => item.id === comicId);

      if (existingIndex !== -1) {
        // 更新现有记录并移到最前面
        list.splice(existingIndex, 1);
      }
      list.unshift(historyData);

      // 限制历史记录数量（最多50条）
      return list.slice(0, 50);
    }).then(
      () => {
        console.debug("历史记录保存成功");
      },
      (e) => {
        console.error("保存历史记录失败:", e && e.code);
      }
    );
  },

  showButton() {
    this.showit = !this.showit;
  },

  onPickerChange(pickerIndex, e) {
    const chapterStr = this.chapter.toString().padStart(this.pickerValues.length, "0");
    const newDigits = [...chapterStr];
    newDigits[pickerIndex] = e.newValue;

    let newChapter = parseInt(newDigits.join(""), 10);

    if (newChapter > this.total_chapters) {
      newChapter = this.total_chapters;
    }
    if (newChapter < 1) {
      newChapter = 1;
    }
    this.chapter = newChapter;

    this.updatePickerRanges();

    if (this.local) {
      this.title = this.downloadChapter[this.chapter - 1][0];
    } else {
      this.title = `${this.$t("photo.chapter")} ${this.chapter}`;
    }
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.page = 1;
    this.processData();
    this.saveHistory(true);
  },

  updatePickerRanges() {
    const values = [];
    const totalStr = this.total_chapters.toString();
    const digits = totalStr.length;
    const chapterStr = this.chapter.toString().padStart(digits, "0");

    for (let i = 0; i < digits; i++) {
      const digit = parseInt(totalStr[i], 10);
      const valueRange = [];

      if (i === 0) {
        for (let j = 0; j <= digit; j++) {
          valueRange.push(j.toString());
        }
      } else {
        let maxDigit = 9;
        for (let k = 0; k < i; k++) {
          if (parseInt(chapterStr[k], 10) < parseInt(totalStr[k], 10)) {
            maxDigit = 9;
            break;
          } else if (parseInt(chapterStr[k], 10) > parseInt(totalStr[k], 10)) {
            maxDigit = 0;
            break;
          } else if (k === i - 1) {
            maxDigit = digit;
          }
        }
        for (let j = 0; j <= maxDigit; j++) {
          valueRange.push(j.toString());
        }
      }
      values.push(valueRange);
    }
    this.pickerValues = values;
  },

  onSliderChange(e) {
    this.scale = e.progress;
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    reachedEdge = null;
    posX = posY = 0;
  },

  async onScroll(val) {
    if (!this.images) {
      return;
    }
    const prevX = posX;
    const prevY = posY;
    posX = val.scrollX;
    posY = val.scrollY;
    // 只处理纯纵向滚动（横向/斜向滚动忽略）
    if (prevY === val.scrollY || prevX !== val.scrollX) return;

    this.$element("scrollId").getScrollRect({
      success: ({ width, height }) => {
        // 横向 overscroll 回弹期间不触发翻页
        if (val.scrollX + global.screenSize.width > width) return;
        const atBottom = val.scrollY + global.screenSize.height === height;
        const atTop = val.scrollY === 0;
        if (!atBottom && !atTop) return;
        const edge = atBottom ? "bottom" : "top";
        // 同一边缘连续到达两次才翻页；触发后保持戒备状态（加载成功后才重置），换边则重新计数
        if (reachedEdge === edge) {
          this.toPage(atBottom ? "+" : "-");
        } else {
          reachedEdge = edge;
        }
      },
    });
  },
};
</script>

