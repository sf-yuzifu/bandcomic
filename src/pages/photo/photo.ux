<template>
  <div class="demo-page">
    <progress
      show="{{ showit && page_count > 0 && global.screenShape == 'circle' }}"
      class="progress-arc"
      type="arc"
      percent="{{ Math.min(100, Math.floor((page / page_count) * 100)) }}"
      style="start-angle: 0; total-angle: 360deg; radius: {{ global.screenSize.width / 2 - 2 }}px"
    ></progress>
    <img
      show="{{ showit && global.screenShape == 'circle' }}"
      src="/common/mask.png"
      class="leftButton"
    />
    <img
      show="{{ showit && global.screenShape == 'circle' }}"
      src="/common/mask.png"
      class="rightButton"
    />
    <div
      class="arc-container"
      style="{{
      global.screenShape == 'circle' ? `
      width: ${global.screenSize.width - 12}px;
      height: ${global.screenSize.height - 12}px`
      : 'width: 100%; height: 100%'
      }}"
    >
      <scroll
        id="scrollId"
        class="box"
        scroll-x="true"
        scroll-y="true"
        bounces="true"
        @scroll="onScroll"
      >
        <div @click="showButton" if="{{ images }}" class="padding"></div>
        <div
          if="{{ images }}"
          style="{{ `width:100%; height:${Math.max(0, (global.screenSize.height - size.height * (1 + scale / 100 * 2))/
2 + 2)}px;` }}"
        ></div>
        <image
          if="{{ images }}"
          class="cover"
          src="{{ images }}"
          @complete="getPhoto"
          alt="blank"
          @error="
            () => {
              if (images != '') {
                loading = '';
                images = '';
                showit = true;
              }
            }
          "
          @click="showButton"
          style="{{ `width:${size.width * (1 + scale / 100 * 2)}px;height:${size.height * (1 + scale / 100 * 2)}px;` }}"
        ></image>
        <div
          if="{{ images }}"
          style="{{ `width:100%; height:${Math.max(0, (global.screenSize.height - size.height * (1 + scale / 100 * 2))/
2 + 2)}px;` }}"
        ></div>
        <div @click="showButton" if="{{ images }}" class="padding"></div>
      </scroll>
    </div>

    <!-- 状态图点击仅 error 态响应（纯重试），loading/end 无操作；工具栏切换只在图片态（P1-19） -->
    <div if="{{ !images }}" class="state-wrap" @click="onStateClick">
      <image
        class="state-img"
        src="{{ loading == 'end' ? '/common/end.png' : loading ? '/common/loading.png' : '/common/error.png' }}"
      ></image>
    </div>

    <img
      show="{{ showit }}"
      src="/common/upCover.png"
      style="position: absolute; top: 0px; width: {{ global.screenSize.width }}px;"
    />
    <img
      show="{{ showit }}"
      src="/common/bottomCover.png"
      style="position: absolute; bottom: 0px; width: {{ global.screenSize.width }}px;"
    />

    <div
      class="progress-wrap"
      show="{{ showit && page_count > 0 && global.screenShape != 'circle' }}"
    >
      <progress
        class="progress-bar"
        percent="{{ Math.min(100, Math.floor((page / page_count) * 100)) }}"
      ></progress>
    </div>

    <!-- 方表适配 -->
    <img
      show="{{ showit && global.screenShape != 'circle' }}"
      src="/common/left.png"
      onclick="toPage('-')"
      class="leftButton bottom"
    />
    <img
      show="{{ showit && global.screenShape != 'circle' }}"
      src="/common/right.png"
      onclick="toPage('+')"
      class="rightButton bottom"
    />

    <!-- 圆表适配 -->
    <img
      show="{{ showit && global.screenShape == 'circle' }}"
      src="/common/left_s4.png"
      onclick="toPage('-')"
      class="leftButton"
    />
    <img
      show="{{ showit&& global.screenShape == 'circle' }}"
      src="/common/right_s4.png"
      onclick="toPage('+')"
      class="rightButton"
    />

    <div class="com" if="{{ showSlider }}">
      <div class="shade">
        <scroll class="shade-scroll" scroll-y="true" bounces="true">
          <div if="{{ total_chapters > 1 }}" class="chapter">
            <img src="/common/left.png" onclick="toChapter('-')" class="" />
            <marquee class="subtitle" scrollamount="{{ 20 }}" text-offset="{{ 20 }}">
              {{ title }}
            </marquee>
            <img src="/common/right.png" onclick="toChapter('+')" class="" />
          </div>
          <text class="subtitle" if="{{ total_chapters > 1 }}">
            {{ $t("photo.chapterChange") }}
          </text>
          <div if="{{ total_chapters > 1 }}" style="height: 10px; flex-shrink: 0"></div>
          <div
            if="{{ total_chapters > 1 }}"
            style="flex-direction: row; justify-content: space-around; height: 40px; flex-shrink: 0"
          >
            <picker
              for="pickerValue in pickerValues"
              type="text"
              style="width:{{ 80/pickerValues.length }}%; selected-font-size: 32px;"
              range="{{ pickerValue }}"
              selected="{{ chapter.toString().padStart(pickerValues.length, '0')[$idx] }}"
              onchange="onPickerChange($idx)"
            ></picker>
          </div>
          <div if="{{ total_chapters > 1 }}" style="height: 20px; flex-shrink: 0"></div>
          <text class="subtitle" if="{{ page_count > 0 }}">{{ $t("photo.pageJump") }}</text>
          <div if="{{ page_count > 0 }}" style="height: 10px; flex-shrink: 0"></div>
          <div
            if="{{ page_count > 0 }}"
            style="flex-direction: row; justify-content: space-around; height: 40px; flex-shrink: 0"
          >
            <picker
              for="pickerValue in pagePickerValues"
              type="text"
              style="width:{{ 80/pagePickerValues.length }}%; selected-font-size: 32px;"
              range="{{ pickerValue }}"
              selected="{{ page.toString().padStart(pagePickerValues.length, '0')[$idx] }}"
              onchange="onPagePickerChange($idx)"
            ></picker>
          </div>
          <div if="{{ page_count > 0 }}" style="height: 20px; flex-shrink: 0"></div>
          <text static class="subtitle">{{ $t("photo.photoSizeChange") }}</text>
          <div static style="height: 10px; flex-shrink: 0"></div>
          <slider
            class="slider"
            min="0"
            max="100"
            step="1"
            value="{{ scale }}"
            onchange="onSliderChange"
          ></slider>
          <div static style="height: 10px"></div>
          <text static class="subtitle">{{ $t("photo.brightness") }}</text>
          <div static style="height: 10px; flex-shrink: 0"></div>
          <slider
            class="slider"
            min="0"
            max="100"
            step="1"
            value="{{ brightVal }}"
            onchange="onBrightnessChange"
          ></slider>
          <div static style="height: 10px"></div>
        </scroll>
      </div>
    </div>

    <img
      show="{{ showit && global.screenShape != 'circle' }}"
      src="/common/left.png"
      @click="routeBack"
      class="leftButton top"
    />
    <img
      show="{{ showit && global.screenShape != 'circle' }}"
      src="/common/more.png"
      class="rightButton top"
      @click="toggleSettings"
    />
    <img
      show="{{ showit && global.screenShape == 'circle' }}"
      src="/common/check.png"
      class="bottom"
      @click="toggleSettings"
    />

    <text class="time" show="{{ showit }}">{{ time }}</text>
    <text
      class="title"
      @click="
        () => {
          if (global.screenShape == 'circle') {
            routeBack();
          }
        }
      "
      show="{{ showit }}"
    >
      <span class="iconfont" if.static="{{ global.screenShape == 'circle' }}">&#xe685;</span>
      <span>
        {{ $t("photo.page", { page: page > page_count ? page_count : page }) }}
      </span>
    </text>
  </div>
</template>

<script>
import router from "@system.router";
import file from "@system.file";
import brightness from "@system.brightness";

// 共享模块统一挂 global（见 app.ux），页面不再 import 防 bundle 重复打包
const { addImageParams, appendLvglSuffix } = global.$img;
const { parseParam } = global.$route;
const { readHistory, updateJsonFile, HISTORY_URI } = global.$storage;
const { apiFetch, buildPhotoUrl } = global.$api;

const { screenSize, getTime } = global;

let ImageCache = [];
let PreloadCache = {};
let PreloadInflight = {};
let originalName;
// 在线章节列表是否已成功加载：区分"空章节 → end"与"拉取失败 → 可重拉"，
// 防 page_count 路由残留值把失败误判成读到末尾（P0-8），onInit 需重置
let listReady = false;
// 列表拉取在途标记：翻页触发的自愈重拉去重，防连点灌并发请求（P0-8）
let listFetching = false;

// 以下状态与 UI 无关（不参与模板绑定），放模块级减少 viewModel 的 observer/数据
// 代理开销；模块级变量跨页面实例共享，需 onInit 重置（onDestroy 清缓存；
// 异步回调一律 this.destroyed 守卫后才许写，防旧实例在途响应串台，P0-9）。
// downloadChapter 为路由参数，未声明也可经 this.downloadChapter 收到（同 this.source），
// 移出 private 后只是失去响应式，其不参与渲染，安全
let reachedEdge = null; // 滚边翻页戒备状态：记录已到达过的边缘（top/bottom）
let posX = 0; // 上一次滚动位置（标量对，替代原每个滚动事件都重建的 pos 数组）
let posY = 0;
let shownPage = 0; // 当前实际显示图片对应的页码（翻页时回存预加载缓存用）
// 亮度临时调节：首次拖动时记录的原始 {mode, value}，onDestroy 恢复；
// null 表示本次阅读未动过亮度。App 被杀不恢复为可接受边界
let origBrightness = null;
// slider onchange 拖动中高频连发（每秒几十次），逐次调原生 setMode/setValue
// 会把系统亮度 IPC 打爆卡死 UI；以下三个变量做"模式只切一次 + 设值节流"
let brightManual = false; // 是否已切过手动模式
let brightTimer = 0; // 节流定时器句柄（0=无在途）
let pendingBright = -1; // 待生效的亮度值（0..255）

// 翻多少页才把阅读历史落盘一次
const HISTORY_FLUSH_INTERVAL = 5;

// 圆屏 arc-container 四周内缩 12px（见模板 arc-container 内联 style），滚动视口真实宽高随之 -12。
// 横向触边守卫必须按真实视口宽算（见 onScroll）；触底判定则刻意不减（见 atBottom 注释）
const ARC_VIEWPORT_INSET = 12;

// 生成数字轮盘每一位的可选范围：以 total 的位数为准，结合当前值 current 钳制
// 每一位的最大可选数字，保证拼出来的值不超出 total（章节/页码两个 picker 共用）
function buildDigitRanges(total, current) {
  const values = [];
  const totalStr = Math.max(total, 0).toString();
  const digits = totalStr.length;
  const currentStr = Math.max(current, 0).toString().padStart(digits, "0");

  for (let i = 0; i < digits; i++) {
    const digit = parseInt(totalStr[i], 10);
    let maxDigit;
    if (i === 0) {
      maxDigit = digit;
    } else {
      maxDigit = 9;
      for (let k = 0; k < i; k++) {
        if (parseInt(currentStr[k], 10) < parseInt(totalStr[k], 10)) {
          maxDigit = 9;
          break;
        } else if (parseInt(currentStr[k], 10) > parseInt(totalStr[k], 10)) {
          maxDigit = 0;
          break;
        } else if (k === i - 1) {
          maxDigit = digit;
        }
      }
    }
    const valueRange = [];
    for (let j = 0; j <= maxDigit; j++) {
      valueRange.push(j.toString());
    }
    values.push(valueRange);
  }
  return values;
}

export default {
  private: {
    id: "",
    page_count: 0,
    page: 1,
    time: "",
    scale: 0,
    size: { width: 0, height: 0 },
    showit: true,
    showSlider: false,
    images: "",
    local: false,
    loading: "loading",
    title: "",
    chapter: 1,
    cover: "",
    total_chapters: 0,
    is_serial: false,
    pickerValues: [],
    pagePickerValues: [], // 页码跳转 picker 的逐位可选范围（页码随章变化，需重建）
    // 亮度滑杆初值（0..100，onInit 时同步一次系统当前值）。
    // 命名避开上方 import 的 brightness 模块：模板表达式作用域内同名字段
    // 可能与模块冲突，slider value 绑到模块对象会卡死
    brightVal: 50,
  },

  onShow() {
    this.time = getTime();
  },

  onBackPress() {
    return true;
  },

  onHide() {
    // 退后台时把未落盘的阅读进度写入，防被杀丢进度
    this.flushHistory();
  },

  onDestroy() {
    // 页面销毁后中止异步链：各异步回调检查该标志，旧实例在途响应不再写
    // 模块级缓存/实例字段（download.ux 同款模式，P0-9）
    this.destroyed = true;
    this.flushHistory();
    // 恢复进入阅读页前的亮度（临时调节语义）；只动过亮度（origBrightness 非 null）才恢复
    if (brightTimer) {
      clearTimeout(brightTimer);
      brightTimer = 0;
    }
    if (origBrightness) {
      brightness.setMode({ mode: origBrightness.mode });
      brightness.setValue({ value: origBrightness.value });
      origBrightness = null;
    }
    ImageCache = [];
    PreloadCache = {};
    PreloadInflight = {};
    shownPage = 0;
    // 整章图片缓存刚释放，主动收一次 GC（官方内存优化建议，勿高频调用）
    if (typeof global !== "undefined" && global.runGC) global.runGC();
  },

  onInit() {
    this.destroyed = false;
    // 模块级状态跨页面实例共享，进页重置（图片缓存三件套 + shownPage 一并重置，
    // 配合 destroyed 守卫杜绝上一本漫画的图串台，P0-9）
    reachedEdge = null;
    posX = 0;
    posY = 0;
    ImageCache = [];
    PreloadCache = {};
    PreloadInflight = {};
    shownPage = 0;
    listReady = false;
    listFetching = false;
    origBrightness = null;
    brightManual = false;
    pendingBright = -1;
    if (brightTimer) {
      clearTimeout(brightTimer);
      brightTimer = 0;
    }

    // 如果有传入的 source 参数，切换到对应的漫画源
    if (this.source) {
      global.API_SETTING.using = this.source;
    }

    // 读取历史记录，恢复上次阅读位置（本地和在线漫画都支持）
    const comicId = this.getComicId();
    const restorePosition = (historyList) => {
      const historyItem = historyList.find((item) => item.id === comicId);
      if (historyItem) {
        // 恢复上次阅读的章节和页码
        this.chapter = historyItem.chapter || 1;
        this.page = historyItem.page || 1;
        console.debug(`恢复阅读位置: 章节 ${this.chapter}, 页码 ${this.page}`);
      }
    };
    readHistory().then(
      (historyList) => {
        if (this.destroyed) return;
        restorePosition(historyList);
        this.initData();
      },
      () => {
        if (this.destroyed) return;
        // 没有历史记录，正常初始化
        this.initData();
      }
    );
  },

  initData() {
    if (!this.local) {
      originalName = this.title;
      this.is_serial = this.total_chapters > 1;
      if (this.is_serial) {
        this.pickerValues = buildDigitRanges(this.total_chapters, this.chapter);
      }
    } else if (this.is_serial) {
      this.downloadChapter = parseParam(this.downloadChapter);
      this.total_chapters = this.downloadChapter.length;
      this.pickerValues = buildDigitRanges(this.total_chapters, this.chapter);
    } else {
      // 本地单本：page_count 来自路由参数，直接生成页码轮盘范围
      this.pagePickerValues = buildDigitRanges(this.page_count, this.page);
    }
    this.processData();
  },

  processData() {
    if (this.local) {
      this.getImageForPage();
    } else {
      this.fetchAllImageUrls();
    }
  },

  fetchAllImageUrls() {
    this.loading = "loading";
    this.images = "";
    this.scale = 0;
    const chapter = this.chapter;
    PreloadCache = {};
    PreloadInflight = {};
    listReady = false;
    listFetching = true;

    apiFetch({
      url: buildPhotoUrl(this.id, Math.floor(this.chapter)),
      responseType: "json",
      success: (response) => {
        if (this.destroyed) return;
        if (chapter != this.chapter) {
          return;
        }
        listFetching = false;
        const body = response.data;
        const urls =
          body && Array.isArray(body.images)
            ? body.images.filter((img) => img && img.url).map((img) => img.url)
            : null;
        if (!urls) {
          this.enterErrorState();
          // 清掉 page_count 残留值，防止后续翻页基于脏值越走越远（P0-8）
          this.page_count = 0;
          console.debug("handling fail, invalid response data");
          return;
        }
        ImageCache = urls;
        this.title = body.title;
        this.page_count = ImageCache.length;
        // 必须先置 listReady 再 getImageForPage，否则列表就绪门禁会再次触发重拉
        listReady = true;
        // 页码轮盘范围随章节总页数重建
        this.pagePickerValues = buildDigitRanges(this.page_count, this.page);
        this.getImageForPage();
      },
      fail: (data, code) => {
        if (this.destroyed) return;
        if (chapter != this.chapter) {
          return;
        }
        listFetching = false;
        this.enterErrorState();
        // 同上：失败后 page_count 归零，翻页判断不再依赖路由残留值（P0-8）
        this.page_count = 0;
        console.debug(`handling fail, errMsg = ${data}`);
        console.debug(`handling fail, errCode = ${code}`);
      },
    });
  },

  getImageForPage(keepScale) {
    this.loading = "loading";
    // 离开当前页前把已显示的图片放回预加载缓存，回翻时优先使用本地
    if (
      !this.local &&
      shownPage &&
      shownPage !== this.page &&
      this.images &&
      !PreloadCache[shownPage]
    ) {
      PreloadCache[shownPage] = this.images;
    }
    this.images = "";
    if (!keepScale) {
      this.scale = 0;
    }

    // 本地连载：先同步当前章的章节名与总页数，再做"到底"判断。
    // 路由传入的顶层 page_count 对连载不可靠（下载流程登记的是 0 或残留值），
    // 若先判断会用脏值永远早退 end，正确值永远没机会赋值
    // （表现为第 0 页、无法翻页、章节名不显示）
    let localChapterEntry = null;
    if (this.local && this.is_serial) {
      localChapterEntry = this.downloadChapter[this.chapter - 1];
      if (!localChapterEntry) {
        // 章节号越界（历史记录章数 > 本地登记章数）：显示加载失败而非卡死
        this.enterErrorState();
        return;
      }
      this.title = localChapterEntry[0];
      this.page_count = localChapterEntry[1];
      // 页码轮盘范围随章节总页数重建
      this.pagePickerValues = buildDigitRanges(this.page_count, this.page);
    }

    // 在线列表尚未成功加载：不判 end（page_count 为 0/路由残留不可信）。
    // 在途拉取等其回调落地；否则主动重拉列表自愈——给翻页一个出口，
    // 避免 ImageCache 为空时静默 return 永久卡 loading（P0-8）
    if (!this.local && !listReady) {
      if (!listFetching) {
        this.fetchAllImageUrls();
      }
      return;
    }

    if (this.page > this.page_count) {
      this.loading = "end";
      // 自动弹工具栏兜底：end 图点击无操作（P1-19 交互），滚边翻到章末时
      // 工具栏若处于隐藏态将无出口（系统返回被吞）
      this.showit = true;
      return;
    }

    const page = this.page;

    if (this.local) {
      reachedEdge = null;
      posX = posY = 0;
      if (this.is_serial) {
        const chapterNum = localChapterEntry[2];
        const chapterName = localChapterEntry[0];
        const baseUri = `internal://files/${this.id}/${chapterNum}　${chapterName}/${this.page}`;
        this.resolveLocalImage(baseUri);
      } else {
        const baseUri = `internal://files/${this.id}/${this.page}`;
        this.resolveLocalImage(baseUri);
      }
      return;
    }

    let imageUrl = "";

    if (ImageCache.length > 0 && this.page <= ImageCache.length) {
      imageUrl = ImageCache[this.page - 1];
      imageUrl = addImageParams(
        imageUrl,
        parseInt(global.APP_SETTING.imageSize, 10) || 600,
        parseInt(global.APP_SETTING.imageQuality, 10) || 50
      );
    } else {
      // listReady 门禁下理论不可达；防御性落失败态，任何残余路径都不许卡 loading（P0-8）
      this.enterErrorState();
      return;
    }

    if (PreloadCache[this.page]) {
      const cachedUri = PreloadCache[this.page];
      delete PreloadCache[this.page];
      this.images = cachedUri;
      shownPage = this.page;
      reachedEdge = null;
      posX = posY = 0;
      this.preloadAdjacentPages();
      return;
    }

    if (PreloadInflight[this.page]) {
      return;
    }

    imageUrl = appendLvglSuffix(
      imageUrl,
      `${global.API_SETTING.using}_${this.id}_ch${this.chapter}_p${page}`
    );

    apiFetch({
      url: imageUrl,
      responseType: "file",
      success: (response) => {
        if (this.destroyed) return;
        if (page != this.page) {
          return;
        }
        this.images = response.data;
        shownPage = page;
        reachedEdge = null;
        posX = posY = 0;
        this.preloadAdjacentPages();
      },
      fail: () => {
        if (this.destroyed) return;
        if (page != this.page) {
          return;
        }
        this.enterErrorState();
        shownPage = 0;
      },
    });
  },

  preloadAdjacentPages() {
    if (this.local || !global.APP_SETTING.imagePreload) {
      return;
    }
    const chapter = this.chapter;
    const preloadPage = (p) => {
      if (p < 1 || p > ImageCache.length || PreloadCache[p] || PreloadInflight[p]) {
        return;
      }
      let url = addImageParams(
        ImageCache[p - 1],
        parseInt(global.APP_SETTING.imageSize, 10) || 600,
        parseInt(global.APP_SETTING.imageQuality, 10) || 50
      );
      url = appendLvglSuffix(url, `${global.API_SETTING.using}_${this.id}_ch${chapter}_p${p}`);
      PreloadInflight[p] = true;
      apiFetch({
        url: url,
        responseType: "file",
        priority: 1,
        success: (response) => {
          if (this.destroyed) return;
          if (chapter != this.chapter) {
            // 换章时 PreloadInflight 已在 fetchAllImageUrls 整体重置，
            // 此处再 delete 会误删新章同页的在途标记
            return;
          }
          delete PreloadInflight[p];
          if (p == this.page && !this.images) {
            this.images = response.data;
            shownPage = p;
            reachedEdge = null;
            posX = posY = 0;
            return;
          }
          PreloadCache[p] = response.data;
        },
        fail: () => {
          if (this.destroyed) return;
          if (chapter != this.chapter) {
            return;
          }
          delete PreloadInflight[p];
          if (p == this.page && !this.images) {
            this.enterErrorState();
            shownPage = 0;
          }
        },
      });
    };
    preloadPage(this.page + 1);
    preloadPage(this.page - 1);
  },

  resolveLocalImage(baseUri) {
    const binUri = baseUri + ".bin";
    const self = this;
    // 页码快照：快速连翻时旧页的 file.access 迟到回调不许覆盖新页（P0-10，
    // 与在线路径 page != this.page 守卫对齐）
    const page = this.page;
    file.access({
      uri: binUri,
      success() {
        if (self.destroyed || page != self.page) return;
        self.images = binUri;
      },
      fail() {
        if (self.destroyed || page != self.page) return;
        self.images = baseUri;
      },
    });
  },

  routeBack() {
    router.back();
  },

  toChapter(value) {
    switch (value) {
      case "+":
        if (this.chapter < this.total_chapters) {
          this.chapter += 1;
        }
        break;
      case "-":
        if (this.chapter > 1) {
          this.chapter -= 1;
        }
        break;
    }
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.page = 1;
    this.processData();
    this.saveHistory(true);
  },

  toPage(value) {
    switch (value) {
      case "+":
        if (this.page <= this.page_count) {
          this.page += 1;
        }
        break;
      case "-":
        if (this.page > 1) {
          this.page -= 1;
        }
        break;
    }
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.getImageForPage(global.APP_SETTING.keepDefaultZoom);
    this.saveHistory();
  },

  getPhoto(value) {
    this.size.width = screenSize.width;
    this.size.height = (screenSize.width / value.width) * value.height;
  },

  // 获取漫画ID（区分本地和在线）
  getComicId() {
    if (this.local) {
      // 本地漫画使用 local_ 前缀
      return "local_" + this.id;
    } else {
      // 在线漫画使用 online_ 前缀
      return "online_" + global.API_SETTING.using + "_" + this.id;
    }
  },

  // 构造当前阅读进度快照
  buildHistoryData() {
    const comicId = this.getComicId();
    return {
      id: comicId,
      originalId: this.id,
      title: this.is_serial && originalName ? originalName : this.title,
      cover: this.cover,
      chapter: this.chapter,
      page: this.page > this.page_count ? this.page_count : this.page,
      total_chapters: this.total_chapters,
      page_count: this.page_count,
      is_serial: this.is_serial,
      local: this.local,
      source: this.local ? null : global.API_SETTING.using,
      last_read_time: Date.now(),
    };
  },

  // 保存阅读历史：默认只更新内存快照，翻满 HISTORY_FLUSH_INTERVAL 页才真正落盘，
  // 避免每翻一页一次全文件 IO（耗电、闪存磨损）；切章/退页/退后台强制落盘。
  // 极端情况（OOM 被杀等 onDestroy 不执行）最多丢失最近几页进度，可接受
  saveHistory(force) {
    this._historyData = this.buildHistoryData();
    this._historyDirty = true;
    this._pagesSinceFlush = (this._pagesSinceFlush || 0) + 1;
    if (force || this._pagesSinceFlush >= HISTORY_FLUSH_INTERVAL) {
      this.flushHistory();
    }
  },

  // 有脏数据时把内存快照落盘
  flushHistory() {
    if (!this._historyDirty || !this._historyData) {
      return;
    }
    this._historyDirty = false;
    this._pagesSinceFlush = 0;
    const historyData = this._historyData;
    const comicId = historyData.id;

    // 串行队列内读-改-写 + 原子落盘：快速连翻时多次 flush 按序执行，不再丢更新
    updateJsonFile(HISTORY_URI, [], (historyList) => {
      const list = Array.isArray(historyList) ? historyList : [];

      // 查找是否已存在该漫画的记录
      const existingIndex = list.findIndex((item) => item.id === comicId);

      if (existingIndex !== -1) {
        // 更新现有记录并移到最前面
        list.splice(existingIndex, 1);
      }
      list.unshift(historyData);

      // 限制历史记录数量（最多50条）
      return list.slice(0, 50);
    }).then(
      () => {
        console.debug("历史记录保存成功");
      },
      (e) => {
        console.error("保存历史记录失败:", e && e.code);
      }
    );
  },

  showButton() {
    this.showit = !this.showit;
  },

  // 落失败态（error 图）并自动弹工具栏兜底：error 图点击只做纯重试、不切工具栏（P1-19），
  // 无此兜底则工具栏不可达（系统返回被吞）会困住用户
  enterErrorState() {
    this.loading = "";
    this.images = "";
    this.showit = true;
  },

  // 状态图点击：仅 error 态响应（纯重试）；loading/end 无操作。
  // 工具栏切换只走图片加载成功后的默认点击（showButton），用户定案交互（P1-19）
  onStateClick() {
    if (this.loading) return;
    if (this.local || listReady) {
      this.getImageForPage(global.APP_SETTING.keepDefaultZoom);
    } else {
      this.fetchAllImageUrls();
    }
  },

  onPickerChange(pickerIndex, e) {
    const chapterStr = this.chapter.toString().padStart(this.pickerValues.length, "0");
    const newDigits = [...chapterStr];
    newDigits[pickerIndex] = e.newValue;

    let newChapter = parseInt(newDigits.join(""), 10);

    if (newChapter > this.total_chapters) {
      newChapter = this.total_chapters;
    }
    if (newChapter < 1) {
      newChapter = 1;
    }
    this.chapter = newChapter;

    this.pickerValues = buildDigitRanges(this.total_chapters, this.chapter);

    if (this.local) {
      this.title = this.downloadChapter[this.chapter - 1][0];
    } else {
      this.title = `${this.$t("photo.chapter")} ${this.chapter}`;
    }
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.page = 1;
    this.processData();
    this.saveHistory(true);
  },

  // 打开设置面板时按当前章/页刷新两个数字轮盘的可选范围，
  // 消除 ±1 翻章/翻页后轮盘范围停留在旧值的滞后
  toggleSettings() {
    this.showSlider = !this.showSlider;
    if (this.showSlider) {
      this.pickerValues = buildDigitRanges(this.total_chapters, this.chapter);
      if (this.page_count > 0) {
        this.pagePickerValues = buildDigitRanges(this.page_count, this.page);
      }
      // getValue 返回当前实际生效亮度（自动模式下同样是当前值，0..255），
      // 每次打开弹层刷新一次滑杆位置，跟住系统自动亮度的变化
      const self = this;
      brightness.getValue({
        success: (data) => {
          if (self.destroyed) return;
          if (self.showSlider) {
            self.brightVal = Math.round(((data.value || 0) / 255) * 100);
          }
        },
      });
    }
  },

  // 亮度临时调节：首次拖动异步记下原始 {mode, value}；退出阅读页时 onDestroy 恢复。
  // 拖动事件高频连发：setMode(0) 只切一次，setValue 经 100ms 节流只生效最新值；
  // 不回写 this.brightVal（slider 已自显示），防数据回写再次触发 onchange
  onBrightnessChange(e) {
    pendingBright = Math.round((e.progress / 100) * 255);
    if (!origBrightness) {
      origBrightness = { mode: 0, value: 128 }; // 占位默认值 + 防回调返回前重复捕获
      brightness.getMode({
        success: (data) => {
          // destroyed 后 origBrightness 已被置空，直接写会解引用崩溃（P0-9）
          if (this.destroyed || !origBrightness) return;
          origBrightness.mode = data.mode || 0;
        },
      });
      brightness.getValue({
        success: (data) => {
          if (this.destroyed || !origBrightness) return;
          origBrightness.value = data.value || 0;
        },
      });
    }
    if (brightTimer) {
      return;
    }
    brightTimer = setTimeout(() => {
      brightTimer = 0;
      if (pendingBright < 0) {
        return;
      }
      const value = pendingBright;
      pendingBright = -1;
      if (!brightManual) {
        brightManual = true;
        brightness.setMode({ mode: 0 });
      }
      brightness.setValue({ value });
    }, 100);
  },

  // 页码跳转：数字轮盘逐位拼页码，钳制在 1..page_count 后按 toPage 同款收尾跳页
  onPagePickerChange(pickerIndex, e) {
    const pageStr = this.page.toString().padStart(this.pagePickerValues.length, "0");
    const newDigits = [...pageStr];
    newDigits[pickerIndex] = e.newValue;

    let newPage = parseInt(newDigits.join(""), 10);

    if (newPage > this.page_count) {
      newPage = this.page_count;
    }
    if (newPage < 1) {
      newPage = 1;
    }
    this.page = newPage;

    this.pagePickerValues = buildDigitRanges(this.page_count, this.page);

    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    this.getImageForPage(global.APP_SETTING.keepDefaultZoom);
    this.saveHistory();
  },

  onSliderChange(e) {
    this.scale = e.progress;
    this.$element("scrollId").scrollTo({
      top: 1,
      left: 0,
    });
    reachedEdge = null;
    posX = posY = 0;
  },

  async onScroll(val) {
    if (!this.images) {
      return;
    }
    const prevX = posX;
    const prevY = posY;
    posX = val.scrollX;
    posY = val.scrollY;
    // 只处理纯纵向滚动（横向/斜向滚动忽略）
    if (prevY === val.scrollY || prevX !== val.scrollX) return;

    this.$element("scrollId").getScrollRect({
      success: ({ width, height }) => {
        if (this.destroyed) return;
        // 横向 overscroll 回弹期间不触发翻页。阈值必须用真实视口宽（圆屏为整屏宽 - 12）：
        // 用整屏宽比较会把阈值左移 12px，圆屏内容宽 ≤ 视口宽时 `scrollX + 整屏宽 > 内容宽`
        // 恒成立，onScroll 事件全被丢弃、滚边翻页全灭（2026-09-27 实机，P0-16）
        const viewportW =
          global.screenShape === "circle"
            ? global.screenSize.width - ARC_VIEWPORT_INSET
            : global.screenSize.width;
        if (val.scrollX + viewportW > width) return;
        // 触底判定刻意用整屏高（圆屏比真实视口高 12px，即真实底部前 12px 命中）：
        // 该点会被 bounces 过冲-回弹往复穿过两次，恰好满足下方"到达边缘两次才翻页"；
        // 改判真实底部严格相等后过冲回弹常跳过精确值，双次命中凑不齐，滚边翻页失效
        // （2026-09-27 实机回归，P2-34 回退，勿再"修正"触底判定的 12px 提前量）。
        // scrollY === 0 同理勿动
        const atBottom = val.scrollY + global.screenSize.height - ARC_VIEWPORT_INSET === height;
        const atTop = val.scrollY === 0;
        if (!atBottom && !atTop) return;
        const edge = atBottom ? "bottom" : "top";
        // 同一边缘连续到达两次才翻页；触发后保持戒备状态（加载成功后才重置），换边则重新计数
        if (reachedEdge === edge) {
          this.toPage(atBottom ? "+" : "-");
        } else {
          reachedEdge = edge;
        }
      },
    });
  },
};
</script>

<style>
@import "../../common/base.css";

.demo-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  height: 100%;
}

.box {
  width: 100%;
  height: 100%;
  flex-direction: column;
}

/* 加载/失败/结尾 状态占位：独立固定大小，全屏居中，不参与正文图布局 */
.state-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-img {
  width: 256px;
  height: 256px;
}

text {
  font-size: 20px;
}

.com {
  position: absolute;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 84px 6px;
}

.title {
  position: absolute;
  top: 32px;
}

.time {
  position: absolute;
  top: 10px;
}

.slider {
  width: 100%;
}

.shade {
  background-color: rgba(38, 38, 38, 0.6);
  border-radius: 36px;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 20px 10px;
  border: 3px rgba(255, 255, 255, 0.24);
}

/* 弹层内容滚动：shade 定高 → scroll height:100% 亦为定高，内容超高即可滚动；
   各行已统一 flex-shrink:0，内容超高时溢出走滚动而非被压缩 */
.shade-scroll {
  width: 100%;
  flex-direction: column;
  align-items: center;
}

/* 阅读进度：方屏底部横条（左右让出屏幕圆角弧度，band 48px / watch 104px 见媒体查询），
   圆屏为整圆环；均随 showit 显示，纯展示不可交互 */
.progress-wrap {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 0 48px;
}

/* horizontal 类型的进度条 height 属性无效，粗细用 stroke-width */
.progress-bar {
  width: 100%;
  stroke-width: 6px;
  color: #4fc3f7;
  layer-color: rgba(255, 255, 255, 0.15);
}

/* 圆屏整圆环：全屏绝对定位、渲染在最底层（文档序最前），圆心默认取组件中心，
   半径内缩半个笔宽贴屏幕边缘；圆屏图片左右各让 8px（见 getPhoto）露出此环 */
.progress-arc {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  stroke-width: 4px;
  color: #4fc3f7;
  layer-color: rgba(255, 255, 255, 0.15);
}

.arc-container {
  position: absolute;
  flex-direction: column;
}

.chapter {
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 20px;
  flex-shrink: 0;
}

/* 弹层内各行一律 flex-shrink: 0：固定高度的间隔/picker 行在内容超高时
   会被 flex 默认 shrink 压扁（空 div 内容高度为 0，能压没），禁压缩后
   超出部分才真正交给 scroll 滚动 */
.subtitle {
  display: flex;
  justify-items: center;
  align-items: center;
  font-size: 24px;
  width: 75%;
  text-align: center;
  font-weight: bold;
  color: rgba(255, 255, 255, 1);
}

/* 看看是不是小米手表 */
@media (device-type: watch) and (shape: circle) {
  .padding {
    height: 50%;
  }

  /* 圆屏：图片水平居中，与 getPhoto 的宽度内缩配合形成左右对称走廊 */
  .box {
    align-items: center;
  }

  /* 圆屏：容器动态取设备宽/高 - 8（模板内联 style 绑定 global.screenSize，
     CSS 算不了算术），left/top 各 4px 保持居中；border-radius + overflow 裁圆 */
  .arc-container {
    border-radius: 2500px;
    overflow: hidden;
  }

  .leftButton {
    left: 6px;
  }

  .rightButton {
    right: 6px;
  }

  .bottom {
    position: absolute;
    bottom: 6px;
  }

  .com {
    padding: 0;
  }

  .shade {
    width: 67%;
    max-height: 67%;
  }
}

/* 看看是不是小米手表 */
@media (min-width: 200) and (max-width: 235) and (shape: circle) {
  .leftButton {
    top: 182px;
  }

  .rightButton {
    top: 182px;
  }

  .bottom {
    left: 182px;
  }
}

/* 看看是不是小米手表s1 pro */
@media (min-width: 235) and (max-width: 250) and (shape: circle) {
  .leftButton {
    top: 189px;
  }

  .rightButton {
    top: 189px;
  }

  .bottom {
    left: 189px;
  }
}

/* 看看是不是红米手表 */
@media (device-type: watch) and (shape: rect) {
  .padding {
    height: 10%;
  }

  /* 方屏手表弹层：四周留 96px */
  .com {
    padding: 94px 20px;
  }

  /* 方屏手表进度条：左右让出 104px 圆角 */
  .progress-wrap {
    padding: 0 104px;
  }
}
</style>
